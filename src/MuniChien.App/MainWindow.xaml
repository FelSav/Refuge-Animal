<Window x:Class="MuniChien.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MuniChien"
        Width="1200"
        Height="720"
        MinWidth="1000"
        MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <!-- ==================================================
             STRUCTURE PRINCIPALE
             ================================================== -->

        <Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <ColumnDefinition Width="240"/>

            <!-- Contenu -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="70"/>

            <!-- Page -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>


        <!-- ==================================================
             SIDEBAR
             ================================================== -->

        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{StaticResource SidebarBackgroundBrush}">

            <Grid>

                <Grid.RowDefinitions>

                    <!-- Logo -->
                    <RowDefinition Height="105"/>

                    <!-- Navigation -->
                    <RowDefinition Height="*"/>

                    <!-- Administration -->
                    <RowDefinition Height="85"/>

                </Grid.RowDefinitions>


                <!-- ==================================================
                     LOGO
                     ================================================== -->

                <TextBlock Grid.Row="0"
                           Text="MuniChien"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Margin="22,0,0,0"
                           VerticalAlignment="Center"/>


                <!-- ==================================================
                     NAVIGATION
                     ================================================== -->

                <StackPanel Grid.Row="1">


                    <!-- Accueil -->

                    <RadioButton Content="Accueil"
                                 GroupName="MainNavigation"
                                 Command="{Binding ShowHomeCommand}"
                                 IsChecked="{Binding IsHomeSelected,
                                                    Mode=OneWay}"
                                 Style="{StaticResource SidebarNavigationItemStyle}"/>


                    <!-- Recherche -->

                    <RadioButton Content="Recherche"
                                 GroupName="MainNavigation"
                                 Command="{Binding ShowSearchCommand}"
                                 IsChecked="{Binding IsSearchSelected,
                                                    Mode=OneWay}"
                                 Style="{StaticResource SidebarNavigationItemStyle}"/>


                    <!-- Propriétaires -->

                    <RadioButton Content="Propriétaires"
                                 GroupName="MainNavigation"
                                 Command="{Binding ShowOwnersCommand}"
                                 IsChecked="{Binding IsOwnersSelected,
                                                    Mode=OneWay}"
                                 Style="{StaticResource SidebarNavigationItemStyle}"/>


                    <!-- Chiens -->

                    <RadioButton Content="Chiens"
                                 GroupName="MainNavigation"
                                 Command="{Binding ShowDogsCommand}"
                                 IsChecked="{Binding IsDogsSelected,
                                                    Mode=OneWay}"
                                 Style="{StaticResource SidebarNavigationItemStyle}"/>


                    <!-- Licences -->

                    <RadioButton Content="Licences"
                                 GroupName="MainNavigation"
                                 Command="{Binding ShowLicensesCommand}"
                                 IsChecked="{Binding IsLicensesSelected,
                                                    Mode=OneWay}"
                                 Style="{StaticResource SidebarNavigationItemStyle}"/>


                    <!-- Paiements -->

                    <RadioButton Content="Paiements"
                                 GroupName="MainNavigation"
                                 Command="{Binding ShowPaymentsCommand}"
                                 IsChecked="{Binding IsPaymentsSelected,
                                                    Mode=OneWay}"
                                 Style="{StaticResource SidebarNavigationItemStyle}"/>


                    <!-- Rapports -->

                    <RadioButton Content="Rapports"
                                 GroupName="MainNavigation"
                                 Command="{Binding ShowReportsCommand}"
                                 IsChecked="{Binding IsReportsSelected,
                                                    Mode=OneWay}"
                                 Style="{StaticResource SidebarNavigationItemStyle}"/>

                </StackPanel>


                <!-- ==================================================
                     ADMINISTRATION
                     ================================================== -->

                <Border Grid.Row="2"
                        BorderBrush="#5A5A5A"
                        BorderThickness="0,1,0,0">

                    <RadioButton Content="Administration"
                                 GroupName="MainNavigation"
                                 Command="{Binding ShowAdministrationCommand}"
                                 IsChecked="{Binding IsAdministrationSelected,
                                                    Mode=OneWay}"
                                 Style="{StaticResource SidebarNavigationItemStyle}"
                                 VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </Border>


        <!-- ==================================================
             HEADER
             ================================================== -->

        <Border Grid.Column="1"
                Grid.Row="0"
                Background="White"
                BorderBrush="#E4E7EC"
                BorderThickness="0,0,0,1">

            <Grid Margin="26,0">


                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="Auto"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- Titre page -->

                <TextBlock Grid.Column="0"
                           Text="{Binding PageTitle}"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#242424"
                           VerticalAlignment="Center"/>


                <!-- Municipalité -->

                <TextBlock Grid.Column="1"
                           Text="Municipalité : Roberval"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#344054"
                           Margin="18,2,0,0"
                           VerticalAlignment="Center"/>


                <!-- Connexion admin -->

                <Button Grid.Column="3"
                        Content="Connexion admin"
                        Style="{StaticResource AdminLoginButtonStyle}"
                        VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- ==================================================
             CONTENU DE LA PAGE
             ================================================== -->

        <ContentControl Grid.Column="1"
                        Grid.Row="1"
                        Content="{Binding CurrentViewModel}"/>

    </Grid>

</Window>