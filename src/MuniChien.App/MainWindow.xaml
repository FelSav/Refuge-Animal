<Window x:Class="MuniChien.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MuniChien.App"
        mc:Ignorable="d"
        Title="MuniChien"
        Height="720"
        Width="1200"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}">

            <StackPanel>

                <TextBlock Text="MuniChien"
               Foreground="White"
               FontSize="26"
               FontWeight="SemiBold"
               Margin="24,24,24,32"/>

                <RadioButton Content="Accueil"
             GroupName="MainNavigation"
             IsChecked="True"
             Style="{StaticResource SidebarNavigationItemStyle}"/>

                <RadioButton Content="Recherche"
             GroupName="MainNavigation"
             Style="{StaticResource SidebarNavigationItemStyle}"/>

                <RadioButton Content="Licences"
             GroupName="MainNavigation"
             Style="{StaticResource SidebarNavigationItemStyle}"/>

                <RadioButton Content="Paiements"
             GroupName="MainNavigation"
             Style="{StaticResource SidebarNavigationItemStyle}"/>

                <RadioButton Content="Rapports"
             GroupName="MainNavigation"
             Style="{StaticResource SidebarNavigationItemStyle}"/>

                <RadioButton Content="Administration"
             GroupName="MainNavigation"
             Style="{StaticResource SidebarNavigationItemStyle}"/>

            </StackPanel>

        </Border>

        <!-- Contenu principal -->
        <Grid Grid.Column="1"
              Background="#F5F5F5">

            <TextBlock Text="Accueil"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Foreground="#242424"
                       Margin="40"/>

        </Grid>

    </Grid>

</Window>