<Window x:Class="MuniChien.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:MuniChien.App.Views"
        xmlns:local="clr-namespace:MuniChien.App"
        mc:Ignorable="d"
        Title="MuniChien"
        Height="720"
        Width="1200"
        MinHeight="600"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu latéral -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackgroundBrush}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- Logo / nom de l'application -->
                <TextBlock Grid.Row="0"
               Text="MuniChien"
               Foreground="White"
               FontSize="26"
               FontWeight="SemiBold"
               Margin="24,24,24,32"/>


                <!-- Navigation principale -->
                <StackPanel Grid.Row="1">

                    <RadioButton Content="Accueil"
                     GroupName="MainNavigation"
                     IsChecked="True"
                     Command="{Binding ShowHomeCommand}"
                     Style="{StaticResource SidebarNavigationItemStyle}"/>

                    <RadioButton Content="Recherche"
                     GroupName="MainNavigation"
                     Command="{Binding ShowSearchCommand}"
                     Style="{StaticResource SidebarNavigationItemStyle}"/>

                    <RadioButton Content="Propriétaires"
                     GroupName="MainNavigation"
                     Command="{Binding ShowOwnersCommand}"
                     Style="{StaticResource SidebarNavigationItemStyle}"/>

                    <RadioButton Content="Chiens"
                     GroupName="MainNavigation"
                     Command="{Binding ShowDogsCommand}"
                     Style="{StaticResource SidebarNavigationItemStyle}"/>

                    <RadioButton Content="Licences"
                     GroupName="MainNavigation"
                     Command="{Binding ShowLicensesCommand}"
                     Style="{StaticResource SidebarNavigationItemStyle}"/>

                    <RadioButton Content="Paiements"
                     GroupName="MainNavigation"
                     Command="{Binding ShowPaymentsCommand}"
                     Style="{StaticResource SidebarNavigationItemStyle}"/>

                    <RadioButton Content="Rapports"
                     GroupName="MainNavigation"
                     Command="{Binding ShowReportsCommand}"
                     Style="{StaticResource SidebarNavigationItemStyle}"/>

                </StackPanel>


                <!-- Espace extensible -->
                <Grid Grid.Row="2"/>


                <!-- Administration -->
                <RadioButton Grid.Row="3"
                 Content="Administration"
                 GroupName="MainNavigation"
                 Command="{Binding ShowAdministrationCommand}"
                 Style="{StaticResource SidebarNavigationItemStyle}"
                 Margin="12,4,12,20"/>

            </Grid>

        </Border>

        <!-- Contenu principal -->
        <!-- Contenu principal -->
        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- En-tête global -->
            <Border Grid.Row="0"
            Background="White"
            BorderBrush="#E3E3E3"
            BorderThickness="0,0,0,1"
            Padding="24,12">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                       Text="{Binding PageTitle}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="#242424"
                       VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                       Text="Municipalité : Roberval"
                       Margin="14,0,0,0"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#444444"
                       VerticalAlignment="Center"/>

                    <Button Grid.Column="3"
        Content="Connexion admin"
        Style="{StaticResource AdminLoginButtonStyle}"/>

                </Grid>

            </Border>

            <!-- Page actuelle -->
            <ContentControl Grid.Row="1"
                    Content="{Binding CurrentViewModel}"/>

        </Grid>

    </Grid>

</Window>