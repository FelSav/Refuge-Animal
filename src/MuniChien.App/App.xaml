<Application x:Class="MuniChien.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MuniChien.App"
             xmlns:views="clr-namespace:MuniChien.App.Views"
xmlns:viewModels="clr-namespace:MuniChien.App.ViewModels"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewModels:HomeViewModel}">
                <views:HomeView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:SearchViewModel}">
                <views:SearchView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:LicensesViewModel}">
                <views:LicensesView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:PaymentsViewModel}">
                <views:PaymentsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ReportsViewModel}">
                <views:ReportsView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:AdministrationViewModel}">
                <views:AdministrationView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:OwnersViewModel}">
                <views:OwnersView/>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:DogsViewModel}">
                <views:DogsView/>
            </DataTemplate>

        </ResourceDictionary>

    </Application.Resources>
</Application>
