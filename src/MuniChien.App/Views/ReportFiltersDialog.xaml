<Window x:Class="MuniChien.App.Views.ReportFiltersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filtres du rapport" Width="780" Height="730"
        MinWidth="620" MinHeight="510" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F6F7F9">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#465267"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D6DDE6"/>
        </Style>
        <Style x:Key="FilterText" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderBrush" Value="#D6DDE6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FilterSection" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E7EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#E1E6ED" BorderThickness="0,0,0,1" Padding="28,22">
            <StackPanel>
                <TextBlock Text="Préparer mon rapport" FontSize="23" FontWeight="SemiBold" Foreground="#202B3C"/>
                <TextBlock Text="{Binding ReportTitle}" FontSize="15" FontWeight="SemiBold" Foreground="#CF641B" Margin="0,6,0,0"/>
                <TextBlock Text="Sélectionnez vos filtres, puis choisissez l'ordre des résultats. Laissez « Tous » pour le rapport complet."
                           Foreground="#65738A" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,20,28,12">
                <Border Style="{StaticResource FilterSection}">
                    <StackPanel>
                        <TextBlock Text="1. Choisir les dossiers" FontSize="16" FontWeight="SemiBold" Foreground="#263247" Margin="0,0,0,14"/>
                        <TextBlock Text="Recherche (facultative)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource FilterText}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nom, téléphone, numéro de dossier, chien ou reçu selon le rapport"/>
                        <TextBlock Text="Nom, numéro de dossier, téléphone ou référence selon le rapport."
                                   Foreground="#758198" FontSize="11" Margin="0,5,0,13"/>
                        <TextBlock Text="Municipalité" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding MunicipalityOptions}"
                                  SelectedItem="{Binding SelectedMunicipality, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FilterSection}" Visibility="{Binding ShowAnimalFilters, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <TextBlock Text="2. Caractéristiques et licences" FontSize="16" FontWeight="SemiBold" Foreground="#263247" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Race" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding BreedOptions}" SelectedItem="{Binding SelectedBreed, Mode=TwoWay}"/>
                            </StackPanel>
                            <!-- Clients : le statut partage la premiere rangee avec la race. -->
                            <StackPanel Grid.Column="2" Visibility="{Binding ShowClientExplanation, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="Statut de licence" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                            </StackPanel>
                            <!-- Chiens, races et licences : sexe a droite de la race. -->
                            <StackPanel Grid.Column="2" Visibility="{Binding ShowAnimalDetails, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="Sexe" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding SexOptions}" SelectedItem="{Binding SelectedSex, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <!-- Cette deuxieme rangee n'existe pas pour le rapport Clients. -->
                        <Grid Margin="0,14,0,0" Visibility="{Binding ShowAnimalDetails, Converter={StaticResource BoolVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stérilisation" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding SterilizationOptions}" SelectedItem="{Binding SelectedSterilization, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Statut de licence" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Pour les listes de clients, ces critères sélectionnent les clients ayant au moins un chien correspondant."
                                   Visibility="{Binding ShowClientExplanation, Converter={StaticResource BoolVisibility}}"
                                   FontSize="11" Foreground="#758198" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FilterSection}" Visibility="{Binding ShowDateFilters, Converter={StaticResource BoolVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding DateSectionTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#263247" Margin="0,0,0,14"/>
                        <StackPanel Visibility="{Binding ShowPeriod, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="Période" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod, Mode=TwoWay}"/>
                            <TextBlock Text="Pour les licences, il s'agit de la date d'émission."
                                       Visibility="{Binding ShowLicensePeriodHint, Converter={StaticResource BoolVisibility}}"
                                       Foreground="#758198" FontSize="11" Margin="0,5,0,12"/>
                        </StackPanel>
                        <StackPanel Visibility="{Binding ShowDay, Converter={StaticResource BoolVisibility}}">
                            <TextBlock Text="Journée" Style="{StaticResource FieldLabel}"/>
                            <DatePicker SelectedDate="{Binding SelectedDay, Mode=TwoWay}" Height="38"/>
                        </StackPanel>
                        <Grid Margin="0,12,0,0" Visibility="{Binding ShowMoneyFilters, Converter={StaticResource BoolVisibility}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Visibility="{Binding ShowPaymentMethod, Converter={StaticResource BoolVisibility}}">
                                <TextBlock Text="Mode de paiement" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding PaymentMethodOptions}" SelectedItem="{Binding SelectedMethod, Mode=TwoWay}"/>
                            </StackPanel>
                            <!-- Sans mode de paiement (soldes et frais), le montant commence a gauche. -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Grid.Column" Value="2"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowPaymentMethod}" Value="False">
                                                <Setter Property="Grid.Column" Value="0"/>
                                                <Setter Property="Grid.ColumnSpan" Value="3"/>
                                                <Setter Property="Width" Value="400"/>
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding MinimumLabel}" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource FilterText}" Text="{Binding MinimumText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Ex. 25,50"/>
                                <TextBlock Text="Laisser vide pour ne pas limiter." Foreground="#758198" FontSize="11" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FilterSection}">
                    <StackPanel>
                        <TextBlock Text="3. Ordre des résultats" FontSize="16" FontWeight="SemiBold" Foreground="#263247" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Trier par" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Sens" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Style="{StaticResource FilterCombo}" ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirection, Mode=TwoWay}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E1E6ED" BorderThickness="0,1,0,0" Padding="28,15">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Les filtres seront aussi appliqués au total du rapport." Foreground="#667085" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                <Button Grid.Column="1" Content="Annuler" Click="Cancel_Click" Padding="20,10" Background="White" BorderBrush="#D3DAE5"/>
                <Button Grid.Column="3" Content="Générer le rapport" Click="Generate_Click" Padding="22,10" Foreground="White" Background="#EA7621" BorderBrush="#CB5A15" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
