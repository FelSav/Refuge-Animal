<Window x:Class="MuniChien.App.Views.LoyaltyRewardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="13e sac gratuit — MuniChien" Width="560" Height="490"
        MinHeight="450" MinWidth="480" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="CanResize" Background="#F6F7FA">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="White" Padding="25,20" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="13e sac gratuit disponible !" FontSize="23" FontWeight="SemiBold" Foreground="#242B38"/>
                <TextBlock x:Name="ProgramText" Margin="0,5,0,0" FontSize="13" Foreground="#667085"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,22">
                <TextBlock Text="Sac EXACT à remettre" Foreground="#B4540C" FontWeight="Bold" FontSize="14" Margin="0,0,0,9"/>
                <Border Background="White" BorderBrush="#FFD2AD" BorderThickness="1" CornerRadius="12" Padding="18">
                    <StackPanel>
                        <TextBlock x:Name="ProductText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#242B38"/>
                        <TextBlock x:Name="ReferenceText" FontSize="13" Margin="0,9,0,0" Foreground="#475467" TextWrapping="Wrap"/>
                        <TextBlock x:Name="FormatText" FontSize="13" Margin="0,5,0,0" Foreground="#475467"/>
                        <TextBlock x:Name="PositionText" FontSize="13" Margin="0,5,0,0" Foreground="#475467"/>
                        <Separator Margin="0,13" Background="#E4E7EC"/>
                        <TextBlock x:Name="PriceText" FontSize="26" FontWeight="Bold" Foreground="#BF5B12"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Aucun autre sac au même prix ne peut être substitué. Confirmez uniquement après avoir réellement remis ce produit au client."
                           FontSize="13" Foreground="#475467" TextWrapping="Wrap" Margin="0,17,0,0"/>
                <TextBlock Text="Après confirmation, le cycle complet sera archivé et cette même carte recommencera à 0/12."
                           FontSize="12" Foreground="#667085" TextWrapping="Wrap" Margin="0,11,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderThickness="0,1,0,0" BorderBrush="#E4E7EC" Padding="25,15">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Plus tard" MinHeight="43" Padding="20,9" Background="White" Foreground="#344054"
                        BorderBrush="#CDD5DF" BorderThickness="1" Click="Cancel_Click" Margin="0,0,10,0"/>
                <Button Content="Confirmer la remise" MinHeight="43" Padding="21,9" Background="#E87520" Foreground="White"
                        FontWeight="SemiBold" BorderThickness="0" Click="Confirm_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
