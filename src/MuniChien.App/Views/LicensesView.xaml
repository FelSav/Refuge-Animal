<UserControl x:Class="MuniChien.App.Views.LicensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ==================================================
             CARTES DE STATISTIQUES
             ================================================== -->

        <Style x:Key="LicenseStatCardStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="20,16"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <!-- SURVOL -->

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#E87524"/>

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#FFF9F5"/>

                            </Trigger>


                            <!-- FILTRE ACTIF -->

                            <Trigger Property="Tag"
                                     Value="True">

                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#E87524"/>

                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2"/>

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#FFF5ED"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ==================================================
             LABELS DE FILTRE
             ================================================== -->

        <Style x:Key="LicenseFilterLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>


        <!-- ==================================================
             TEXTBOX
             ================================================== -->

        <Style x:Key="LicenseFilterTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#E87524"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ==================================================
             DATAGRID
             ================================================== -->

        <Style x:Key="LicenseDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="CanUserSortColumns"
                    Value="True"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FCFCFD"/>

            <Setter Property="RowHeight"
                    Value="48"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="44"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

        </Style>


        <Style x:Key="LicenseHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="BorderBrush"
                    Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

        </Style>


        <Style x:Key="LicenseRowStyle"
               TargetType="DataGridRow">

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>


            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FFF8F3"/>

                </Trigger>


                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FFF1E6"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="LicenseCellStyle"
               TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <Style x:Key="LicenseCellTextStyle"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="12,0"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <!-- ==================================================
             BADGES DE STATUT
             ================================================== -->

        <Style x:Key="LicenseStatusBadgeStyle"
               TargetType="Border">

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="10,4"/>

            <Setter Property="HorizontalAlignment"
                    Value="Left"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#F2F4F7"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>


            <Style.Triggers>

                <DataTrigger Binding="{Binding Status}"
                             Value="Valide">

                    <Setter Property="Background"
                            Value="#ECFDF3"/>

                    <Setter Property="BorderBrush"
                            Value="#ABEFC6"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Status}"
                             Value="À renouveler">

                    <Setter Property="Background"
                            Value="#FFF4ED"/>

                    <Setter Property="BorderBrush"
                            Value="#F7B27A"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Status}"
                             Value="Expirée">

                    <Setter Property="Background"
                            Value="#FEF3F2"/>

                    <Setter Property="BorderBrush"
                            Value="#FECDCA"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="LicenseStatusTextStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#475467"/>


            <Style.Triggers>

                <DataTrigger Binding="{Binding Status}"
                             Value="Valide">

                    <Setter Property="Foreground"
                            Value="#067647"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Status}"
                             Value="À renouveler">

                    <Setter Property="Foreground"
                            Value="#B54708"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding Status}"
                             Value="Expirée">

                    <Setter Property="Foreground"
                            Value="#B42318"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ==================================================
             BOUTON VOIR
             ================================================== -->

        <Style x:Key="LicenseViewButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryActionButtonStyle}">

            <Setter Property="Padding"
                    Value="10,4"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="MinWidth"
                    Value="52"/>

            <Setter Property="Width"
                    Value="58"/>

            <Setter Property="HorizontalAlignment"
                    Value="Center"/>

        </Style>

    </UserControl.Resources>


    <!-- ==================================================
         PAGE
         ================================================== -->

    <Grid Background="#F6F7F9">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,36,52,42">


                <!-- ==================================================
                     ENTÊTE
                     ================================================== -->

                <TextBlock Text="Licences"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>


                <TextBlock Text="Consultez et gérez les licences de chiens."
                           FontSize="14"
                           Foreground="#667085"
                           Margin="0,7,0,24"/>


                <!-- ==================================================
                     CARTES
                     ================================================== -->

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="18"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="18"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- VALIDES -->

                    <Button Grid.Column="0"
                            Command="{Binding ShowValidCommand}"
                            Tag="{Binding IsValidFilterActive}"
                            Style="{StaticResource LicenseStatCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Licences valides"
                                       HorizontalAlignment="Center"
                                       Foreground="#667085"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding ValidCount}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"
                                       FontSize="27"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>

                        </StackPanel>

                    </Button>


                    <!-- RENOUVELLEMENT -->

                    <Button Grid.Column="2"
                            Command="{Binding ShowRenewalCommand}"
                            Tag="{Binding IsRenewalFilterActive}"
                            Style="{StaticResource LicenseStatCardStyle}">

                        <StackPanel>

                            <TextBlock Text="À renouveler"
                                       HorizontalAlignment="Center"
                                       Foreground="#667085"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding RenewalCount}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"
                                       FontSize="27"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>

                        </StackPanel>

                    </Button>


                    <!-- EXPIRÉES -->

                    <Button Grid.Column="4"
                            Command="{Binding ShowExpiredCommand}"
                            Tag="{Binding IsExpiredFilterActive}"
                            Style="{StaticResource LicenseStatCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Expirées"
                                       HorizontalAlignment="Center"
                                       Foreground="#667085"
                                       FontSize="13"/>

                            <TextBlock Text="{Binding ExpiredCount}"
                                       HorizontalAlignment="Center"
                                       Margin="0,5,0,0"
                                       FontSize="27"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>

                        </StackPanel>

                    </Button>

                </Grid>


                <!-- ==================================================
                     RECHERCHE
                     ================================================== -->

                <Border Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,0,0,26"
                        PreviewKeyDown="SearchPanel_PreviewKeyDown">

                    <StackPanel>

                        <TextBlock Text="Recherche"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#242B38"
                                   Margin="0,0,0,16"/>


                        <!-- LIGNE 1 -->

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="16"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="16"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- LICENCE -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Numéro de licence"
                                           Style="{StaticResource LicenseFilterLabelStyle}"/>

                                <TextBox Text="{Binding LicenseNumberFilter,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Exemple : 10452"
                                         Style="{StaticResource LicenseFilterTextBoxStyle}"/>

                            </StackPanel>


                            <!-- CHIEN -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Nom du chien"
                                           Style="{StaticResource LicenseFilterLabelStyle}"/>

                                <TextBox Text="{Binding DogNameFilter,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Exemple : Lucky"
                                         Style="{StaticResource LicenseFilterTextBoxStyle}"/>

                            </StackPanel>


                            <!-- PROPRIÉTAIRE -->

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Propriétaire"
                                           Style="{StaticResource LicenseFilterLabelStyle}"/>

                                <TextBox Text="{Binding OwnerNameFilter,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Nom ou partie du nom"
                                         Style="{StaticResource LicenseFilterTextBoxStyle}"/>

                            </StackPanel>

                        </Grid>


                        <!-- LIGNE 2 -->

                        <Grid Margin="0,14,0,0">

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="16"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="16"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- MUNICIPALITÉ -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Municipalité"
                                           Style="{StaticResource LicenseFilterLabelStyle}"/>

                                <TextBox Text="{Binding MunicipalityFilter,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Exemple : Roberval"
                                         Style="{StaticResource LicenseFilterTextBoxStyle}"/>

                            </StackPanel>


                            <!-- STATUT -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Statut"
                                           Style="{StaticResource LicenseFilterLabelStyle}"/>

                                <ComboBox ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding StatusFilter}"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          Height="38"/>

                            </StackPanel>


                            <!-- EXPIRATION -->

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Expiration"
                                           Style="{StaticResource LicenseFilterLabelStyle}"/>

                                <TextBox Text="{Binding ExpirationFilter,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="AAAA-MM ou AAAA-MM-JJ"
                                         Style="{StaticResource LicenseFilterTextBoxStyle}"/>

                            </StackPanel>

                        </Grid>


                        <!-- ACTIONS -->

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,16,0,0">

                            <TextBlock Text="Appuyez sur Entrée pour rechercher"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="#98A2B3"
                                       Margin="0,0,18,0"/>


                            <Button Content="Réinitialiser"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    Margin="0,0,12,0"
                                    Padding="18,8"/>


                            <Button Content="Rechercher"
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Padding="20,8"/>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- ==================================================
                     ENTÊTE DU TABLEAU
                     ================================================== -->

                <Grid Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Text="Licences"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="#242B38"/>


                    <TextBlock Grid.Column="1"
                               Text="{Binding ResultCountText}"
                               Margin="14,4,0,0"
                               FontSize="13"
                               Foreground="#667085"/>

                </Grid>


                <!-- ==================================================
                     TABLEAU
                     ================================================== -->

                <Border Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">

                    <Grid>

                        <DataGrid x:Name="LicensesDataGrid"
                                  ItemsSource="{Binding Licenses}"
                                  SelectedItem="{Binding SelectedLicense,
                                                        Mode=TwoWay}"
                                  MouseDoubleClick="LicensesDataGrid_MouseDoubleClick"
                                  Style="{StaticResource LicenseDataGridStyle}"
                                  ColumnHeaderStyle="{StaticResource LicenseHeaderStyle}"
                                  RowStyle="{StaticResource LicenseRowStyle}"
                                  CellStyle="{StaticResource LicenseCellStyle}"
                                  MinHeight="220"
                                  MaxHeight="520">

                            <DataGrid.Columns>

                                <!-- LICENCE -->

                                <DataGridTextColumn Header="Licence"
                                                    Binding="{Binding LicenseNumber}"
                                                    SortMemberPath="LicenseNumber"
                                                    Width="0.8*"
                                                    ElementStyle="{StaticResource LicenseCellTextStyle}"/>


                                <!-- PROPRIÉTAIRE -->

                                <DataGridTextColumn Header="Propriétaire"
                                                    Binding="{Binding OwnerName}"
                                                    SortMemberPath="OwnerName"
                                                    Width="1.4*"
                                                    ElementStyle="{StaticResource LicenseCellTextStyle}"/>


                                <!-- CHIEN -->

                                <DataGridTextColumn Header="Chien"
                                                    Binding="{Binding DogName}"
                                                    SortMemberPath="DogName"
                                                    Width="1*"
                                                    ElementStyle="{StaticResource LicenseCellTextStyle}"/>


                                <!-- MUNICIPALITÉ -->

                                <DataGridTextColumn Header="Municipalité"
                                                    Binding="{Binding Municipality}"
                                                    SortMemberPath="Municipality"
                                                    Width="1.2*"
                                                    ElementStyle="{StaticResource LicenseCellTextStyle}"/>


                                <!-- ÉMISSION -->

                                <DataGridTextColumn Header="Émission"
                                                    Binding="{Binding IssueDate,
                                                                      StringFormat=yyyy-MM-dd}"
                                                    SortMemberPath="IssueDate"
                                                    Width="1*"
                                                    ElementStyle="{StaticResource LicenseCellTextStyle}"/>


                                <!-- EXPIRATION -->

                                <DataGridTextColumn Header="Expiration"
                                                    Binding="{Binding ExpirationDate,
                                                                      StringFormat=yyyy-MM-dd}"
                                                    SortMemberPath="ExpirationDate"
                                                    Width="1*"
                                                    ElementStyle="{StaticResource LicenseCellTextStyle}"/>


                                <!-- STATUT -->

                                <DataGridTemplateColumn Header="Statut"
                                                        SortMemberPath="Status"
                                                        Width="130">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Border Style="{StaticResource LicenseStatusBadgeStyle}"
                                                    Margin="10,0"
                                                    MinWidth="92">

                                                <TextBlock Text="{Binding Status}"
                                                           Style="{StaticResource LicenseStatusTextStyle}"
                                                           HorizontalAlignment="Center"
                                                           TextTrimming="None"/>

                                            </Border>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>


                                <!-- ACTION -->

                                <DataGridTemplateColumn Header=""
                                                        CanUserSort="False"
                                                        Width="88">

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Button Content="Voir"
                                                    Click="ViewLicense_Click"
                                                    Style="{StaticResource LicenseViewButtonStyle}"
                                                    VerticalAlignment="Center"/>

                                        </DataTemplate>

                                    </DataGridTemplateColumn.CellTemplate>

                                </DataGridTemplateColumn>

                            </DataGrid.Columns>

                        </DataGrid>


                        <!-- ==================================================
                             AUCUN RÉSULTAT
                             ================================================== -->

                        <Border Background="White"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Padding="32"
                                IsHitTestVisible="False">

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>


                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding HasResults}"
                                                     Value="False">

                                            <Setter Property="Visibility"
                                                    Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>


                            <StackPanel HorizontalAlignment="Center">

                                <TextBlock Text="Aucune licence trouvée"
                                           HorizontalAlignment="Center"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Foreground="#344054"/>


                                <TextBlock Text="Aucune licence ne correspond aux critères de recherche."
                                           HorizontalAlignment="Center"
                                           Margin="0,6,0,0"
                                           FontSize="13"
                                           Foreground="#98A2B3"/>


                                <TextBlock Text="Modifiez les filtres ou utilisez Réinitialiser."
                                           HorizontalAlignment="Center"
                                           Margin="0,3,0,0"
                                           FontSize="12"
                                           Foreground="#98A2B3"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>


                <!-- ==================================================
                     AIDE
                     ================================================== -->

                <TextBlock Text="Double-cliquez sur une ligne ou utilisez Voir pour ouvrir la fiche du chien associé."
                           Margin="4,11,0,0"
                           FontSize="12"
                           Foreground="#98A2B3"/>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>