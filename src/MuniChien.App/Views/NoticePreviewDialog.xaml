<Window x:Class="MuniChien.App.Views.NoticePreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Avis spécifique — Aperçu fidèle (démonstration)"
        Width="1060" Height="810" MinWidth="790" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="4,2,4,12">
            <TextBlock Text="Aperçu — Avis spécifique du Refuge animal" FontSize="22"
                       FontWeight="SemiBold" Foreground="#242B38"/>
            <TextBlock x:Name="DocumentInfo" Foreground="#667085" FontSize="12" Margin="0,4,0,0"/>
            <TextBlock Text="DÉMONSTRATION — Les montants et les dossiers ne sont pas vérifiés. Ne pas expédier."
                       Foreground="#A0450E" FontSize="12" FontWeight="SemiBold" Margin="0,7,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC"
                BorderThickness="1" CornerRadius="12" Padding="4">
            <DocumentViewer x:Name="PreviewViewer"/>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Configurer le modèle" Click="Configure_Click"
                    Style="{StaticResource SecondaryActionButtonStyle}" Padding="15,9" Margin="0,0,10,0"/>
            <Button Content="Fermer" Click="Close_Click"
                    Style="{StaticResource SecondaryActionButtonStyle}" Padding="15,9" Margin="0,0,10,0"/>
            <Button Content="Imprimer (démo)" Click="Print_Click"
                    Style="{StaticResource PrimaryActionButtonStyle}" Padding="15,9"/>
        </StackPanel>
    </Grid>
</Window>
