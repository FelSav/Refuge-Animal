<Window x:Class="MuniChien.App.Views.AdminLoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connexion administrateur — démonstration"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F6F7F9">

    <Border Margin="18" Padding="26" CornerRadius="14"
            Background="White" BorderBrush="#E4E7EC" BorderThickness="1">
        <StackPanel>
            <Border Width="44" Height="44" CornerRadius="12"
                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,14">
                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="#C85C16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Connexion administrateur" FontSize="22"
                       FontWeight="SemiBold" Foreground="#242B38"/>
            <TextBlock Text="Accès local temporaire pour tester la page Administration."
                       FontSize="12" Foreground="#667085" TextWrapping="Wrap"
                       Margin="0,7,0,23"/>

            <TextBlock Text="Nom d'utilisateur" FontSize="13" FontWeight="SemiBold" Foreground="#344054"/>
            <TextBox x:Name="UsernameInput" Margin="0,6,0,17" Height="40"
                     Padding="11,8" FontSize="14" MaxLength="80"/>

            <TextBlock Text="Mot de passe" FontSize="13" FontWeight="SemiBold" Foreground="#344054"/>
            <PasswordBox x:Name="PasswordInput" Margin="0,6,0,10" Height="40"
                         Padding="11,8" FontSize="14" MaxLength="80"/>

            <TextBlock x:Name="ErrorMessage" Foreground="#B42318"
                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,14"/>

            <Border Background="#F8FAFC" CornerRadius="8" Padding="11"
                    Margin="0,5,0,18">
                <TextBlock Text="Mode démo : ce mot de passe ne protège aucune donnée réelle. La vraie connexion sera assurée par l'API."
                           TextWrapping="Wrap" FontSize="11" Foreground="#667085"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Click="Cancel_Click"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Padding="16,8" Margin="0,0,10,0" IsCancel="True"/>
                <Button Content="Se connecter" Click="Login_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Padding="16,8" IsDefault="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
