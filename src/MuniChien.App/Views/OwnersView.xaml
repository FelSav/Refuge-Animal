<UserControl x:Class="MuniChien.App.Views.OwnersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:feedback="clr-namespace:MuniChien.App.Views.Controls">

    <UserControl.Resources>

        <!-- ==================================================
             CARTES
             ================================================== -->

        <Style x:Key="OwnerCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <!-- ==================================================
             TITRES
             ================================================== -->

        <Style x:Key="OwnerSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <!-- ==================================================
             LABELS
             ================================================== -->

        <Style x:Key="OwnerLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ==================================================
             TEXTE EN LECTURE SEULE
             ================================================== -->

        <Style x:Key="OwnerValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <Style x:Key="OwnerValueBoxStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="12,8"/>

        </Style>


        <!-- ==================================================
             TEXTBOX ÉDITION
             ================================================== -->

        <Style x:Key="OwnerEditTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#E87524"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ==================================================
             AFFICHAGE / ÉDITION
             ================================================== -->

        <Style x:Key="OwnerReadOnlyContainerStyle"
               TargetType="Border"
               BasedOn="{StaticResource OwnerValueBoxStyle}">

            <Setter Property="Visibility"
                    Value="Visible"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="OwnerEditFieldStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource OwnerEditTextBoxStyle}">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="OwnerEditComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource RoundedComboBoxStyle}">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Setter Property="Height"
                    Value="38"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ==================================================
             BOUTON MODIFIER
             ================================================== -->

        <Style x:Key="OwnerModifyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryActionButtonStyle}">

            <Setter Property="Visibility"
                    Value="Visible"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ==================================================
             BOUTONS ÉDITION
             ================================================== -->

        <Style x:Key="OwnerEditButtonPanelStyle"
               TargetType="StackPanel">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ==================================================
             DATAGRID
             ================================================== -->

        <Style x:Key="OwnerDogsDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FCFCFD"/>

            <Setter Property="RowHeight"
                    Value="44"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

        </Style>


        <Style x:Key="OwnerDogsHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="BorderBrush"
                    Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <Style x:Key="OwnerDogsRowStyle"
               TargetType="DataGridRow">

            <Setter Property="BorderBrush"
                    Value="#EEF1F4"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8F9FB"/>

                </Trigger>


                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FFF2E9"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="OwnerDogsCellStyle"
               TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <Style x:Key="OwnerDogsTextStyle"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="10,0"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>

        <!-- Répertoire : colonnes lisibles et survol discret des lignes. -->
        <Style x:Key="ClientDirectoryGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="47"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F3"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="RowBackground" Value="White"/>
</Style>
        <Style x:Key="ClientListTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#263243"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    <Style x:Key="ClientDirectoryRowStyle" TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7EF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFEAD9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ClientDirectoryGridStyleHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#4E5A6B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E4E7EC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
</UserControl.Resources>


    <!-- ==================================================
         PAGE
         ================================================== -->

    <Grid Background="#F6F7F9">
        <!-- VUE LISTE : tableau à hauteur naturelle, un seul défilement vertical pour toute la page. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Hidden (et non Collapsed) conserve la position de la liste pendant l'ouverture d'une fiche. -->
                        <DataTrigger Binding="{Binding IsDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Hidden"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="30,26,30,42">
                <!-- Actions et titre -->
                <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Clients" FontSize="29" FontWeight="SemiBold" Foreground="#252D3B"/>
                        <TextBlock Text="Consultez les dossiers clients, avec ou sans chien." FontSize="13" Margin="0,5,0,0" Foreground="#697587"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Actualiser" Command="{Binding ReloadCommand}" Height="43" Padding="15,5" Style="{StaticResource SecondaryActionButtonStyle}"/>
<Button Content="+ Nouveau client" Click="AddOwner_Click" Margin="10,0,0,0" Height="43" Padding="15,5" Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Recherche en permanence visible; filtres avancés repliables pour dégager le tableau. -->
                <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                        CornerRadius="14" Padding="18,15" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Recherche rapide" FontWeight="SemiBold" FontSize="13"
                                   Foreground="#344054" Margin="0,0,0,7"/>
                        <TextBox Height="43" Text="{Binding ClientSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nom, téléphone, numéro de dossier, adresse ou courriel" Padding="12,7" FontSize="14"
                                 BorderBrush="#D7DDE5" Background="#FCFCFD"/>
                        <Expander Margin="0,12,0,0" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Filtres avancés" FontSize="13" FontWeight="SemiBold" Foreground="#B35716"/>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <WrapPanel>
                                    <StackPanel Width="182" Margin="0,0,14,8">
                    <TextBlock Text="Municipalité" FontSize="12" Foreground="#697587" Margin="0,0,0,6"/>
                    <ComboBox Height="40" ItemsSource="{Binding ClientMunicipalityFilters}"
                              SelectedItem="{Binding ClientMunicipalityFilter, Mode=TwoWay}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                </StackPanel>
<StackPanel Width="152" Margin="0,0,14,8">
                    <TextBlock Text="Statut" FontSize="12" Foreground="#697587" Margin="0,0,0,6"/>
                    <ComboBox Height="40" ItemsSource="{Binding ClientStatusFilters}"
                              SelectedItem="{Binding ClientStatusFilter, Mode=TwoWay}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                </StackPanel>
<StackPanel Width="152" Margin="0,0,14,8">
                    <TextBlock Text="Fidélité" FontSize="12" Foreground="#697587" Margin="0,0,0,6"/>
                    <ComboBox Height="40" ItemsSource="{Binding ClientLoyaltyFilters}"
                              SelectedItem="{Binding ClientLoyaltyFilter, Mode=TwoWay}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                </StackPanel>
<StackPanel Width="152" Margin="0,0,14,8">
                    <TextBlock Text="Chiens" FontSize="12" Foreground="#697587" Margin="0,0,0,6"/>
                    <ComboBox Height="40" ItemsSource="{Binding ClientDogFilters}"
                              SelectedItem="{Binding ClientDogFilter, Mode=TwoWay}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                </StackPanel>
                                </WrapPanel>
                                <Button Content="Effacer les filtres" Command="{Binding ClearClientFiltersCommand}"
                                        HorizontalAlignment="Right" Margin="0,2,0,0"
                                        Height="36" Padding="12,4" Style="{StaticResource SecondaryActionButtonStyle}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Résultats : tableau complet, sans petite zone verticale limitée. -->
                <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                        CornerRadius="14" Padding="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="20,18,20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tous les dossiers" FontSize="17" FontWeight="SemiBold" Foreground="#263243"/>
                                <Border Margin="12,0,0,0" Padding="10,5" Background="#FFF3E8" CornerRadius="12">
                                    <TextBlock Text="{Binding ClientResultLabel}" FontSize="12"
                                               Foreground="#9B531B" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Cliquez sur une ligne pour ouvrir sa fiche"
                                       FontSize="12" Foreground="#7C8898" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Le DataGrid grandit avec ses lignes; la molette est redirigée vers le ScrollViewer parent. -->
                        <DataGrid Margin="2,0,2,0" Style="{StaticResource ClientDirectoryGridStyle}"
                                  ColumnHeaderStyle="{StaticResource ClientDirectoryGridStyleHeaderStyle}"
                                  RowStyle="{StaticResource ClientDirectoryRowStyle}"
                                  feedback:DirectoryScrollBehavior.ForwardMouseWheel="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="False"
                                  EnableRowVirtualization="False"
                                  ItemsSource="{Binding ClientList}"
                                  SelectedItem="{Binding SelectedListClient, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dossier" Binding="{Binding FileNumber}" Width="90" ElementStyle="{StaticResource ClientListTextStyle}"/>
<DataGridTextColumn Header="Client" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource ClientListTextStyle}"/>
<DataGridTextColumn Header="Téléphone" Binding="{Binding Phone}" Width="150" ElementStyle="{StaticResource ClientListTextStyle}"/>
<DataGridTextColumn Header="Municipalité" Binding="{Binding Municipality}" Width="1.3*" ElementStyle="{StaticResource ClientListTextStyle}"/>
<DataGridTextColumn Header="Chiens" Binding="{Binding DogCount}" Width="72" ElementStyle="{StaticResource ClientListTextStyle}"/>
<DataGridTextColumn Header="Fidélité" Binding="{Binding Loyalty}" Width="115" ElementStyle="{StaticResource ClientListTextStyle}"/>
<DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="90" ElementStyle="{StaticResource ClientListTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Aucun dossier ne correspond aux filtres."
                                   Margin="20,24,20,26" TextAlignment="Center"
                                   FontSize="14" Foreground="#667085" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ClientResultLabel}" Value="0 client(s)">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Text="Les résultats sont issus des dossiers locaux de démonstration."
                           FontSize="12" Foreground="#8A95A5" Margin="6,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- VUE FICHE : intégralité de l'écran existant, sans perte de fonctionnalités. -->
        <Grid>
            <Grid.Style><Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsDetailView}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger></Style.Triggers>
            </Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="40,14">
                <Button HorizontalAlignment="Left" Content="← Retour à la liste" Height="40" Padding="14,5"
                        Command="{Binding BackToListCommand}" IsEnabled="{Binding CanChangeSelection}"
                        Style="{StaticResource SecondaryActionButtonStyle}"/>
            </Border>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,38,52,42">

                <!-- États de lecture et réessai (services locaux / future API). -->
                <feedback:DataLoadStatusView Margin="0,0,0,16"/>

                <!-- Sélection du dossier : indépendante de la navigation depuis les chiens. -->
                <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                        CornerRadius="14" Padding="18" Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Choisir un client" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#242B38"/>
                            <TextBlock Text="Sélectionnez le dossier à consulter" Margin="0,4,0,0"
                                       FontSize="12" Foreground="#667085"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Height="42" Margin="12,0,0,0"
                                  ItemsSource="{Binding OwnerOptions}"
                                  SelectedItem="{Binding SelectedOwner, Mode=TwoWay}"
                                  DisplayMemberPath="SelectionDisplay"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="SelectionDisplay"
                                  IsEnabled="{Binding CanChangeSelection}"
                                  Style="{StaticResource RoundedComboBoxStyle}"/>
                        <Button Grid.Column="2"
                                Content="+ Nouveau client"
                                Click="AddOwner_Click"
                                IsEnabled="{Binding CanChangeSelection}"
                                MinWidth="205" Height="44" Margin="14,0,0,0"
                                Padding="18,6" FontSize="14" FontWeight="SemiBold"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </Grid>
                </Border>


                <!-- ==================================================
                     ENTÊTE
                     ================================================== -->

                <Grid Margin="0,0,0,26">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock Text="Dossier client"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#242B38"/>

                        <TextBlock Margin="0,6,0,0"
                                   FontSize="14"
                                   Foreground="#667085">

                            <Run Text="Dossier #"/>

                            <Run Text="{Binding FileNumber,
                                              Mode=OneWay}"/>

                        </TextBlock>
                        <TextBlock Text="{Binding ClientProfileLabel}" Foreground="#667085"
                                   FontSize="12" Margin="0,5,0,0"/>

                    </StackPanel>


                    <!-- Modifier -->
                    <Button Grid.Column="1"
                            Content="Modifier"
                            Command="{Binding ModifyCommand}"
                            IsEnabled="{Binding IsNotEditingComments}"
                            Style="{StaticResource OwnerModifyButtonStyle}"
                            VerticalAlignment="Top"/>


                    <!-- Annuler + enregistrer -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Style="{StaticResource OwnerEditButtonPanelStyle}">

                        <Button Content="Annuler"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Margin="0,0,12,0"/>

                        <Button Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>

                    </StackPanel>

                </Grid>


                <!-- ==================================================
                     INFORMATIONS + COORDONNÉES
                     ================================================== -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ==================================================
                         INFORMATIONS
                         ================================================== -->

                    <Border Grid.Column="0"
                            Style="{StaticResource OwnerCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Informations client"
                                       Style="{StaticResource OwnerSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Prénom -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Prénom"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding FirstName}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding FirstName,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- Nom -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Nom"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding LastName}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding LastName,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- Municipalité : facultative pour une fidélité seule,
                                 nécessaire avant la création d'une licence canine. -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Municipalité" Style="{StaticResource OwnerLabelStyle}"/>
                                <Grid Grid.Column="1">
                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">
                                        <TextBlock Text="{Binding MunicipalityDisplay}"
                                                   Style="{StaticResource OwnerValueStyle}"/>
                                    </Border>
                                    <ComboBox ItemsSource="{Binding MunicipalityOptions}"
                                              SelectedItem="{Binding Municipality, Mode=TwoWay}"
                                              Style="{StaticResource OwnerEditComboBoxStyle}"/>
                                </Grid>
                            </Grid>

                            <!-- Statut -->
                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Statut"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Status}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding Status}"
                                              Style="{StaticResource OwnerEditComboBoxStyle}"/>

                                </Grid>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ==================================================
                         COORDONNÉES
                         ================================================== -->

                    <Border Grid.Column="2"
                            Style="{StaticResource OwnerCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Coordonnées"
                                       Style="{StaticResource OwnerSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Téléphone -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Téléphone"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Phone}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding Phone,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- Cellulaire -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Cellulaire"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding CellPhone}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding CellPhone,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- Courriel -->
                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Courriel"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Email}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding Email,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     ADRESSE
                     ================================================== -->

                <Border Style="{StaticResource OwnerCardStyle}"
                        Margin="0,24,0,0">

                    <StackPanel>

                        <TextBlock Text="Adresse"
                                   Style="{StaticResource OwnerSectionTitleStyle}"
                                   Margin="0,0,0,12"/>


                        <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                            <TextBlock Text="{Binding Address}"
                                       Style="{StaticResource OwnerValueStyle}"/>

                        </Border>


                        <TextBox Text="{Binding Address,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource OwnerEditFieldStyle}"/>

                    </StackPanel>

                </Border>


                <!-- ==================================================
                     FIDÉLITÉ — CARTE ACTIVE LA PLUS AVANCÉE
                     ================================================== -->

                <Border Style="{StaticResource OwnerCardStyle}"
                        Margin="0,24,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Fidélité"
                                           Style="{StaticResource OwnerSectionTitleStyle}"/>
                                <TextBlock Text="Carte de fidélité la plus avancée de ce client."
                                           FontSize="12" Foreground="#667085" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Voir les fidélités"
                                    Click="OpenLoyalty_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    MinHeight="43" Padding="16,8"
                                    Margin="12,0,0,0"/>
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding LoyaltySummaryProgram}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="#242B38"/>
                                <TextBlock Text="{Binding LoyaltySummaryDetail}"
                                           FontSize="12" Foreground="#667085"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding LoyaltySummaryProgress}"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#C45A0F"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding LoyaltySummaryStamps}"
                                      HorizontalAlignment="Left" Margin="0,0,0,16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="42" Height="42" CornerRadius="7"
                                            BorderThickness="1" Margin="0,0,6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#F8FAFC"/>
                                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                        <Setter Property="Background" Value="#EA7B22"/>
                                                        <Setter Property="BorderBrush" Value="#EA7B22"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Display}" FontSize="13"
                                                   FontWeight="SemiBold" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#667085"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ProgressBar Value="{Binding LoyaltySummaryPercent, Mode=OneWay}"
                                     Minimum="0" Maximum="100"
                                     Height="8" Background="#EEF1F5"
                                     Foreground="#EA7B22" BorderThickness="0"/>
                        <TextBlock Text="Les cases sont modifiables dans « Voir les fidélités ». Mode local de démonstration."
                                   FontSize="11" Foreground="#667085"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>


                <!-- ==================================================
                     CHIENS ASSOCIÉS
                     ================================================== -->

                <Grid Margin="0,32,0,14">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Text="Chiens associés"
                               Style="{StaticResource OwnerSectionTitleStyle}"
                               VerticalAlignment="Center"/>


                    <Button Grid.Column="1"
                            Content="+ Ajouter un chien"
                            Click="AddDog_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="14,8"
                            FontSize="13"
                            Margin="16,0,0,0"/>

                </Grid>


                <Border Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">

                    <DataGrid ItemsSource="{Binding Dogs}"
                              SelectedItem="{Binding SelectedDog,
                                 Mode=TwoWay}"
                              Style="{StaticResource OwnerDogsDataGridStyle}"
                                ColumnHeaderStyle="{StaticResource OwnerDogsHeaderStyle}"
                            RowStyle="{StaticResource OwnerDogsRowStyle}"
                            CellStyle="{StaticResource OwnerDogsCellStyle}"
                            MaxHeight="300">

                        <DataGrid.Columns>


                            <DataGridTextColumn Header="Chien"
                                                Binding="{Binding DogName}"
                                                Width="1*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Propriétaire"
                                                Binding="{Binding OwnerName}"
                                                Width="1.4*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Race"
                                                Binding="{Binding Breed}"
                                                Width="1.2*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Âge"
                                                Binding="{Binding AgeDisplay}"
                                                Width="0.8*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Poids"
                                                Binding="{Binding WeightDisplay}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Couleur"
                                                Binding="{Binding Color}"
                                                Width="1*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Sexe"
                                                Binding="{Binding Sex}"
                                                Width="0.7*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Statut"
                                                Binding="{Binding Status}"
                                                Width="0.8*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Stérilisé"
                                                Binding="{Binding Sterilized}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Licence"
                                                Binding="{Binding LicenseNumber}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                        </DataGrid.Columns>

                    </DataGrid>

                </Border>


                <!-- ==================================================
                     COMMENTAIRES : ÉDITION DIRECTE ET IMPRESSION
                     ================================================== -->
                <Grid Margin="0,30,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Commentaires" Style="{StaticResource OwnerSectionTitleStyle}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanUseCommentActions}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="Modifier les commentaires" Command="{Binding EditCommentsCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Imprimer" Command="{Binding PrintCommentsCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}" Padding="14,7"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingComments}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Content="Annuler" Command="{Binding CancelCommentsCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}" Padding="14,7" Margin="0,0,8,0"/>
                        <Button Content="Enregistrer" Command="{Binding SaveCommentsCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}" Padding="14,7"/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <!-- Lecture seule -->
                    <Border Background="White" BorderBrush="#D0D5DD" BorderThickness="1"
                            CornerRadius="12" MinHeight="130" Padding="14">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommentsReadOnly}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CommentsDisplay, Mode=OneWay}" FontSize="14"
                                   Foreground="#242424" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Édition depuis la fiche complète ou depuis Modifier les commentaires -->
                    <Border Background="White" BorderBrush="#E87524" BorderThickness="1"
                            CornerRadius="12" MinHeight="130">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCommentsEditable}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBox Text="{Binding Comments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Padding="14"
                                 FontSize="14" Foreground="#242424" AcceptsReturn="True"
                                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>

            </StackPanel>

        </ScrollViewer>

        </Grid>
    </Grid>

</UserControl>