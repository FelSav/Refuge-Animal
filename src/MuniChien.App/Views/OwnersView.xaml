<UserControl x:Class="MuniChien.App.Views.OwnersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ==================================================
             CARTES
             ================================================== -->

        <Style x:Key="OwnerCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <!-- ==================================================
             TITRES DE SECTION
             ================================================== -->

        <Style x:Key="OwnerSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <!-- ==================================================
             LABEL
             ================================================== -->

        <Style x:Key="OwnerLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ==================================================
             VALEUR
             ================================================== -->

        <Style x:Key="OwnerValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <!-- ==================================================
             CHAMP D'AFFICHAGE
             ================================================== -->

        <Style x:Key="OwnerValueBoxStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="12,8"/>

        </Style>


        <!-- ==================================================
             DATAGRID
             ================================================== -->

        <Style x:Key="OwnerDogsDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FCFCFD"/>

            <Setter Property="RowHeight"
                    Value="44"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

        </Style>


        <Style x:Key="OwnerDogsHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="BorderBrush"
                    Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <Style x:Key="OwnerDogsRowStyle"
               TargetType="DataGridRow">

            <Setter Property="BorderBrush"
                    Value="#EEF1F4"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8F9FB"/>

                </Trigger>


                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FFF2E9"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="OwnerDogsCellStyle"
               TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <Style x:Key="OwnerDogsTextStyle"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="10,0"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>

    </UserControl.Resources>


    <!-- ==================================================
         PAGE
         ================================================== -->

    <Grid Background="#F6F7F9">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,38,52,42">


                <!-- ==================================================
                     TITRE
                     ================================================== -->

                <Grid Margin="0,0,0,26">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Dossier propriétaire"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#242B38"/>

                        <TextBlock Margin="0,6,0,0"
                                   FontSize="14"
                                   Foreground="#667085">

                            <Run Text="Dossier #"/>

                            <Run Text="{Binding FileNumber, Mode=OneWay}"/>

                        </TextBlock>

                    </StackPanel>


                    <Button Grid.Column="1"
                            Content="Modifier"
                            Command="{Binding ModifyCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            VerticalAlignment="Top"/>

                </Grid>


                <!-- ==================================================
                     INFORMATIONS + COORDONNÉES
                     ================================================== -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ==================================================
                         INFORMATIONS PROPRIÉTAIRE
                         ================================================== -->

                    <Border Grid.Column="0"
                            Style="{StaticResource OwnerCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Informations propriétaire"
                                       Style="{StaticResource OwnerSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Prénom -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Prénom"
                                           Style="{StaticResource OwnerLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource OwnerValueBoxStyle}">

                                    <TextBlock Text="{Binding FirstName}"
                                               Style="{StaticResource OwnerValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Nom -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Nom"
                                           Style="{StaticResource OwnerLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource OwnerValueBoxStyle}">

                                    <TextBlock Text="{Binding LastName}"
                                               Style="{StaticResource OwnerValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Statut -->
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Statut"
                                           Style="{StaticResource OwnerLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource OwnerValueBoxStyle}">

                                    <TextBlock Text="{Binding Status}"
                                               Style="{StaticResource OwnerValueStyle}"/>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ==================================================
                         COORDONNÉES
                         ================================================== -->

                    <Border Grid.Column="2"
                            Style="{StaticResource OwnerCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Coordonnées"
                                       Style="{StaticResource OwnerSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Téléphone -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Téléphone"
                                           Style="{StaticResource OwnerLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource OwnerValueBoxStyle}">

                                    <TextBlock Text="{Binding Phone}"
                                               Style="{StaticResource OwnerValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Cellulaire -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Cellulaire"
                                           Style="{StaticResource OwnerLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource OwnerValueBoxStyle}">

                                    <TextBlock Text="{Binding CellPhone}"
                                               Style="{StaticResource OwnerValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Courriel -->
                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Courriel"
                                           Style="{StaticResource OwnerLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource OwnerValueBoxStyle}">

                                    <TextBlock Text="{Binding Email}"
                                               Style="{StaticResource OwnerValueStyle}"/>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     ADRESSE
                     ================================================== -->

                <Border Style="{StaticResource OwnerCardStyle}"
                        Margin="0,24,0,0">

                    <StackPanel>

                        <TextBlock Text="Adresse"
                                   Style="{StaticResource OwnerSectionTitleStyle}"
                                   Margin="0,0,0,12"/>

                        <TextBlock Text="{Binding Address}"
                                   FontSize="14"
                                   Foreground="#242424"/>

                    </StackPanel>

                </Border>


                <!-- ==================================================
                     CHIENS ASSOCIÉS
                     ================================================== -->

                <Grid Margin="0,32,0,14">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <TextBlock Grid.Column="0"
                               Text="Chiens associés"
                               Style="{StaticResource OwnerSectionTitleStyle}"
                               VerticalAlignment="Center"/>


                    <Button Grid.Column="1"
                            Content="+ Ajouter un chien"
                            Command="{Binding AddDogCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="14,8"
                            FontSize="13"
                            Margin="16,0,0,0"/>

                </Grid>


                <Border Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">

                    <DataGrid ItemsSource="{Binding Dogs}"
                              Style="{StaticResource OwnerDogsDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource OwnerDogsHeaderStyle}"
                              RowStyle="{StaticResource OwnerDogsRowStyle}"
                              CellStyle="{StaticResource OwnerDogsCellStyle}"
                              MaxHeight="300">

                        <DataGrid.Columns>


                            <DataGridTextColumn Header="Chien"
                                                Binding="{Binding DogName}"
                                                Width="1*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Propriétaire"
                                                Binding="{Binding OwnerName}"
                                                Width="1.4*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Race"
                                                Binding="{Binding Breed}"
                                                Width="1.2*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Âge"
                                                Binding="{Binding Age}"
                                                Width="0.8*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Poids"
                                                Binding="{Binding Weight}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Couleur"
                                                Binding="{Binding Color}"
                                                Width="1*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Sexe"
                                                Binding="{Binding Sex}"
                                                Width="0.7*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Statut"
                                                Binding="{Binding Status}"
                                                Width="0.8*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Stérilisé"
                                                Binding="{Binding Sterilized}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Licence"
                                                Binding="{Binding LicenseNumber}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                        </DataGrid.Columns>

                    </DataGrid>

                </Border>


                <!-- ==================================================
                     COMMENTAIRES
                     ================================================== -->

                <TextBlock Text="Commentaires"
                           Style="{StaticResource OwnerSectionTitleStyle}"
                           Margin="0,30,0,12"/>


                <Border Background="White"
                        BorderBrush="#D0D5DD"
                        BorderThickness="1"
                        CornerRadius="12"
                        MinHeight="130">

                    <TextBox Text="{Binding Comments,
                                           UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="14"
                             FontSize="14"
                             Foreground="#242424"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>