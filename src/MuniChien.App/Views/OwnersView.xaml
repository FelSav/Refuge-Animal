<UserControl x:Class="MuniChien.App.Views.OwnersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ==================================================
             CARTES
             ================================================== -->

        <Style x:Key="OwnerCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <!-- ==================================================
             TITRES
             ================================================== -->

        <Style x:Key="OwnerSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <!-- ==================================================
             LABELS
             ================================================== -->

        <Style x:Key="OwnerLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ==================================================
             TEXTE EN LECTURE SEULE
             ================================================== -->

        <Style x:Key="OwnerValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <Style x:Key="OwnerValueBoxStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="12,8"/>

        </Style>


        <!-- ==================================================
             TEXTBOX ÉDITION
             ================================================== -->

        <Style x:Key="OwnerEditTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#E87524"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ==================================================
             AFFICHAGE / ÉDITION
             ================================================== -->

        <Style x:Key="OwnerReadOnlyContainerStyle"
               TargetType="Border"
               BasedOn="{StaticResource OwnerValueBoxStyle}">

            <Setter Property="Visibility"
                    Value="Visible"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="OwnerEditFieldStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource OwnerEditTextBoxStyle}">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="OwnerEditComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource RoundedComboBoxStyle}">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Setter Property="Height"
                    Value="38"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ==================================================
             BOUTON MODIFIER
             ================================================== -->

        <Style x:Key="OwnerModifyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryActionButtonStyle}">

            <Setter Property="Visibility"
                    Value="Visible"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ==================================================
             BOUTONS ÉDITION
             ================================================== -->

        <Style x:Key="OwnerEditButtonPanelStyle"
               TargetType="StackPanel">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ==================================================
             DATAGRID
             ================================================== -->

        <Style x:Key="OwnerDogsDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FCFCFD"/>

            <Setter Property="RowHeight"
                    Value="44"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

            <Setter Property="SelectionMode"
                    Value="Single"/>

            <Setter Property="SelectionUnit"
                    Value="FullRow"/>

        </Style>


        <Style x:Key="OwnerDogsHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="BorderBrush"
                    Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <Style x:Key="OwnerDogsRowStyle"
               TargetType="DataGridRow">

            <Setter Property="BorderBrush"
                    Value="#EEF1F4"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#F8F9FB"/>

                </Trigger>


                <Trigger Property="IsSelected"
                         Value="True">

                    <Setter Property="Background"
                            Value="#FFF2E9"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="OwnerDogsCellStyle"
               TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <Style x:Key="OwnerDogsTextStyle"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="10,0"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>

    </UserControl.Resources>


    <!-- ==================================================
         PAGE
         ================================================== -->

    <Grid Background="#F6F7F9">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,38,52,42">

                <!-- Sélection du dossier : indépendante de la navigation depuis les chiens. -->
                <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                        CornerRadius="14" Padding="18" Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Choisir un propriétaire" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#242B38"/>
                            <TextBlock Text="Sélectionnez le dossier à consulter" Margin="0,4,0,0"
                                       FontSize="12" Foreground="#667085"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Height="42" Margin="12,0,0,0"
                                  ItemsSource="{Binding OwnerOptions}"
                                  SelectedItem="{Binding SelectedOwner, Mode=TwoWay}"
                                  DisplayMemberPath="SelectionDisplay"
                                  IsTextSearchEnabled="True"
                                  TextSearch.TextPath="SelectionDisplay"
                                  IsEnabled="{Binding IsNotEditing}"
                                  Style="{StaticResource RoundedComboBoxStyle}"/>
                    </Grid>
                </Border>


                <!-- ==================================================
                     ENTÊTE
                     ================================================== -->

                <Grid Margin="0,0,0,26">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock Text="Dossier propriétaire"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#242B38"/>

                        <TextBlock Margin="0,6,0,0"
                                   FontSize="14"
                                   Foreground="#667085">

                            <Run Text="Dossier #"/>

                            <Run Text="{Binding FileNumber,
                                              Mode=OneWay}"/>

                        </TextBlock>

                    </StackPanel>


                    <!-- Modifier -->
                    <Button Grid.Column="1"
                            Content="Modifier"
                            Command="{Binding ModifyCommand}"
                            Style="{StaticResource OwnerModifyButtonStyle}"
                            VerticalAlignment="Top"/>


                    <!-- Annuler + enregistrer -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Style="{StaticResource OwnerEditButtonPanelStyle}">

                        <Button Content="Annuler"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Margin="0,0,12,0"/>

                        <Button Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>

                    </StackPanel>

                </Grid>


                <!-- ==================================================
                     INFORMATIONS + COORDONNÉES
                     ================================================== -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ==================================================
                         INFORMATIONS
                         ================================================== -->

                    <Border Grid.Column="0"
                            Style="{StaticResource OwnerCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Informations propriétaire"
                                       Style="{StaticResource OwnerSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Prénom -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Prénom"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding FirstName}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding FirstName,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- Nom -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Nom"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding LastName}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding LastName,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- Statut -->
                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Statut"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Status}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding Status}"
                                              Style="{StaticResource OwnerEditComboBoxStyle}"/>

                                </Grid>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ==================================================
                         COORDONNÉES
                         ================================================== -->

                    <Border Grid.Column="2"
                            Style="{StaticResource OwnerCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Coordonnées"
                                       Style="{StaticResource OwnerSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Téléphone -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Téléphone"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Phone}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding Phone,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- Cellulaire -->
                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Cellulaire"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding CellPhone}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding CellPhone,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- Courriel -->
                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="110"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Courriel"
                                           Style="{StaticResource OwnerLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Email}"
                                                   Style="{StaticResource OwnerValueStyle}"/>

                                    </Border>


                                    <TextBox Text="{Binding Email,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource OwnerEditFieldStyle}"/>

                                </Grid>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     ADRESSE
                     ================================================== -->

                <Border Style="{StaticResource OwnerCardStyle}"
                        Margin="0,24,0,0">

                    <StackPanel>

                        <TextBlock Text="Adresse"
                                   Style="{StaticResource OwnerSectionTitleStyle}"
                                   Margin="0,0,0,12"/>


                        <Border Style="{StaticResource OwnerReadOnlyContainerStyle}">

                            <TextBlock Text="{Binding Address}"
                                       Style="{StaticResource OwnerValueStyle}"/>

                        </Border>


                        <TextBox Text="{Binding Address,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource OwnerEditFieldStyle}"/>

                    </StackPanel>

                </Border>


                <!-- ==================================================
                     CHIENS ASSOCIÉS
                     ================================================== -->

                <Grid Margin="0,32,0,14">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="Auto"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <TextBlock Text="Chiens associés"
                               Style="{StaticResource OwnerSectionTitleStyle}"
                               VerticalAlignment="Center"/>


                    <Button Grid.Column="1"
                            Content="+ Ajouter un chien"
                            Click="AddDog_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="14,8"
                            FontSize="13"
                            Margin="16,0,0,0"/>

                </Grid>


                <Border Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">

                    <DataGrid ItemsSource="{Binding Dogs}"
                              SelectedItem="{Binding SelectedDog,
                                 Mode=TwoWay}"
                              Style="{StaticResource OwnerDogsDataGridStyle}"
                                ColumnHeaderStyle="{StaticResource OwnerDogsHeaderStyle}"
                            RowStyle="{StaticResource OwnerDogsRowStyle}"
                            CellStyle="{StaticResource OwnerDogsCellStyle}"
                            MaxHeight="300">

                        <DataGrid.Columns>


                            <DataGridTextColumn Header="Chien"
                                                Binding="{Binding DogName}"
                                                Width="1*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Propriétaire"
                                                Binding="{Binding OwnerName}"
                                                Width="1.4*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Race"
                                                Binding="{Binding Breed}"
                                                Width="1.2*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Âge"
                                                Binding="{Binding AgeDisplay}"
                                                Width="0.8*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Poids"
                                                Binding="{Binding WeightDisplay}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Couleur"
                                                Binding="{Binding Color}"
                                                Width="1*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Sexe"
                                                Binding="{Binding Sex}"
                                                Width="0.7*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Statut"
                                                Binding="{Binding Status}"
                                                Width="0.8*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Stérilisé"
                                                Binding="{Binding Sterilized}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                            <DataGridTextColumn Header="Licence"
                                                Binding="{Binding LicenseNumber}"
                                                Width="0.9*"
                                                ElementStyle="{StaticResource OwnerDogsTextStyle}"/>


                        </DataGrid.Columns>

                    </DataGrid>

                </Border>


                <!-- ==================================================
     COMMENTAIRES
     ================================================== -->

                <TextBlock Text="Commentaires"
           Style="{StaticResource OwnerSectionTitleStyle}"
           Margin="0,30,0,12"/>


                <Grid>

                    <!-- Lecture seule -->
                    <Border Background="White"
            BorderBrush="#D0D5DD"
            BorderThickness="1"
            CornerRadius="12"
            MinHeight="130">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Visibility"
                        Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditing}"
                                 Value="True">

                                        <Setter Property="Visibility"
                                Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>


                        <TextBlock Text="{Binding Comments}"
                   Padding="14"
                   FontSize="14"
                   Foreground="#242424"
                   TextWrapping="Wrap"/>

                    </Border>


                    <!-- Édition -->
                    <Border Background="White"
            BorderBrush="#E87524"
            BorderThickness="1"
            CornerRadius="12"
            MinHeight="130">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Visibility"
                        Value="Collapsed"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsEditing}"
                                 Value="True">

                                        <Setter Property="Visibility"
                                Value="Visible"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>


                        <TextBox Text="{Binding Comments,
                                 UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                BorderThickness="0"
                                Padding="14"
                                FontSize="14"
                                Foreground="#242424"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"/>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>