<Window x:Class="MuniChien.App.Views.LoyaltyCardsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cartes de fidélité — MuniChien"
        Width="1090" Height="770" MinWidth="780" MinHeight="570"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6F9">
    <Window.Resources>
        <Style x:Key="LoyaltyCardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E7EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="LoyaltyStampButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="StampBorder" Height="42" CornerRadius="7"
                                BorderBrush="{Binding StampBorder}" BorderThickness="1"
                                Background="{Binding StampBackground}">
                            <TextBlock Text="{Binding DisplayText}" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{Binding StampForeground}"
                                       FontWeight="SemiBold" FontSize="15"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="StampBorder" Property="BorderBrush" Value="#B55D16"/>
                                <Setter TargetName="StampBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LoyaltyCardTemplate">
            <Border Style="{StaticResource LoyaltyCardBorder}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ProgramName}"
                                       FontSize="18" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="{Binding CardLabel}"
                                       Foreground="#667085" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ProgressText}"
                                       Foreground="#BF5B12" FontWeight="Bold"
                                       FontSize="19" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="#667085" FontSize="12"
                                       HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                    <!-- Une seule zone de defilement (verticale) pour toute la fenetre. -->
                    <!-- UniformGrid garde les 12 cases sur une seule ligne et evite de capter la molette. -->
                    <ItemsControl ItemsSource="{Binding Stamps}"
                                  Margin="0,0,0,12">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="12"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LoyaltyStampButtonStyle}"
                                        ToolTip="{Binding DateTooltip}"
                                        Click="Stamp_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ActivityText}"
                                   VerticalAlignment="Center"
                                   Foreground="#667085" FontSize="12"
                                   TextWrapping="Wrap"/>
                        <Button Grid.Column="1"
                                Content="Cadeau remis"
                                Tag="{Binding Id}"
                                Click="Reward_Click"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                Padding="18,9" MinHeight="42"
                                IsEnabled="{Binding CanGiveReward}"
                                Visibility="{Binding RewardButtonVisibility}"
                                Margin="14,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC"
                BorderThickness="0,0,0,1" Padding="30,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Cartes de fidélité"
                               FontSize="27" FontWeight="SemiBold"
                               Foreground="#242B38"/>
                    <TextBlock x:Name="OwnerNameText"
                               Foreground="#667085" FontSize="14"
                               Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#FFF3E9"
                        BorderBrush="#FFD2AD" BorderThickness="1"
                        CornerRadius="20" VerticalAlignment="Center"
                        Padding="15,8">
                    <TextBlock Text="Données locales · Démo"
                               Foreground="#B4540C" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer x:Name="CardsScrollViewer" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <StackPanel Margin="30,23,30,24">
                <Border Background="#FFF6EB" CornerRadius="10"
                        BorderBrush="#FFE0BE" BorderThickness="1"
                        Padding="15" Margin="0,0,0,19">
                    <TextBlock Foreground="#914412" TextWrapping="Wrap"
                               Text="Chaque case représente un sac et ses informations détaillées (produit, référence, format, prix, date et facture). Orange : achat complet. Jaune (!) : ancienne coche à compléter. Le cadeau est débloqué seulement après 12 achats détaillés."/>
                </Border>

                <Border Style="{StaticResource LoyaltyCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Ajouter une nouvelle compagnie"
                                   FontSize="18" FontWeight="SemiBold"
                                   Foreground="#242B38" Margin="0,0,0,5"/>
                        <TextBlock Text="Les cinq programmes habituels sont déjà présents. Ajoutez ici une compagnie différente, une seule fois."
                                   FontSize="12" Foreground="#667085"
                                   Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Nom de la nouvelle compagnie"
                                           Foreground="#344054" FontWeight="SemiBold"
                                           FontSize="12" Margin="0,0,0,7"/>
                                <TextBox x:Name="CompanyNameTextBox"
                                         MaxLength="80" Height="45"
                                         Padding="12,9"
                                         VerticalContentAlignment="Center"
                                         Foreground="#242B38" FontSize="14"
                                         Background="White"
                                         BorderBrush="#CBD5E1" BorderThickness="1"
                                         ToolTip="Exemple : une marque ou une animalerie proposant sa propre fidélité"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="+ Ajouter la compagnie"
                                    Click="AddCard_Click"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Padding="14,5" MinHeight="45"
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                        <TextBlock Text="Une seule carte active par compagnie. Le 13e sac gratuit est exactement le produit le moins cher parmi les 12 achats. Après confirmation de sa remise, la même carte recommence à 0/12; le cycle complet est archivé."
                                   Foreground="#667085" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,13,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cartes actives"
                               FontSize="21" FontWeight="SemiBold" Foreground="#242B38"/>
                    <TextBlock Grid.Column="1" x:Name="ActiveCountText"
                               VerticalAlignment="Center" Foreground="#667085"/>
                </Grid>
                <TextBlock x:Name="EmptyActiveText"
                           Text="Aucune carte active pour ce client."
                           Foreground="#667085" Padding="10"
                           Margin="0,0,0,14"/>
                <ItemsControl x:Name="ActiveCardsList"
                              ItemTemplate="{StaticResource LoyaltyCardTemplate}"/>

                <Grid Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Historique des cadeaux remis"
                               FontSize="21" FontWeight="SemiBold"
                               Foreground="#242B38"/>
                    <TextBlock Grid.Column="1" x:Name="ArchiveCountText"
                               VerticalAlignment="Center" Foreground="#667085"/>
                </Grid>
                <TextBlock x:Name="EmptyArchiveText"
                           Text="Aucun cadeau remis pour le moment."
                           Foreground="#667085" Padding="10"/>
                <ItemsControl x:Name="ArchivedCardsList"
                              ItemTemplate="{StaticResource LoyaltyCardTemplate}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White"
                BorderThickness="0,1,0,0" BorderBrush="#E4E7EC"
                Padding="26,13">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                           Text="Mode démo : les cartes seront réinitialisées au redémarrage."
                           FontSize="12" Foreground="#667085"/>
                <Button DockPanel.Dock="Right"
                        Content="Fermer" Click="Close_Click"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Padding="25,8" MinHeight="43"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
