<Window x:Class="MuniChien.App.Views.LoyaltyStatementDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relevé de fidélité — MuniChien"
        Width="1080" Height="810" MinWidth="770" MinHeight="580"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC"
                BorderThickness="0,0,0,1" Padding="27,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Relevé de fidélité" FontSize="25" FontWeight="SemiBold" Foreground="#242B38"/>
                    <TextBlock x:Name="SubtitleText" Foreground="#667085" FontSize="13"
                               TextWrapping="Wrap" Margin="0,4,10,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#FFF3E9" BorderBrush="#FFD2AD"
                        BorderThickness="1" CornerRadius="15" Padding="12,7"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Foreground="#A94A11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="White" Padding="26,12"
                BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
            <StackPanel>
                <CheckBox x:Name="IncludeImagesBox" Content="Inclure les images des factures en annexe"
                          Checked="Attachments_Changed" Unchecked="Attachments_Changed"
                          Foreground="#344054" FontSize="13" VerticalAlignment="Center"/>
                <TextBlock x:Name="AttachmentHintText" FontSize="12" Foreground="#667085"
                           Margin="21,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Margin="24,16,24,14" Background="White"
                BorderBrush="#D9E0EA" BorderThickness="1" CornerRadius="10">
            <FlowDocumentReader x:Name="PreviewReader"
                                ViewingMode="Page" IsPageViewEnabled="True"
                                IsTwoPageViewEnabled="False" IsScrollViewEnabled="True"
                                IsFindEnabled="True"
                                Background="White"/>
        </Border>
        <Border Grid.Row="3" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0"
                Background="White" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mode démo · Vérifier les coordonnées avant tout partage."
                           VerticalAlignment="Center" Foreground="#667085" FontSize="12"
                           Margin="0,0,10,0" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Imprimer" Click="Print_Click"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Padding="19,8" MinHeight="44" Margin="0,0,9,0"/>
                <Button Grid.Column="2" Content="Exporter en PDF" Click="Pdf_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Padding="19,8" MinHeight="44" Margin="0,0,9,0"/>
                <Button Grid.Column="3" Content="Fermer" Click="Close_Click"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Padding="19,8" MinHeight="44"/>
            </Grid>
        </Border>
    </Grid>
</Window>
