<Window x:Class="MuniChien.App.Views.RenewLicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renouveler la licence"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F7F9">

    <Window.Resources>

        <Style x:Key="RenewalLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

        </Style>


        <Style x:Key="RenewalValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

        </Style>


        <Style x:Key="RenewalValueBoxStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="12,9"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Border Background="White"
                BorderBrush="#E4E7EC"
                BorderThickness="1"
                CornerRadius="14"
                Margin="24"
                Padding="26">

            <StackPanel>


                <!-- ==================================================
                     TITRE
                     ================================================== -->

                <TextBlock Text="Renouveler la licence"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>


                <TextBlock Text="Vérifiez les informations avant de confirmer le renouvellement."
                           FontSize="13"
                           Foreground="#667085"
                           Margin="0,6,0,24"/>


                <!-- ==================================================
                     CHIEN / PROPRIÉTAIRE
                     ================================================== -->

                <Grid Margin="0,0,0,12">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Chien"
                                   Style="{StaticResource RenewalLabelStyle}"
                                   Margin="0,0,0,5"/>

                        <Border Style="{StaticResource RenewalValueBoxStyle}">

                            <TextBlock Text="{Binding DogName}"
                                       Style="{StaticResource RenewalValueStyle}"/>

                        </Border>

                    </StackPanel>


                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Propriétaire"
                                   Style="{StaticResource RenewalLabelStyle}"
                                   Margin="0,0,0,5"/>

                        <Border Style="{StaticResource RenewalValueBoxStyle}">

                            <TextBlock Text="{Binding OwnerName}"
                                       Style="{StaticResource RenewalValueStyle}"/>

                        </Border>

                    </StackPanel>

                </Grid>


                <!-- ==================================================
                     LICENCE
                     ================================================== -->

                <TextBlock Text="Licence"
                           Style="{StaticResource RenewalLabelStyle}"
                           Margin="0,0,0,5"/>

                <Border Style="{StaticResource RenewalValueBoxStyle}"
                        Margin="0,0,0,20">

                    <TextBlock Text="{Binding LicenseNumber}"
                               Style="{StaticResource RenewalValueStyle}"/>

                </Border>


                <!-- ==================================================
                     PÉRIODE ACTUELLE
                     ================================================== -->

                <TextBlock Text="Période actuelle"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#242B38"
                           Margin="0,0,0,12"/>


                <Grid Margin="0,0,0,22">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Statut"
                                   Style="{StaticResource RenewalLabelStyle}"
                                   Margin="0,0,0,5"/>

                        <Border Style="{StaticResource RenewalValueBoxStyle}">

                            <TextBlock Text="{Binding CurrentStatus}"
                                        Style="{StaticResource RenewalValueStyle}"/>
                        </Border>

                    </StackPanel>


                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Expiration actuelle"
                                   Style="{StaticResource RenewalLabelStyle}"
                                   Margin="0,0,0,5"/>

                        <Border Style="{StaticResource RenewalValueBoxStyle}">

                            <TextBlock Text="{Binding CurrentExpirationDate}"
                                       Style="{StaticResource RenewalValueStyle}"/>

                        </Border>

                    </StackPanel>

                </Grid>


                <!-- ==================================================
                     NOUVELLE PÉRIODE
                     ================================================== -->

                <TextBlock Text="Nouvelle période"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#242B38"
                           Margin="0,0,0,12"/>


                <Border Background="#FFF8F3"
                        BorderBrush="#F2B98F"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="16">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="16"/>

                            <ColumnDefinition Width="*"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Date de renouvellement"
                                       Style="{StaticResource RenewalLabelStyle}"
                                       Margin="0,0,0,5"/>

                            <TextBlock Text="{Binding RenewalDate}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#242424"/>

                        </StackPanel>


                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Nouvelle expiration"
                                       Style="{StaticResource RenewalLabelStyle}"
                                       Margin="0,0,0,5"/>

                            <TextBlock x:Name="ExpirationDateTextBlock"
                                       Text="{Binding NewExpirationDate, Mode=OneWay}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#E87524"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <TextBlock Text="Par défaut, une licence expire le 31 décembre de l'année du renouvellement."
                           FontSize="12"
                           Foreground="#667085"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"/>

                <Border Background="#FFF8F3"
                        BorderBrush="#F2B98F"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,16,0,0">
                    <StackPanel>
                        <CheckBox x:Name="ExceptionalExtensionCheckBox"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Foreground="#344054"
                                  Checked="ExceptionalExtensionCheckBox_Changed"
                                  Unchecked="ExceptionalExtensionCheckBox_Changed">
                            <TextBlock Text="Prolongation exceptionnelle jusqu'au 31 décembre de l'année suivante"
                                       TextWrapping="Wrap"
                                       MaxWidth="400"/>
                        </CheckBox>
                        <TextBlock Text="À sélectionner uniquement si le refuge autorise expressément cette exception. Aucun prolongement automatique selon la date."
                                   Margin="22,7,0,0"
                                   FontSize="12"
                                   Foreground="#667085"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- ==================================================
                     INFO
                     ================================================== -->

                <Border Background="#F8FAFC"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,20,0,0">

                    <TextBlock FontSize="12"
                               Foreground="#475467"
                               TextWrapping="Wrap">

                        <Run Text="La période actuelle sera conservée dans l'historique avec le statut "/>

                        <Run Text="Renouvelée"
                             FontWeight="SemiBold"/>

                        <Run Text=". La nouvelle période deviendra ensuite la licence active."/>

                    </TextBlock>

                </Border>


                <!-- ==================================================
                     BOUTONS
                     ================================================== -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,26,0,0">

                    <Button Content="Annuler"
                            Click="Cancel_Click"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Margin="0,0,12,0"
                            Padding="18,9"/>


                    <Button Content="Confirmer le renouvellement"
                            Click="Confirm_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Padding="18,9"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</Window>