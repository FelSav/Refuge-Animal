<Window x:Class="MuniChien.App.Views.RenewLicenseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Renouveler et facturer — MuniChien"
        Width="650" Height="750" MinWidth="590" MinHeight="570"
        MaxHeight="850" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F6F7F9">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Renouveler une licence" FontSize="26"
                       FontWeight="SemiBold" Foreground="#242B38" />
            <TextBlock Text="Vérifiez la nouvelle période et confirmez le montant à facturer."
                       FontSize="13" Foreground="#667085" Margin="0,7,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="White" CornerRadius="14" BorderBrush="#E4E7EC"
                        BorderThickness="1" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Dossier concerné" FontSize="17"
                                   FontWeight="SemiBold" Foreground="#242B38"
                                   Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Chien" Foreground="#667085"/>
                                <TextBlock Text="{Binding DogName}" FontSize="15"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Propriétaire" Foreground="#667085"/>
                                <TextBlock Text="{Binding OwnerName}" FontSize="15"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Numéro de licence" Foreground="#667085"/>
                                <TextBlock Text="{Binding LicenseNumber}" FontSize="15"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Expiration actuelle" Foreground="#667085"/>
                                <TextBlock Text="{Binding CurrentExpirationDate}" FontSize="15"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="14" BorderBrush="#E4E7EC"
                        BorderThickness="1" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Nouvelle période" FontSize="17"
                                   FontWeight="SemiBold" Foreground="#242B38" Margin="0,0,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Année de couverture" Foreground="#667085"/>
                                <TextBlock Text="{Binding CoverageYear}" FontSize="16"
                                           FontWeight="SemiBold" Foreground="#E87524"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nouvelle expiration" Foreground="#667085"/>
                                <TextBlock x:Name="ExpirationDateTextBlock" FontSize="16"
                                           FontWeight="SemiBold" Foreground="#E87524"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Date d'enregistrement :" Foreground="#667085"
                                   Margin="0,15,0,4"/>
                        <TextBlock Text="{Binding RenewalDate}" FontWeight="SemiBold"/>
                        <Border Background="#FFF8F2" BorderBrush="#F2C8A7"
                                BorderThickness="1" CornerRadius="10" Padding="13"
                                Margin="0,18,0,0">
                            <StackPanel>
                                <CheckBox x:Name="ExceptionalExtensionCheckBox"
                                          Checked="ExceptionalExtensionCheckBox_Changed"
                                          Unchecked="ExceptionalExtensionCheckBox_Changed">
                                    <TextBlock Text="Prolongation exceptionnelle approuvée par le refuge"
                                               TextWrapping="Wrap" FontWeight="SemiBold"/>
                                </CheckBox>
                                <TextBlock Text="Repousse l'expiration d'une année supplémentaire sur autorisation expresse. Ne facture pas une deuxième fois."
                                           Foreground="#667085" FontSize="12"
                                           Margin="22,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="14" BorderBrush="#E4E7EC"
                        BorderThickness="1" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Facturation du renouvellement"
                                   FontSize="17" FontWeight="SemiBold" Foreground="#242B38"/>
                        <TextBlock Text="Montant à ajouter au compte du propriétaire ($ CAD)"
                                   Foreground="#344054" Margin="0,14,0,6"/>
                        <TextBox x:Name="AmountTextBox" Height="44"
                                 Padding="12,6" VerticalContentAlignment="Center" FontSize="15"/>
                        <TextBlock Text="Tarif saisi manuellement — aucun prix municipal n'est appliqué automatiquement."
                                   Foreground="#667085" FontSize="12"
                                   TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
            <Button Content="Confirmer et facturer" Click="Confirm_Click"
                    Style="{StaticResource PrimaryActionButtonStyle}"
                    DockPanel.Dock="Right" MinWidth="190" Height="46"
                    Padding="15,6"/>
            <Button Content="Annuler" Click="Cancel_Click"
                    Style="{StaticResource SecondaryActionButtonStyle}"
                    DockPanel.Dock="Right" Margin="0,0,12,0"
                    MinWidth="110" Height="46" Padding="15,6"/>
        </DockPanel>
    </Grid>
</Window>
