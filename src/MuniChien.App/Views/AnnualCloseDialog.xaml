<Window x:Class="MuniChien.App.Views.AnnualCloseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fermeture annuelle"
        Width="620"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F7F9">

    <Window.Resources>

        <Style x:Key="AnnualLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

        </Style>

    </Window.Resources>


    <Border Background="White"
            BorderBrush="#E4E7EC"
            BorderThickness="1"
            CornerRadius="14"
            Margin="24"
            Padding="26">

        <StackPanel>

            <!-- ==================================================
                 TITRE
                 ================================================== -->

            <TextBlock Text="Fermeture annuelle"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="#B42318"/>


            <TextBlock Text="Cette opération est sensible. Vérifiez les informations avant de continuer."
                       Margin="0,6,0,22"
                       FontSize="13"
                       Foreground="#667085"
                       TextWrapping="Wrap"/>


            <!-- ==================================================
                 ÉTAPE 1
                 ================================================== -->

            <Border Background="#F8FAFC"
                    BorderBrush="#E4E7EC"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="1. Vérification"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#242B38"/>


                    <Grid Margin="0,14,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Text="Année actuelle"
                                   Style="{StaticResource AnnualLabelStyle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentYear}"
                                   Foreground="#242B38"/>

                    </Grid>


                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Text="Nouvelle année"
                                   Style="{StaticResource AnnualLabelStyle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding NextYear}"
                                   FontWeight="SemiBold"
                                   Foreground="#242B38"/>

                    </Grid>


                    <Grid Margin="0,10,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>


                        <TextBlock Text="Dernière sauvegarde"
                                   Style="{StaticResource AnnualLabelStyle}"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding LastBackup}"
                                   Foreground="#242B38"/>

                    </Grid>

                </StackPanel>

            </Border>


            <!-- ==================================================
                 ÉTAPE 2
                 ================================================== -->

            <Border Background="#FFF8F3"
                    BorderBrush="#F2B98F"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16"
                    Margin="0,0,0,12">

                <StackPanel>

                    <TextBlock Text="2. Sauvegarde préalable"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#242B38"/>


                    <TextBlock Text="Une nouvelle sauvegarde sera automatiquement créée avant la fermeture annuelle."
                               Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="#667085"
                               TextWrapping="Wrap"/>

                </StackPanel>

            </Border>


            <!-- ==================================================
                 ÉTAPE 3
                 ================================================== -->

            <Border Background="#FFF7F6"
                    BorderBrush="#FDA29B"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">

                <StackPanel>

                    <TextBlock Text="3. Confirmation"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#B42318"/>


                    <TextBlock Text="La logique métier réelle de la fermeture annuelle n'est pas encore connectée. Cette version exécutera uniquement une simulation sécurisée."
                               Margin="0,7,0,12"
                               FontSize="12"
                               Foreground="#667085"
                               TextWrapping="Wrap"/>


                    <CheckBox x:Name="ConfirmationCheckBox"
                              Content="Je comprends qu'il s'agit d'une opération administrative sensible."
                              FontSize="12"
                              Foreground="#344054"
                              Checked="ConfirmationCheckBox_Changed"
                              Unchecked="ConfirmationCheckBox_Changed"/>

                </StackPanel>

            </Border>


            <!-- ==================================================
                 ACTIONS
                 ================================================== -->

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">

                <Button Content="Annuler"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Padding="18,9"
                        Margin="0,0,12,0"/>


                <Button x:Name="ConfirmButton"
                        Content="Confirmer la fermeture"
                        Click="Confirm_Click"
                        IsEnabled="False"
                        Padding="18,9"
                        FontWeight="SemiBold"
                        Background="#D92D20"
                        Foreground="White"
                        BorderBrush="#B42318"/>

            </StackPanel>

        </StackPanel>

    </Border>

</Window>