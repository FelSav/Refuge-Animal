<Window x:Class="MuniChien.App.Views.LoyaltyPurchaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Achat de fidélité — MuniChien"
        Width="650" Height="720" MinWidth="550" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F5F6F9"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="EntryTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#202A36"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#E87520"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="BorderBrush" Value="#CCD3DE"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="25,20">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Enregistrer un sac" FontSize="23" FontWeight="SemiBold" Foreground="#242B38"/>
                <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#667085" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="25,20,25,22">
                <Border Background="#FFF3E9" BorderBrush="#FFD8B4" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,18">
                    <TextBlock Text="Une case = un sac réellement acheté. Indiquez le produit et son format exacts : ils serviront à choisir le 13e sac gratuit." Foreground="#914412" FontSize="12" TextWrapping="Wrap"/>
                </Border>
                <TextBlock Text="Nom exact du sac *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="ProductNameBox" Style="{StaticResource EntryTextBox}" MaxLength="160" Margin="0,0,0,15"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Référence SKU / CUP *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="ReferenceBox" Style="{StaticResource EntryTextBox}" MaxLength="90"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Format exact (ex. : 10 kg) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="FormatBox" Style="{StaticResource EntryTextBox}" MaxLength="80"/>
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Prix réellement payé ($) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="PriceBox" Style="{StaticResource EntryTextBox}" MaxLength="16"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Date d'achat *" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="PurchaseDatePicker" SelectedDateFormat="Short" Height="42" FontSize="14"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Numéro de facture (si disponible)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="InvoiceBox" Style="{StaticResource EntryTextBox}" MaxLength="100" Margin="0,0,0,6"/>
                <TextBlock Text="Facultatif pour la reprise des anciennes cartes papier." FontSize="11" Foreground="#667085" Margin="0,0,0,17"/>
                <TextBlock Text="Justificatif (image facultative)" Style="{StaticResource FieldLabel}"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="AttachmentText" Text="Aucun justificatif sélectionné" TextTrimming="CharacterEllipsis"
                               Foreground="#667085" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Aucun fichier"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BrowseButton" Content="Choisir une image" Style="{StaticResource SecondaryButton}" Click="Browse_Click"/>
                        <Button x:Name="OpenAttachmentButton" Content="Voir" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="OpenAttachment_Click"/>
                        <Button x:Name="ClearAttachmentButton" Content="Retirer" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Click="ClearAttachment_Click"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Mode démo : seul le chemin de l'image est conservé pendant cette session; ne déplacez pas le fichier."
                           FontSize="11" Foreground="#667085" TextWrapping="Wrap" Margin="0,9,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,1,0,0" Padding="25,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Content="Supprimer cet achat" Grid.Column="0" Style="{StaticResource SecondaryButton}"
                        Foreground="#B42318" Click="Delete_Click" Visibility="Collapsed"/>
                <Button Grid.Column="2" Content="Annuler" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Grid.Column="3" Content="Enregistrer l'achat" Style="{StaticResource ActionButton}" Click="Save_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
