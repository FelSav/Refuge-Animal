<UserControl x:Class="MuniChien.App.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ==================================================
             CARTE RAPPORT
             ================================================== -->

        <Style x:Key="ReportCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="20"/>

        </Style>


        <!-- ==================================================
             TITRE SECTION
             ================================================== -->

        <Style x:Key="ReportSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="19"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <!-- ==================================================
             TITRE CARTE
             ================================================== -->

        <Style x:Key="ReportCardTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <!-- ==================================================
             DESCRIPTION CARTE
             ================================================== -->

        <Style x:Key="ReportCardDescriptionStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

        </Style>


        <!-- ==================================================
             CARTE DÉSACTIVÉE
             ================================================== -->

        <Style x:Key="DisabledReportCardStyle"
               TargetType="Border"
               BasedOn="{StaticResource ReportCardStyle}">

            <Setter Property="Opacity"
                    Value="0.62"/>

            <Setter Property="Background"
                    Value="#FAFAFA"/>

        </Style>


        <!-- ==================================================
             BADGE À VENIR
             ================================================== -->

        <Style x:Key="ComingSoonBadgeStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F2F4F7"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="Padding"
                    Value="8,3"/>

            <Setter Property="HorizontalAlignment"
                    Value="Left"/>

        </Style>

    </UserControl.Resources>


    <Grid Background="#F6F7F9">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,36,52,44">


                <!-- ==================================================
                     ENTÊTE
                     ================================================== -->

                <TextBlock Text="Rapports"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>


                <TextBlock Text="Générez, consultez et exportez les rapports de MuniChien."
                           FontSize="14"
                           Foreground="#667085"
                           Margin="0,7,0,24"/>


                <!-- Les filtres sont propres à chaque rapport : aucun réglage global ambigu. -->
                <Border Background="#FFF7F0" BorderBrush="#F5DDCA"
                        BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Un rapport sur mesure, en quelques clics"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#96501F"/>
                        <TextBlock Text="Cliquez sur « Filtrer et générer » : choisissez la municipalité, les critères propres au rapport et l'ordre des résultats. Sans filtre, vous obtenez le rapport complet."
                                   Margin="0,5,0,0" FontSize="12" Foreground="#96501F" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- ==================================================
                     APERÇU FINANCIER
                     ================================================== -->
                <Border Background="#FFF7F0" BorderBrush="#F5DDCA"
                        BorderThickness="1" CornerRadius="13" Padding="18"
                        Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Données financières locales de démonstration"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#90471B"/>
                        <TextBlock Text="Totaux généraux de démonstration, toutes municipalités et toutes dates. Les filtres s’appliquent aux rapports générés, pas à ces indicateurs."
                                   Foreground="#975F40" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,4,0,14"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="White" CornerRadius="10"
                                    Padding="15,12">
                                <StackPanel>
                                    <TextBlock Text="Paiements enregistrés" FontSize="12" Foreground="#667085"/>
                                    <TextBlock Text="{Binding FinancialReceived}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="#242B38" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="White" CornerRadius="10"
                                    Padding="15,12">
                                <StackPanel>
                                    <TextBlock Text="Soldes à recevoir" FontSize="12" Foreground="#667085"/>
                                    <TextBlock Text="{Binding FinancialOutstanding}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="#242B38" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Background="White" CornerRadius="10"
                                    Padding="15,12">
                                <StackPanel>
                                    <TextBlock Text="Frais de retard inscrits" FontSize="12" Foreground="#667085"/>
                                    <TextBlock Text="{Binding FinancialLateFees}" FontSize="21" FontWeight="SemiBold"
                                               Foreground="#242B38" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================================================
                     LISTES
                     ================================================== -->

                <TextBlock Text="Listes"
                           Style="{StaticResource ReportSectionTitleStyle}"
                           Margin="0,0,0,14"/>


                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- CHIENS -->

                    <Border Grid.Column="0"
                            Style="{StaticResource ReportCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Chiens"
                                       Style="{StaticResource ReportCardTitleStyle}"/>


                            <TextBlock Text="Répertoire des chiens avec leur client, leur race et leur licence éventuelle."
                                       Style="{StaticResource ReportCardDescriptionStyle}"
                                       Margin="0,7,0,18"
                                       MinHeight="46"/>


                            <Button Content="Filtrer et générer"
                                    Command="{Binding GenerateDogsReportCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="15,8"/>

                        </StackPanel>

                    </Border>


                    <!-- PROPRIÉTAIRES -->

                    <Border Grid.Column="2"
                            Style="{StaticResource ReportCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Clients"
                                       Style="{StaticResource ReportCardTitleStyle}"/>


                            <TextBlock Text="Répertoire des clients, avec ou sans chien, et leurs licences associées."
                                       Style="{StaticResource ReportCardDescriptionStyle}"
                                       Margin="0,7,0,18"
                                       MinHeight="46"/>


                            <Button Content="Filtrer et générer"
                                    Command="{Binding GenerateOwnersReportCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="15,8"/>

                        </StackPanel>

                    </Border>


                    <!-- SOLDES IMPAYÉS -->

                    <Border Grid.Column="4"
                            Style="{StaticResource ReportCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Soldes impayés"
                                       Style="{StaticResource ReportCardTitleStyle}"/>


                            <TextBlock Text="Dossiers contenant encore un solde à payer."
                                       Style="{StaticResource ReportCardDescriptionStyle}"
                                       Margin="0,7,0,18"
                                       MinHeight="46"/>


                            <Button Content="Filtrer et générer"
                                    Command="{Binding GenerateBalancesReportCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="15,8"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- DEUXIÈME LIGNE LISTES -->

                <Grid Margin="0,16,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- FRAIS DE RETARD -->

                    <Border Grid.Column="0"
                            Style="{StaticResource ReportCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Frais de retard"
                                       Style="{StaticResource ReportCardTitleStyle}"/>


                            <TextBlock Text="Dossiers comportant des frais ou pénalités de retard."
                                       Style="{StaticResource ReportCardDescriptionStyle}"
                                       Margin="0,7,0,18"
                                       MinHeight="46"/>


                            <Button Content="Filtrer et générer"
                                    Command="{Binding GenerateLateFeesReportCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="15,8"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     FINANCES
                     ================================================== -->

                <TextBlock Text="Finances"
                           Style="{StaticResource ReportSectionTitleStyle}"
                           Margin="0,30,0,14"/>


                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- PAIEMENTS -->

                    <Border Grid.Column="0"
                            Style="{StaticResource ReportCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Paiements"
                                       Style="{StaticResource ReportCardTitleStyle}"/>


                            <TextBlock Text="Historique complet des paiements enregistrés."
                                       Style="{StaticResource ReportCardDescriptionStyle}"
                                       Margin="0,7,0,18"
                                       MinHeight="46"/>


                            <Button Content="Filtrer et générer"
                                    Command="{Binding GeneratePaymentsReportCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="15,8"/>

                        </StackPanel>

                    </Border>


                    <!-- REVENUS -->

                    <Border Grid.Column="2"
                            Style="{StaticResource ReportCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Revenus"
                                       Style="{StaticResource ReportCardTitleStyle}"/>


                            <TextBlock Text="Sommaire des revenus selon une période sélectionnée."
                                       Style="{StaticResource ReportCardDescriptionStyle}"
                                       Margin="0,7,0,18"
                                       MinHeight="46"/>


                            <Button Content="Filtrer et générer"
                                    Command="{Binding GenerateRevenueReportCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="15,8"/>

                        </StackPanel>

                    </Border>


                    <!-- JOURNALIERS -->

                    <Border Grid.Column="4"
                            Style="{StaticResource ReportCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Paiements journaliers"
                                       Style="{StaticResource ReportCardTitleStyle}"/>


                            <TextBlock Text="Transactions d’une journée choisie dans les paramètres."
                                       Style="{StaticResource ReportCardDescriptionStyle}"
                                       Margin="0,7,0,18"
                                       MinHeight="46"/>


                            <Button Content="Filtrer et générer"
                                    Command="{Binding GenerateDailyPaymentsReportCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="15,8"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     STATISTIQUES
                     ================================================== -->

                <TextBlock Text="Statistiques"
                           Style="{StaticResource ReportSectionTitleStyle}"
                           Margin="0,30,0,14"/>


                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- RACES -->

                    <Border Grid.Column="0"
                            Style="{StaticResource ReportCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Chiens par race"
                                       Style="{StaticResource ReportCardTitleStyle}"/>


                            <TextBlock Text="Répartition du nombre de chiens selon leur race."
                                       Style="{StaticResource ReportCardDescriptionStyle}"
                                       Margin="0,7,0,18"
                                       MinHeight="46"/>


                            <Button Content="Filtrer et générer"
                                    Command="{Binding GenerateBreedReportCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="15,8"/>

                        </StackPanel>

                    </Border>


                    <!-- LICENCES -->

                    <Border Grid.Column="2"
                            Style="{StaticResource ReportCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Licences"
                                       Style="{StaticResource ReportCardTitleStyle}"/>


                            <TextBlock Text="Rapport des licences avec expiration, statut et municipalité."
                                       Style="{StaticResource ReportCardDescriptionStyle}"
                                       Margin="0,7,0,18"
                                       MinHeight="46"/>


                            <Button Content="Filtrer et générer"
                                    Command="{Binding GenerateLicensesReportCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="15,8"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>