<UserControl x:Class="MuniChien.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>


    <Grid x:Name="RootGrid"
          Background="#F6F7F9"
          AllowDrop="True"
          DragOver="DashboardRoot_DragOver"
          Drop="DashboardRoot_Drop">


        <!-- ==================================================
             CONTENU PRINCIPAL
             ================================================== -->

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="56,38">


                <!-- En-tête -->
                <TextBlock Text="Bienvenue dans MuniChien"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>

                <TextBlock Text="Gestion des propriétaires, chiens, licences et paiements"
                           Margin="0,8,0,28"
                           FontSize="14"
                           Foreground="#242424"/>


                <!-- Bouton de personnalisation -->
                <Grid Margin="0,0,8,10">

                    <Button Content="Personnaliser"
                            HorizontalAlignment="Right"
                            Command="{Binding OpenCustomizationCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Padding="14,7"
                            FontSize="13"/>

                </Grid>


                <!-- ==================================================
                     CARTES DE STATISTIQUES
                     ================================================== -->

                <ItemsControl ItemsSource="{Binding DashboardCards}"
                              Margin="0,0,0,48">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>

                            <UniformGrid Columns="4"/>

                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource DashboardCardStyle}"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="DashboardCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DashboardCard_PreviewMouseMove"
                                    DragEnter="DashboardCard_DragEnter">

                                <StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#657086"/>

                                    <TextBlock Text="{Binding Value}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- ==================================================
                     ACTIONS RAPIDES
                     ================================================== -->

                <TextBlock Text="Actions rapides"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#242B38"
                           Margin="0,0,0,28"/>

                <StackPanel Orientation="Horizontal">

                    <Button Content="Rechercher un dossier"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Margin="24,0,120,0"/>

                    <Button Content="Rechercher un propriétaire"
                            Style="{StaticResource SecondaryActionButtonStyle}"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>


        <!-- ==================================================
             PANNEAU DE PERSONNALISATION
             ================================================== -->

        <Grid Background="#99000000"
              Visibility="{Binding IsCustomizationOpen,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="580"
                    MaxHeight="700"
                    Background="White"
                    CornerRadius="10"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>


                        <!-- ==================================================
                             TITRE
                             ================================================== -->

                        <Grid Margin="0,0,0,24">

                            <TextBlock Text="Personnaliser le tableau de bord"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#242424"/>

                            <Button Content="✕"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseCustomizationCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="18"
                                    Cursor="Hand"/>

                        </Grid>


                        <!-- ==================================================
                             REMPLACER UNE CARTE
                             ================================================== -->

                        <TextBlock Text="Remplacer une carte"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Choisissez d'abord l'emplacement du tableau de bord à modifier."
                                   FontSize="13"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>


                        <TextBlock Text="Carte à remplacer"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding DashboardCards}"
                                  SelectedItem="{Binding SelectedCard}"
                                  DisplayMemberPath="Title"
                                  Height="38"
                                  Padding="10,4"
                                  Margin="0,0,0,16"/>


                        <TextBlock Text="Statistique à utiliser"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding AvailableReplacementMetrics}"
                                  SelectedItem="{Binding SelectedMetric}"
                                  DisplayMemberPath="Title"
                                  Height="38"
                                  Padding="10,4"
                                  Margin="0,0,0,12"/>

                        <Button Content="Utiliser cette statistique"
                                Command="{Binding ReplaceWithMetricCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                HorizontalAlignment="Left"/>


                        <!-- Séparateur -->
                        <Border Height="1"
                                Background="#DDDDDD"
                                Margin="0,28"/>


                        <!-- ==================================================
                             CRÉER UNE STATISTIQUE PERSONNALISÉE
                             ================================================== -->

                        <TextBlock Text="Créer une statistique personnalisée"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Ajoutez une donnée manuelle aux choix disponibles sans modifier immédiatement le tableau de bord."
                                   FontSize="13"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>


                        <TextBlock Text="Nom de la statistique"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding ManualCardTitle,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="14"
                                 Margin="0,0,0,14"/>


                        <TextBlock Text="Valeur"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding ManualCardValue,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="14"
                                 Margin="0,0,0,12"/>

                        <Button Content="Ajouter aux choix"
                                Command="{Binding CreateManualMetricCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                HorizontalAlignment="Left"/>


                        <!-- Séparateur -->
                        <Border Height="1"
                                Background="#DDDDDD"
                                Margin="0,28"/>


                        <!-- ==================================================
                             GÉRER LES STATISTIQUES PERSONNALISÉES
                             ================================================== -->

                        <TextBlock Text="Gérer mes statistiques personnalisées"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Modifiez ou supprimez une statistique personnalisée déjà créée."
                                   FontSize="13"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>


                        <TextBlock Text="Statistique"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding CustomMetrics}"
                                  SelectedItem="{Binding SelectedCustomMetric}"
                                  DisplayMemberPath="Title"
                                  Height="38"
                                  Padding="10,4"
                                  Margin="0,0,0,14"/>


                        <TextBlock Text="Nom"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding EditCustomMetricTitle,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="14"
                                 Margin="0,0,0,14"/>


                        <TextBlock Text="Valeur"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding EditCustomMetricValue,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="14"
                                 Margin="0,0,0,14"/>


                        <StackPanel Orientation="Horizontal">

                            <Button Content="Enregistrer les modifications"
                                    Command="{Binding UpdateManualMetricCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0,0,12,0"/>

                            <Button Content="Supprimer"
                                    Command="{Binding DeleteManualMetricCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"/>

                        </StackPanel>


                        <!-- ==================================================
                             MESSAGE
                             ================================================== -->

                        <TextBlock Text="{Binding CustomizationMessage}"
                                   Foreground="#E87524"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,22,0,0"/>


                        <!-- ==================================================
                             FERMER
                             ================================================== -->

                        <Button Content="Fermer"
                                Command="{Binding CloseCustomizationCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="0,28,0,0"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>