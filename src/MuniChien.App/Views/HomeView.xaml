<UserControl x:Class="MuniChien.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Tuile légère pour les raccourcis de l'accueil. -->
        <Style x:Key="QuickActionTileStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E5EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#E87524"/>
                                <Setter TargetName="Tile" Property="Background" Value="#FFF9F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#FFF0E2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Styles locaux : cette refonte n'affecte aucune autre page. -->
        <Style x:Key="CustomizationFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="CustomizationInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#242B38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DBE1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#E87524"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="InputBorder" Property="Background" Value="#F4F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomizationComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#242B38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DBE1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="CustomizationPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Background" Value="#E87524"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D4671A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#BC5713"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomizationSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#DBE1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#FFF7F0"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E8B78F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#FCE9D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomizationTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#FFF9F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#BA5616"/>
                                <Setter TargetName="TabSurface" Property="Background" Value="#FFF0E2"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#F5D8BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomizationTabsStyle" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource CustomizationTabItemStyle}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="12" Background="#F4F5F7"
                                    Padding="4" HorizontalAlignment="Left" Margin="0,0,0,17">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>


    <Grid x:Name="RootGrid"
          Background="#F6F7F9"
          AllowDrop="True"
          DragOver="DashboardRoot_DragOver"
          Drop="DashboardRoot_Drop">


        <!-- ==================================================
             CONTENU PRINCIPAL
             ================================================== -->

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="56,38">


                <!-- En-tête -->
                <TextBlock Text="Bienvenue dans MuniChien"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>

                <TextBlock Text="Gestion des propriétaires, chiens, licences et paiements"
                           Margin="0,8,0,28"
                           FontSize="14"
                           Foreground="#242424"/>


                <!-- Statistiques locales : aucune valeur officielle de la BD / API. -->
                <Border Background="#FFF9F3"
                        BorderBrush="#F5D7BC"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="12,9"
                        Margin="0,0,0,16">
                    <TextBlock Text="Données locales de démonstration — Les véritables avis à envoyer ne peuvent pas encore être calculés par année."
                               FontSize="12"
                               Foreground="#935016"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Actualisation et personnalisation -->
                <Grid Margin="0,0,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding LastUpdatedDisplay, Mode=OneWay}"
                               FontSize="12"
                               Foreground="#667085"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Actualiser"
                            Command="{Binding RefreshStatisticsCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Padding="14,7"
                            FontSize="13"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="2"
                            Content="Personnaliser"
                            Command="{Binding OpenCustomizationCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Padding="14,7"
                            FontSize="13"/>
                </Grid>


                <!-- ==================================================
                     CARTES DE STATISTIQUES
                     ================================================== -->

                <ItemsControl x:Name="DashboardItemsControl"
                    ItemsSource="{Binding DashboardCards}"
                    Margin="0,0,0,48">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>

                            <UniformGrid Columns="4"/>

                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource DashboardCardStyle}"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="DashboardCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DashboardCard_PreviewMouseMove"
                                    DragEnter="DashboardCard_DragEnter">

                                <StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#657086"/>

                                    <TextBlock Text="{Binding Value}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- ==================================================
                     ACTIONS RAPIDES : 6 MODULES ACCESSIBLES
                     ================================================== -->

                <TextBlock Text="Accès rapides"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#242B38"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Ouvrez directement un module de MuniChien."
                           FontSize="13"
                           Foreground="#667085"
                           Margin="0,0,0,17"/>

                <UniformGrid Columns="3" Rows="2">

                    <!-- RECHERCHE -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenSearchQuickCommand}"
                            Margin="0,0,12,12" MinHeight="128"
                            ToolTip="Rechercher des dossiers, chiens et licences">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Recherche" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Trouver un dossier" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- PROPRIÉTAIRES -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenOwnersQuickCommand}"
                            Margin="0,0,12,12" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Propriétaires" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Consulter les dossiers" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- CHIENS -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenDogsQuickCommand}"
                            Margin="0,0,0,12" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chiens" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Voir les fiches" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- LICENCES -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenLicensesQuickCommand}"
                            Margin="0,0,12,0" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Licences" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Suivre les renouvellements" FontSize="12" Foreground="#667085" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- PAIEMENTS -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenPaymentsQuickCommand}"
                            Margin="0,0,12,0" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Paiements" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Comptes et reçus" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- AVIS -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenNoticesQuickCommand}"
                            Margin="0,0,0,0" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Avis" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Préparer les rappels" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>
            </StackPanel>

        </ScrollViewer>


        <!-- ==================================================
             PERSONNALISATION DU TABLEAU DE BORD
             Deux onglets, sans modifier les commandes ni la sauvegarde.
             ================================================== -->

        <Grid Background="#9918222D"
              Visibility="{Binding IsCustomizationOpen,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="856"
                    MaxHeight="700"
                    Margin="18"
                    Background="#FFFFFF"
                    CornerRadius="18"
                    Padding="28,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#142033" BlurRadius="32"
                                      ShadowDepth="8" Opacity="0.20"/>
                </Border.Effect>

                <!-- Défilement uniquement si la taille de la fenêtre le nécessite. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              PanningMode="VerticalOnly">
                    <StackPanel>

                        <!-- En-tête -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Personnaliser mon accueil"
                                           FontSize="23" FontWeight="SemiBold"
                                           Foreground="#242B38"/>
                                <TextBlock Text="Choisissez les chiffres qui comptent pour vous."
                                           FontSize="13" Foreground="#667085"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Width="36" Height="36"
                                    Content="&#xE8BB;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="13"
                                    Padding="0"
                                    ToolTip="Fermer la personnalisation"
                                    Command="{Binding CloseCustomizationCommand}"
                                    Style="{StaticResource CustomizationSecondaryButtonStyle}"/>
                        </Grid>

                        <!-- Petit conseil : décrire sans encombrer l'interface. -->
                        <Border CornerRadius="11" Background="#FFF6EC"
                                BorderBrush="#F8E2CA" BorderThickness="1"
                                Padding="13,10" Margin="0,0,0,19">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="#C8661E"
                                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Text="Astuce : vous pouvez aussi réorganiser les cartes directement sur l'accueil par glisser-déposer."
                                           FontSize="12" Foreground="#895328"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TabControl Style="{StaticResource CustomizationTabsStyle}"
                                    SelectedIndex="0">

                            <!-- ===========================================
                                 ONGLET 1 — REMPLACER UNE CARTE
                                 =========================================== -->
                            <TabItem Header="Remplacer une carte">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Carte à remplacer -->
                                    <Border Grid.Column="0"
                                            Background="#FAFBFC" CornerRadius="14"
                                            BorderBrush="#E7EAF0" BorderThickness="1"
                                            Padding="18,19">
                                        <StackPanel>
                                            <TextBlock Text="01  Choisir une carte"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#242B38"/>
                                            <TextBlock Text="Sélectionnez l'emplacement à modifier."
                                                       FontSize="12" Foreground="#667085"
                                                       Margin="0,6,0,20" TextWrapping="Wrap"/>

                                            <TextBlock Text="Carte actuelle"
                                                       Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding DashboardCards}"
                                                      SelectedItem="{Binding SelectedCard}"
                                                      DisplayMemberPath="Title"
                                                      Style="{StaticResource CustomizationComboStyle}"
                                                      Margin="0,0,0,18"/>

                                            <Border Background="White" CornerRadius="12"
                                                    BorderBrush="#E6E8EC" BorderThickness="1"
                                                    Padding="16,14">
                                                <StackPanel>
                                                    <TextBlock Text="APERÇU ACTUEL"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="#9AA3B2"/>
                                                    <TextBlock Text="{Binding SelectedCard.Title, TargetNullValue=Aucune carte sélectionnée}"
                                                               FontSize="13" Foreground="#667085"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,12,0,3"/>
                                                    <TextBlock Text="{Binding SelectedCard.Value}"
                                                               FontSize="26" FontWeight="SemiBold"
                                                               Foreground="#242B38"
                                                               HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Statistique de remplacement -->
                                    <Border Grid.Column="2"
                                            Background="#FAFBFC" CornerRadius="14"
                                            BorderBrush="#E7EAF0" BorderThickness="1"
                                            Padding="18,19">
                                        <StackPanel>
                                            <TextBlock Text="02  Choisir une statistique"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#242B38"/>
                                            <TextBlock Text="Choisissez la donnée à afficher à sa place."
                                                       FontSize="12" Foreground="#667085"
                                                       Margin="0,6,0,20" TextWrapping="Wrap"/>

                                            <TextBlock Text="Nouvelle statistique"
                                                       Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding AvailableReplacementMetrics}"
                                                      SelectedItem="{Binding SelectedMetric}"
                                                      DisplayMemberPath="Title"
                                                      Style="{StaticResource CustomizationComboStyle}"
                                                      Margin="0,0,0,16"/>

                                            <TextBlock Text="Les données automatiques proviennent des dossiers locaux. Vous pouvez aussi utiliser vos propres statistiques."
                                                       FontSize="12" Foreground="#667085"
                                                       TextWrapping="Wrap" Margin="0,0,0,18"/>
                                            <Button Content="Appliquer à cette carte"
                                                    Command="{Binding ReplaceWithMetricCommand}"
                                                    Style="{StaticResource CustomizationPrimaryButtonStyle}"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <!-- ===========================================
                                 ONGLET 2 — STATISTIQUES PERSONNALISÉES
                                 =========================================== -->
                            <TabItem Header="Mes statistiques">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Ajouter une statistique -->
                                    <Border Grid.Column="0" CornerRadius="14"
                                            Background="#FAFBFC"
                                            BorderBrush="#E7EAF0" BorderThickness="1"
                                            Padding="18,19">
                                        <StackPanel>
                                            <TextBlock Text="Créer une statistique"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#242B38"/>
                                            <TextBlock Text="Ajoutez une valeur manuelle à votre catalogue."
                                                       FontSize="12" Foreground="#667085"
                                                       Margin="0,6,0,17" TextWrapping="Wrap"/>

                                            <TextBlock Text="Nom de la statistique"
                                                       Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                            <TextBox Text="{Binding ManualCardTitle, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource CustomizationInputStyle}"
                                                     Margin="0,0,0,15"/>

                                            <TextBlock Text="Valeur"
                                                       Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                            <TextBox Text="{Binding ManualCardValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource CustomizationInputStyle}"
                                                     Margin="0,0,0,17"/>

                                            <Button Content="Ajouter aux choix"
                                                    Command="{Binding CreateManualMetricCommand}"
                                                    Style="{StaticResource CustomizationPrimaryButtonStyle}"
                                                    HorizontalAlignment="Left"/>
                                            <TextBlock Text="Après l'ajout, utilisez l'onglet « Remplacer une carte » pour l'afficher sur l'accueil."
                                                       Foreground="#667085" FontSize="11"
                                                       Margin="0,15,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Modifier / supprimer une statistique -->
                                    <Border Grid.Column="2" CornerRadius="14"
                                            Background="#FAFBFC"
                                            BorderBrush="#E7EAF0" BorderThickness="1"
                                            Padding="18,19">
                                        <StackPanel>
                                            <TextBlock Text="Gérer mes statistiques"
                                                       FontSize="16" FontWeight="SemiBold"
                                                       Foreground="#242B38"/>
                                            <TextBlock Text="Modifiez ou supprimez une valeur enregistrée."
                                                       FontSize="12" Foreground="#667085"
                                                       Margin="0,6,0,17" TextWrapping="Wrap"/>

                                            <TextBlock Text="Statistique enregistrée"
                                                       Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                            <ComboBox ItemsSource="{Binding CustomMetrics}"
                                                      SelectedItem="{Binding SelectedCustomMetric}"
                                                      DisplayMemberPath="Title"
                                                      Style="{StaticResource CustomizationComboStyle}"
                                                      Margin="0,0,0,13"/>

                                            <TextBlock Text="Nom"
                                                       Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                            <TextBox Text="{Binding EditCustomMetricTitle, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource CustomizationInputStyle}"
                                                     Margin="0,0,0,13"/>

                                            <TextBlock Text="Valeur"
                                                       Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                            <TextBox Text="{Binding EditCustomMetricValue, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource CustomizationInputStyle}"
                                                     Margin="0,0,0,16"/>

                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Enregistrer"
                                                        Command="{Binding UpdateManualMetricCommand}"
                                                        Style="{StaticResource CustomizationPrimaryButtonStyle}"
                                                        Margin="0,0,9,0"/>
                                                <Button Content="Supprimer"
                                                        Foreground="#B0473D"
                                                        Command="{Binding DeleteManualMetricCommand}"
                                                        Style="{StaticResource CustomizationSecondaryButtonStyle}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                        </TabControl>

                        <!-- Message de validation / d'erreur des commandes existantes. -->
                        <Border Background="#FFF4E8" CornerRadius="10" Padding="13,10"
                                Margin="0,15,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CustomizationMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CustomizationMessage}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#AA561A" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Pied de fenêtre compact -->
                        <Grid Margin="0,19,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Les changements sont enregistrés automatiquement."
                                       FontSize="12" Foreground="#8993A3"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="Terminer"
                                    Command="{Binding CloseCustomizationCommand}"
                                    Style="{StaticResource CustomizationSecondaryButtonStyle}"/>
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>

</UserControl>