<UserControl x:Class="MuniChien.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#F6F7F9">

        <!-- Contenu principal -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="56,38">

                <TextBlock Text="Bienvenue dans MuniChien"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>

                <TextBlock Text="Gestion des propriétaires, chiens, licences et paiements"
                           Margin="0,8,0,28"
                           FontSize="14"
                           Foreground="#242424"/>

                <!-- Bouton de personnalisation -->
                <Grid Margin="0,0,8,10">

                    <Button Content="Personnaliser"
                            HorizontalAlignment="Right"
                            Command="{Binding OpenCustomizationCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Padding="14,7"
                            FontSize="13"/>

                </Grid>

                <!-- Statistiques -->
                <ItemsControl ItemsSource="{Binding DashboardCards}"
                              Margin="0,0,0,48">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource DashboardCardStyle}"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="DashboardCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DashboardCard_PreviewMouseMove"
                                    DragOver="DashboardCard_DragOver"
                                    Drop="DashboardCard_Drop">

                                <StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#657086"/>

                                    <TextBlock Text="{Binding Value}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

                <!-- Actions rapides -->
                <TextBlock Text="Actions rapides"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#242B38"
                           Margin="0,0,0,28"/>

                <StackPanel Orientation="Horizontal">

                    <Button Content="Rechercher un dossier"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            Margin="24,0,120,0"/>

                    <Button Content="Rechercher un propriétaire"
                            Style="{StaticResource SecondaryActionButtonStyle}"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>


        <!-- Panneau de personnalisation -->
        <Grid Background="#99000000"
              Visibility="{Binding IsCustomizationOpen,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="520"
                    Background="White"
                    CornerRadius="10"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <Grid Margin="0,0,0,24">

                        <TextBlock Text="Personnaliser le tableau de bord"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"/>

                        <Button Content="✕"
                                HorizontalAlignment="Right"
                                Command="{Binding CloseCustomizationCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="18"
                                Cursor="Hand"/>

                    </Grid>

                    <TextBlock Text="Choisissez les statistiques à afficher dans votre tableau de bord."
                               Foreground="#666666"
                               Margin="0,0,0,20"/>

                    <ItemsControl ItemsSource="{Binding AvailableMetrics}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Border BorderBrush="#DDDDDD"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,10">

                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               Foreground="#242424"/>

                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                    <Button Content="Fermer"
                            Command="{Binding CloseCustomizationCommand}"
                            Style="{StaticResource PrimaryActionButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="0,24,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>