<UserControl x:Class="MuniChien.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F6F7F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- Barre supérieure -->
        


        <!-- Contenu -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="56,38">

                <TextBlock Text="Bienvenue dans MuniChien"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>

                <TextBlock Text="Gestion des propriétaires, chiens, licences et paiements"
                           Margin="0,8,0,28"
                           FontSize="14"
                           Foreground="#242424"/>

                
                <!-- Statistiques -->
                <ItemsControl ItemsSource="{Binding DashboardCards}"
              Margin="0,0,0,48">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>

                            <UniformGrid Columns="4"/>

                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource DashboardCardStyle}">

                                <StackPanel>

                                    <TextBlock Text="{Binding Title}"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="#657086"/>

                                    <TextBlock Text="{Binding Value}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               FontSize="24"
                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- Actions rapides -->
                <TextBlock Text="Actions rapides"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#242B38"
                           Margin="0,0,0,28"/>


                <StackPanel Orientation="Horizontal">

                    <Button Content="Rechercher un dossier"
        Style="{StaticResource PrimaryActionButtonStyle}"
        Margin="24,0,120,0"/>

                    <Button Content="Rechercher un propriétaire"
        Style="{StaticResource SecondaryActionButtonStyle}"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>