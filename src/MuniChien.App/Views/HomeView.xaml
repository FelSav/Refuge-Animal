<UserControl x:Class="MuniChien.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Tuile légère pour les raccourcis de l'accueil. -->
        <Style x:Key="QuickActionTileStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E5EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#E87524"/>
                                <Setter TargetName="Tile" Property="Background" Value="#FFF9F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#FFF0E2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>


    <Grid x:Name="RootGrid"
          Background="#F6F7F9"
          AllowDrop="True"
          DragOver="DashboardRoot_DragOver"
          Drop="DashboardRoot_Drop">


        <!-- ==================================================
             CONTENU PRINCIPAL
             ================================================== -->

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="56,38">


                <!-- En-tête -->
                <TextBlock Text="Bienvenue dans MuniChien"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>

                <TextBlock Text="Gestion des propriétaires, chiens, licences et paiements"
                           Margin="0,8,0,28"
                           FontSize="14"
                           Foreground="#242424"/>


                <!-- Bouton de personnalisation -->
                <Grid Margin="0,0,8,10">

                    <Button Content="Personnaliser"
                            HorizontalAlignment="Right"
                            Command="{Binding OpenCustomizationCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Padding="14,7"
                            FontSize="13"/>

                </Grid>


                <!-- ==================================================
                     CARTES DE STATISTIQUES
                     ================================================== -->

                <ItemsControl x:Name="DashboardItemsControl"
                    ItemsSource="{Binding DashboardCards}"
                    Margin="0,0,0,48">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>

                            <UniformGrid Columns="4"/>

                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource DashboardCardStyle}"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="DashboardCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DashboardCard_PreviewMouseMove"
                                    DragEnter="DashboardCard_DragEnter">

                                <StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#657086"/>

                                    <TextBlock Text="{Binding Value}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- ==================================================
                     ACTIONS RAPIDES : 6 MODULES ACCESSIBLES
                     ================================================== -->

                <TextBlock Text="Accès rapides"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#242B38"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Ouvrez directement un module de MuniChien."
                           FontSize="13"
                           Foreground="#667085"
                           Margin="0,0,0,17"/>

                <UniformGrid Columns="3" Rows="2">

                    <!-- RECHERCHE -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenSearchQuickCommand}"
                            Margin="0,0,12,12" MinHeight="128"
                            ToolTip="Rechercher des dossiers, chiens et licences">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Recherche" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Trouver un dossier" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- PROPRIÉTAIRES -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenOwnersQuickCommand}"
                            Margin="0,0,12,12" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Propriétaires" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Consulter les dossiers" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- CHIENS -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenDogsQuickCommand}"
                            Margin="0,0,0,12" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chiens" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Voir les fiches" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- LICENCES -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenLicensesQuickCommand}"
                            Margin="0,0,12,0" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Licences" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Suivre les renouvellements" FontSize="12" Foreground="#667085" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- PAIEMENTS -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenPaymentsQuickCommand}"
                            Margin="0,0,12,0" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Paiements" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Comptes et reçus" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- AVIS -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenNoticesQuickCommand}"
                            Margin="0,0,0,0" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Avis" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Préparer les rappels" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>
            </StackPanel>

        </ScrollViewer>


        <!-- ==================================================
             PANNEAU DE PERSONNALISATION
             ================================================== -->

        <Grid Background="#99000000"
              Visibility="{Binding IsCustomizationOpen,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border Width="580"
                    MaxHeight="700"
                    Background="White"
                    CornerRadius="10"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel>


                        <!-- ==================================================
                             TITRE
                             ================================================== -->

                        <Grid Margin="0,0,0,24">

                            <TextBlock Text="Personnaliser le tableau de bord"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#242424"/>

                            <Button Content="✕"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseCustomizationCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="18"
                                    Cursor="Hand"/>

                        </Grid>


                        <!-- ==================================================
                             REMPLACER UNE CARTE
                             ================================================== -->

                        <TextBlock Text="Remplacer une carte"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Choisissez d'abord l'emplacement du tableau de bord à modifier."
                                   FontSize="13"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>


                        <TextBlock Text="Carte à remplacer"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding DashboardCards}"
                                  SelectedItem="{Binding SelectedCard}"
                                  DisplayMemberPath="Title"
                                  Height="38"
                                  Padding="10,4"
                                  Margin="0,0,0,16"/>


                        <TextBlock Text="Statistique à utiliser"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding AvailableReplacementMetrics}"
                                  SelectedItem="{Binding SelectedMetric}"
                                  DisplayMemberPath="Title"
                                  Height="38"
                                  Padding="10,4"
                                  Margin="0,0,0,12"/>

                        <Button Content="Utiliser cette statistique"
                                Command="{Binding ReplaceWithMetricCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"
                                HorizontalAlignment="Left"/>


                        <!-- Séparateur -->
                        <Border Height="1"
                                Background="#DDDDDD"
                                Margin="0,28"/>


                        <!-- ==================================================
                             CRÉER UNE STATISTIQUE PERSONNALISÉE
                             ================================================== -->

                        <TextBlock Text="Créer une statistique personnalisée"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Ajoutez une donnée manuelle aux choix disponibles sans modifier immédiatement le tableau de bord."
                                   FontSize="13"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>


                        <TextBlock Text="Nom de la statistique"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding ManualCardTitle,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="14"
                                 Margin="0,0,0,14"/>


                        <TextBlock Text="Valeur"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding ManualCardValue,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="14"
                                 Margin="0,0,0,12"/>

                        <Button Content="Ajouter aux choix"
                                Command="{Binding CreateManualMetricCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                HorizontalAlignment="Left"/>


                        <!-- Séparateur -->
                        <Border Height="1"
                                Background="#DDDDDD"
                                Margin="0,28"/>


                        <!-- ==================================================
                             GÉRER LES STATISTIQUES PERSONNALISÉES
                             ================================================== -->

                        <TextBlock Text="Gérer mes statistiques personnalisées"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,4"/>

                        <TextBlock Text="Modifiez ou supprimez une statistique personnalisée déjà créée."
                                   FontSize="13"
                                   Foreground="#666666"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,16"/>


                        <TextBlock Text="Statistique"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <ComboBox ItemsSource="{Binding CustomMetrics}"
                                  SelectedItem="{Binding SelectedCustomMetric}"
                                  DisplayMemberPath="Title"
                                  Height="38"
                                  Padding="10,4"
                                  Margin="0,0,0,14"/>


                        <TextBlock Text="Nom"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding EditCustomMetricTitle,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="14"
                                 Margin="0,0,0,14"/>


                        <TextBlock Text="Valeur"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#242424"
                                   Margin="0,0,0,6"/>

                        <TextBox Text="{Binding EditCustomMetricValue,
                                              UpdateSourceTrigger=PropertyChanged}"
                                 Height="38"
                                 Padding="10,7"
                                 FontSize="14"
                                 Margin="0,0,0,14"/>


                        <StackPanel Orientation="Horizontal">

                            <Button Content="Enregistrer les modifications"
                                    Command="{Binding UpdateManualMetricCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Margin="0,0,12,0"/>

                            <Button Content="Supprimer"
                                    Command="{Binding DeleteManualMetricCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"/>

                        </StackPanel>


                        <!-- ==================================================
                             MESSAGE
                             ================================================== -->

                        <TextBlock Text="{Binding CustomizationMessage}"
                                   Foreground="#E87524"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,22,0,0"/>


                        <!-- ==================================================
                             FERMER
                             ================================================== -->

                        <Button Content="Fermer"
                                Command="{Binding CloseCustomizationCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                HorizontalAlignment="Right"
                                Margin="0,28,0,0"/>

                    </StackPanel>

                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>