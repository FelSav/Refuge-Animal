<UserControl x:Class="MuniChien.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Tuile légère pour les raccourcis de l'accueil. -->
        <Style x:Key="QuickActionTileStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E5EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="#E87524"/>
                                <Setter TargetName="Tile" Property="Background" Value="#FFF9F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="#FFF0E2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- Styles locaux : cette refonte n'affecte aucune autre page. -->
        <Style x:Key="CustomizationFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <!-- Garder le moteur natif du TextBox corrige le texte rogné en haut
             et évite le défilement interne introduit par un template personnalisé. -->
        <Style x:Key="CustomizationInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#242B38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Le contour externe donne des coins arrondis sans remplacer le
             moteur de saisie du TextBox : le focus garde une bordure orange. -->
        <Style x:Key="CustomizationInputShellStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="BorderBrush" Value="#D6DEE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#E87524"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CustomizationComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#242B38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DBE1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="CustomizationPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Background" Value="#E87524"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#D4671A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#BC5713"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomizationSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#DBE1E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#FFF7F0"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#E8B78F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#FCE9D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomizationTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#FFF9F3"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#BA5616"/>
                                <Setter TargetName="TabSurface" Property="Background" Value="#FFF0E2"/>
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#F5D8BE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomizationTabsStyle" TargetType="TabControl">
            <Setter Property="ItemContainerStyle" Value="{StaticResource CustomizationTabItemStyle}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" CornerRadius="12" Background="#F4F5F7"
                                    Padding="4" HorizontalAlignment="Left" Margin="0,0,0,17">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>


    <Grid x:Name="RootGrid"
          Background="#F6F7F9"
          AllowDrop="True"
          DragOver="DashboardRoot_DragOver"
          Drop="DashboardRoot_Drop">


        <!-- ==================================================
             CONTENU PRINCIPAL
             ================================================== -->

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="56,38">


                <!-- En-tête -->
                <TextBlock Text="Bienvenue dans MuniChien"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>

                <TextBlock Text="Gestion des clients, chiens, licences et paiements"
                           Margin="0,8,0,28"
                           FontSize="14"
                           Foreground="#242424"/>


                <!-- Statistiques locales : aucune valeur officielle de la BD / API. -->
                <Border Background="#FFF9F3"
                        BorderBrush="#F5D7BC"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="12,9"
                        Margin="0,0,0,16">
                    <TextBlock Text="Données locales de démonstration — Les véritables avis à envoyer ne peuvent pas encore être calculés par année."
                               FontSize="12"
                               Foreground="#935016"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- Actualisation et personnalisation -->
                <Grid Margin="0,0,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding LastUpdatedDisplay, Mode=OneWay}"
                               FontSize="12"
                               Foreground="#667085"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="Actualiser"
                            Command="{Binding RefreshStatisticsCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Padding="14,7"
                            FontSize="13"
                            Margin="0,0,10,0"/>

                    <Button Grid.Column="2"
                            Content="Personnaliser"
                            Command="{Binding OpenCustomizationCommand}"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Padding="14,7"
                            FontSize="13"/>
                </Grid>


                <!-- ==================================================
                     CARTES DE STATISTIQUES
                     ================================================== -->

                <ItemsControl x:Name="DashboardItemsControl"
                    ItemsSource="{Binding DashboardCards}"
                    Margin="0,0,0,48">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>

                            <UniformGrid Columns="4"/>

                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>


                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border Style="{StaticResource DashboardCardStyle}"
                                    AllowDrop="True"
                                    PreviewMouseLeftButtonDown="DashboardCard_PreviewMouseLeftButtonDown"
                                    PreviewMouseMove="DashboardCard_PreviewMouseMove"
                                    DragEnter="DashboardCard_DragEnter">

                                <StackPanel>

                                    <TextBlock Text="{Binding Title}"
                                               HorizontalAlignment="Center"
                                               FontSize="12"
                                               Foreground="#657086"/>

                                    <TextBlock Text="{Binding Value}"
                                               HorizontalAlignment="Center"
                                               Margin="0,6,0,0"
                                               FontSize="24"
                                               FontWeight="SemiBold"/>

                                </StackPanel>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>


                <!-- ==================================================
                     ACTIONS RAPIDES : 6 MODULES ACCESSIBLES
                     ================================================== -->

                <TextBlock Text="Accès rapides"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#242B38"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Ouvrez directement un module de MuniChien."
                           FontSize="13"
                           Foreground="#667085"
                           Margin="0,0,0,17"/>

                <UniformGrid Columns="3" Rows="2">

                    <!-- PROPRIÉTAIRES -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenOwnersQuickCommand}"
                            Margin="0,0,12,12" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Clients" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Consulter les dossiers" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- CHIENS -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenDogsQuickCommand}"
                            Margin="0,0,12,12" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chiens" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Voir les fiches" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- LICENCES -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenLicensesQuickCommand}"
                            Margin="0,0,0,12" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Licences" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Suivre les renouvellements" FontSize="12" Foreground="#667085" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <!-- PAIEMENTS -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenPaymentsQuickCommand}"
                            Margin="0,0,12,0" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Paiements" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Comptes et reçus" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- AVIS -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenNoticesQuickCommand}"
                            Margin="0,0,12,0" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Avis" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Préparer les rappels" FontSize="12" Foreground="#667085" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- RAPPORTS : sixième raccourci pour une grille équilibrée -->
                    <Button Style="{StaticResource QuickActionTileStyle}"
                            Command="{Binding OpenReportsQuickCommand}"
                            Margin="0" MinHeight="128">
                        <StackPanel>
                            <Border Width="36" Height="36" CornerRadius="9"
                                    Background="#FFF0E2" HorizontalAlignment="Left" Margin="0,0,0,11">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Foreground="#C85C16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Rapports" FontSize="15" FontWeight="SemiBold" Foreground="#242B38"/>
                            <TextBlock Text="Consulter les statistiques" FontSize="12" Foreground="#667085" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                </UniformGrid>
            </StackPanel>

        </ScrollViewer>


        <!-- ==================================================
             PERSONNALISER MON ACCUEIL
             Une seule zone de défilement, titre et actions toujours visibles.
             Les commandes existantes du ViewModel ne changent pas.
             ================================================== -->
        <Grid Background="#9918222D"
              Visibility="{Binding IsCustomizationOpen,
                                   Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border MaxWidth="900"
                    MaxHeight="780"
                    Margin="24"
                    Background="White"
                    CornerRadius="18"
                    BorderBrush="#E5E9EF"
                    BorderThickness="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#182230" BlurRadius="28"
                                      ShadowDepth="6" Opacity="0.18"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- EN-TÊTE FIXE : ne se perd pas quand on fait défiler. -->
                    <Grid Grid.Row="0" Margin="28,23,28,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="Personnaliser mon accueil"
                                       FontSize="23" FontWeight="SemiBold"
                                       Foreground="#242B38"/>
                            <TextBlock Text="Modifiez les chiffres affichés dans vos cartes."
                                       FontSize="13" Foreground="#667085"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Width="38" Height="38"
                                Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets"
                                FontSize="14" Padding="0" VerticalAlignment="Top"
                                ToolTip="Fermer"
                                Command="{Binding CloseCustomizationCommand}"
                                Style="{StaticResource CustomizationSecondaryButtonStyle}"/>
                    </Grid>

                    <!-- UNIQUE DÉFILEMENT : les champs n'absorbent plus la molette. -->
                    <ScrollViewer x:Name="CustomizationBodyScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  CanContentScroll="False">
                        <StackPanel Margin="28,2,28,22">
                            <TabControl Style="{StaticResource CustomizationTabsStyle}"
                                        SelectedIndex="0">

                                <!-- ONGLET : REMPLACER UNE CARTE -->
                                <TabItem Header="Remplacer une carte">
                                    <StackPanel>
                                        <TextBlock Text="Modifier une carte en deux étapes"
                                                   Foreground="#242B38" FontSize="15"
                                                   FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <TextBlock Text="Choisissez d'abord la carte, puis ce que vous voulez afficher à sa place."
                                                   Foreground="#667085" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,0,0,17"/>

                                        <!-- Étape 1 -->
                                        <Border Background="#FAFBFC" BorderBrush="#E6E9EE"
                                                BorderThickness="1" CornerRadius="13"
                                                Padding="20" Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <Border Background="#FFF0E2" CornerRadius="13"
                                                            Width="26" Height="26" Margin="0,0,10,0">
                                                        <TextBlock Text="1" Foreground="#B95716"
                                                                   FontWeight="SemiBold" FontSize="13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Sélectionner la carte à modifier"
                                                               Foreground="#242B38" FontSize="15"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="Quelle carte présente sur l'accueil voulez-vous remplacer ?"
                                                           Foreground="#667085" FontSize="12"
                                                           TextWrapping="Wrap" Margin="36,0,0,14"/>
                                                <TextBlock Text="Carte actuelle"
                                                           Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding DashboardCards}"
                                                          SelectedItem="{Binding SelectedCard}"
                                                          DisplayMemberPath="Title"
                                                          Style="{StaticResource CustomizationComboStyle}"/>

                                                <Border Background="White" BorderBrush="#E5E9EF"
                                                        BorderThickness="1" CornerRadius="9"
                                                        Padding="14,12" Margin="0,12,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                            <TextBlock Text="EN CE MOMENT" FontSize="10"
                                                                       FontWeight="SemiBold" Foreground="#8894A5"/>
                                                            <TextBlock Text="{Binding SelectedCard.Title, TargetNullValue=Aucune carte sélectionnée}"
                                                                       Foreground="#344054" FontSize="13"
                                                                       TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding SelectedCard.Value}"
                                                                   FontSize="23" FontWeight="SemiBold"
                                                                   Foreground="#242B38" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Étape 2 -->
                                        <Border Background="#FAFBFC" BorderBrush="#E6E9EE"
                                                BorderThickness="1" CornerRadius="13"
                                                Padding="20">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <Border Background="#FFF0E2" CornerRadius="13"
                                                            Width="26" Height="26" Margin="0,0,10,0">
                                                        <TextBlock Text="2" Foreground="#B95716"
                                                                   FontWeight="SemiBold" FontSize="13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="Choisir la nouvelle statistique"
                                                               Foreground="#242B38" FontSize="15"
                                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="La nouvelle statistique prendra la place de la carte sélectionnée."
                                                           Foreground="#667085" FontSize="12"
                                                           TextWrapping="Wrap" Margin="36,0,0,14"/>
                                                <TextBlock Text="Statistique à afficher"
                                                           Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding AvailableReplacementMetrics}"
                                                          SelectedItem="{Binding SelectedMetric}"
                                                          DisplayMemberPath="Title"
                                                          Style="{StaticResource CustomizationComboStyle}"/>
                                                <TextBlock Text="Vous pouvez aussi créer une statistique dans l'onglet « Mes statistiques »."
                                                           Foreground="#667085" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,12,0,16"/>
                                                <Button Content="Appliquer le changement"
                                                        Command="{Binding ReplaceWithMetricCommand}"
                                                        Style="{StaticResource CustomizationPrimaryButtonStyle}"
                                                        HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </TabItem>

                                <!-- ONGLET : MES STATISTIQUES -->
                                <TabItem Header="Mes statistiques">
                                    <StackPanel>
                                        <TextBlock Text="Mes statistiques personnalisées"
                                                   Foreground="#242B38" FontSize="15"
                                                   FontWeight="SemiBold" Margin="0,0,0,5"/>
                                        <TextBlock Text="Créez vos propres chiffres, puis affichez-les sur une carte depuis l'autre onglet."
                                                   Foreground="#667085" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,0,0,17"/>

                                        <!-- Formulaire de création : grille de champs alignés. -->
                                        <Border Background="#FAFBFC" BorderBrush="#E6E9EE"
                                                BorderThickness="1" CornerRadius="13"
                                                Padding="20" Margin="0,0,0,12">
                                            <StackPanel>
                                                <TextBlock Text="Ajouter une statistique"
                                                           Foreground="#242B38" FontSize="16"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Entrez un nom clair et sa valeur actuelle."
                                                           Foreground="#667085" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,5,0,17"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Nom de la statistique"
                                                                   Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                                        <Border Style="{StaticResource CustomizationInputShellStyle}">
                                                            <TextBox Text="{Binding ManualCardTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource CustomizationInputStyle}"
                                                                     PreviewMouseWheel="CustomizationTextBox_PreviewMouseWheel"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Valeur"
                                                                   Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                                        <Border Style="{StaticResource CustomizationInputShellStyle}">
                                                            <TextBox Text="{Binding ManualCardValue, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource CustomizationInputStyle}"
                                                                     PreviewMouseWheel="CustomizationTextBox_PreviewMouseWheel"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <Button Content="Ajouter la statistique"
                                                        Command="{Binding CreateManualMetricCommand}"
                                                        Style="{StaticResource CustomizationPrimaryButtonStyle}"
                                                        Margin="0,17,0,0" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Formulaire de modification indépendant. -->
                                        <Border Background="#FAFBFC" BorderBrush="#E6E9EE"
                                                BorderThickness="1" CornerRadius="13"
                                                Padding="20">
                                            <StackPanel>
                                                <TextBlock Text="Modifier ou supprimer une statistique"
                                                           Foreground="#242B38" FontSize="16"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Sélectionnez d'abord une statistique déjà créée."
                                                           Foreground="#667085" FontSize="12"
                                                           TextWrapping="Wrap" Margin="0,5,0,17"/>
                                                <TextBlock Text="Statistique enregistrée"
                                                           Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding CustomMetrics}"
                                                          SelectedItem="{Binding SelectedCustomMetric}"
                                                          DisplayMemberPath="Title"
                                                          Style="{StaticResource CustomizationComboStyle}"
                                                          Margin="0,0,0,16"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Nom"
                                                                   Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                                        <Border Style="{StaticResource CustomizationInputShellStyle}">
                                                            <TextBox Text="{Binding EditCustomMetricTitle, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource CustomizationInputStyle}"
                                                                     PreviewMouseWheel="CustomizationTextBox_PreviewMouseWheel"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Valeur"
                                                                   Style="{StaticResource CustomizationFieldLabelStyle}"/>
                                                        <Border Style="{StaticResource CustomizationInputShellStyle}">
                                                            <TextBox Text="{Binding EditCustomMetricValue, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource CustomizationInputStyle}"
                                                                     PreviewMouseWheel="CustomizationTextBox_PreviewMouseWheel"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
                                                    <Button Content="Enregistrer"
                                                            Command="{Binding UpdateManualMetricCommand}"
                                                            Style="{StaticResource CustomizationPrimaryButtonStyle}"
                                                            Margin="0,0,10,0"/>
                                                    <Button Content="Supprimer"
                                                            Command="{Binding DeleteManualMetricCommand}"
                                                            Style="{StaticResource CustomizationSecondaryButtonStyle}"
                                                            Foreground="#B0473D"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <!-- Message des commandes existantes, visible près des actions. -->
                            <Border Background="#FFF4E8" BorderBrush="#F6D7B6"
                                    BorderThickness="1" CornerRadius="10"
                                    Padding="13,11" Margin="0,15,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CustomizationMessage}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding CustomizationMessage}"
                                           FontSize="12" Foreground="#97521F"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PIED FIXE : le bouton Terminer reste visible. -->
                    <Border Grid.Row="2" Background="#FFFFFF"
                            BorderBrush="#E9EDF2" BorderThickness="0,1,0,0"
                            Padding="28,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Les changements sont enregistrés après chaque action."
                                       Foreground="#7A8797" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap"
                                       Margin="0,0,15,0"/>
                            <Button Grid.Column="1" Content="Terminer"
                                    Command="{Binding CloseCustomizationCommand}"
                                    Style="{StaticResource CustomizationSecondaryButtonStyle}"
                                    MinWidth="105"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>

</UserControl>