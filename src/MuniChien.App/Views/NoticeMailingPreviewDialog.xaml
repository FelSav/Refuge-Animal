<Window x:Class="MuniChien.App.Views.NoticeMailingPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperçu du courrier — Démonstration"
        Width="1080" Height="805" MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="3,2,3,12">
            <TextBlock x:Name="PreviewTitle" FontSize="22" FontWeight="SemiBold" Foreground="#242B38"/>
            <TextBlock x:Name="PreviewInfo" Margin="0,5,0,0" FontSize="12" Foreground="#667085" TextWrapping="Wrap"/>
            <TextBlock Text="DOCUMENTS DE DÉMONSTRATION — ADRESSES NON VALIDÉES. NE PAS POSTER."
                       Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#A0450E"
                       FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Grid.Row="1" Background="White" BorderBrush="#E4E7EC"
                BorderThickness="1" CornerRadius="12" Padding="4">
            <DocumentViewer x:Name="PreviewViewer"/>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button Content="Fermer" Click="Close_Click"
                    Style="{StaticResource SecondaryActionButtonStyle}" Padding="15,9"
                    Margin="0,0,10,0"/>
            <Button Content="Imprimer (test seulement)" Click="Print_Click"
                    Style="{StaticResource PrimaryActionButtonStyle}" Padding="15,9"/>
        </StackPanel>
    </Grid>
</Window>
