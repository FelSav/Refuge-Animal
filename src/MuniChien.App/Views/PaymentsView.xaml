<UserControl x:Class="MuniChien.App.Views.PaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ==================================================
             CARTES
             ================================================== -->

        <Style x:Key="PaymentCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <!-- ==================================================
             TITRES
             ================================================== -->

        <Style x:Key="PaymentSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <!-- ==================================================
             LABELS
             ================================================== -->

        <Style x:Key="PaymentLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>


        <!-- ==================================================
             TEXTBOX
             ================================================== -->

        <Style x:Key="PaymentTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="11,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#E87524"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ==================================================
             DATAGRID
             ================================================== -->

        <Style x:Key="PaymentDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="CanUserSortColumns"
                    Value="True"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FCFCFD"/>

            <Setter Property="RowHeight"
                    Value="46"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

        </Style>


        <Style x:Key="PaymentHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="BorderBrush"
                    Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <Style x:Key="PaymentCellStyle"
               TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <Style x:Key="PaymentCellTextStyle"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="10,0"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

        </Style>

    </UserControl.Resources>


    <Grid Background="#F6F7F9">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,36,52,44">


                <!-- ==================================================
                     ENTÊTE
                     ================================================== -->

                <TextBlock Text="Paiements"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>


                <TextBlock Text="Enregistrez et consultez les paiements d’un propriétaire."
                           Margin="0,7,0,24"
                           FontSize="14"
                           Foreground="#667085"/>


                <!-- ==================================================
                     PROPRIÉTAIRE
                     ================================================== -->

                <Border Style="{StaticResource PaymentCardStyle}"
                        Margin="0,0,0,22">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="28"/>

                            <ColumnDefinition Width="320"/>

                        </Grid.ColumnDefinitions>


                        <!-- INFOS -->

                        <StackPanel>

                            <TextBlock Text="Propriétaire"
                                       Style="{StaticResource PaymentSectionTitleStyle}"
                                       Margin="0,0,0,16"/>


                            <TextBlock Text="{Binding OwnerName}"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>


                            <StackPanel Orientation="Horizontal"
                                        Margin="0,10,0,0">

                                <TextBlock Text="Dossier "
                                           FontSize="13"
                                           Foreground="#667085"/>

                                <TextBlock Text="{Binding FileNumber}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#344054"/>


                                <TextBlock Text="   •   "
                                           FontSize="13"
                                           Foreground="#98A2B3"/>


                                <TextBlock Text="{Binding Municipality}"
                                           FontSize="13"
                                           Foreground="#667085"/>

                            </StackPanel>

                        </StackPanel>


                        <!-- SÉLECTION -->

                        <StackPanel Grid.Column="2">

                            <TextBlock Text="Changer de propriétaire"
                                       Style="{StaticResource PaymentLabelStyle}"/>


                            <ComboBox ItemsSource="{Binding OwnerOptions}"
                                      SelectedItem="{Binding SelectedOwner}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource RoundedComboBoxStyle}"
                                      Height="40"/>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ==================================================
                     RÉSUMÉ
                     ================================================== -->

                <TextBlock Text="Résumé du compte"
                           Style="{StaticResource PaymentSectionTitleStyle}"
                           Margin="0,0,0,13"/>


                <Grid Margin="0,0,0,22">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="14"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="14"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="14"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- SOLDE -->

                    <Border Grid.Column="0"
                            Style="{StaticResource PaymentCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Montant facturé"
                                       FontSize="12"
                                       Foreground="#667085"/>

                            <TextBlock Text="{Binding AmountDueDisplay}"
                                       Margin="0,7,0,0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>

                        </StackPanel>

                    </Border>


                    <!-- RETARD -->

                    <Border Grid.Column="2"
                            Style="{StaticResource PaymentCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Frais de retard"
                                       FontSize="12"
                                       Foreground="#667085"/>

                            <TextBlock Text="{Binding LateFeesDisplay}"
                                       Margin="0,7,0,0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#B54708"/>

                        </StackPanel>

                    </Border>


                    <!-- PAIEMENTS -->

                    <Border Grid.Column="4"
                            Style="{StaticResource PaymentCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Paiements reçus"
                                       FontSize="12"
                                       Foreground="#667085"/>

                            <TextBlock Text="{Binding TotalPaymentsDisplay}"
                                       Margin="0,7,0,0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#067647"/>

                        </StackPanel>

                    </Border>


                    <!-- BALANCE -->

                    <Border Grid.Column="6"
                            Style="{StaticResource PaymentCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Solde dû"
                                       FontSize="12"
                                       Foreground="#667085"/>

                            <TextBlock Text="{Binding BalanceDisplay}"
                                       Margin="0,7,0,0"
                                       FontSize="24"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     NOUVEAU + HISTORIQUE
                     ================================================== -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="0.85*"/>

                        <ColumnDefinition Width="22"/>

                        <ColumnDefinition Width="1.35*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ==================================================
                         NOUVEAU PAIEMENT
                         ================================================== -->

                    <Border Grid.Column="0"
                            Style="{StaticResource PaymentCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Nouveau paiement"
                                       Style="{StaticResource PaymentSectionTitleStyle}"/>


                            <TextBlock Text="Enregistrez un paiement pour le propriétaire sélectionné."
                                       FontSize="12"
                                       Foreground="#98A2B3"
                                       Margin="0,5,0,20"
                                       TextWrapping="Wrap"/>


                            <!-- MESSAGE -->

                            <Border Background="#FFF4ED"
                                    BorderBrush="#E87524"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,16">

                                <Border.Style>

                                    <Style TargetType="Border">

                                        <Setter Property="Visibility"
                                                Value="Visible"/>


                                        <Style.Triggers>

                                            <DataTrigger Binding="{Binding ValidationMessage}"
                                                         Value="">

                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                            </DataTrigger>

                                        </Style.Triggers>

                                    </Style>

                                </Border.Style>


                                <TextBlock Text="{Binding ValidationMessage}"
                                           FontSize="12"
                                           Foreground="#8A3B00"
                                           TextWrapping="Wrap"/>

                            </Border>


                            <!-- DATE -->

                            <TextBlock Text="Date"
                                       Style="{StaticResource PaymentLabelStyle}"/>

                            <DatePicker SelectedDate="{Binding NewPaymentDate}"
                                        Height="40"
                                        Margin="0,0,0,15"/>


                            <!-- MONTANT -->

                            <TextBlock Text="Montant"
                                       Style="{StaticResource PaymentLabelStyle}"/>

                            <Grid Margin="0,0,0,18">

                                <TextBox Text="{Binding AmountInput,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource PaymentTextBoxStyle}"/>

                                <TextBlock Text="$"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Foreground="#667085"
                                           IsHitTestVisible="False"/>

                            </Grid>


                            <!-- OPTIONS -->

                            <TextBlock Text="Type de paiement"
                                       Style="{StaticResource PaymentLabelStyle}"/>


                            <Border Background="#F8FAFC"
                                    BorderBrush="#E4E7EC"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14">

                                <StackPanel>

                                    <CheckBox Content="Paiement municipalité (M)"
                                              IsChecked="{Binding IsMunicipalityPayment}"
                                              FontSize="13"/>


                                    <CheckBox Content="Chèque (C)"
                                              IsChecked="{Binding IsCheque}"
                                              Margin="0,12,0,0"
                                              FontSize="13"/>

                                </StackPanel>

                            </Border>


                            <!-- ACTIONS -->

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,22,0,0">

                                <Button Content="Annuler"
                                        Command="{Binding CancelPaymentCommand}"
                                        Style="{StaticResource SecondaryActionButtonStyle}"
                                        Padding="17,8"
                                        Margin="0,0,12,0"/>


                                <Button Content="Enregistrer"
                                        Command="{Binding RegisterPaymentCommand}"
                                        Style="{StaticResource PrimaryActionButtonStyle}"
                                        Padding="18,8"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>


                    <!-- ==================================================
                         HISTORIQUE
                         ================================================== -->

                    <Border Grid.Column="2"
                            Style="{StaticResource PaymentCardStyle}">

                        <Grid>

                            <Grid.RowDefinitions>

                                <RowDefinition Height="Auto"/>

                                <RowDefinition Height="*"/>

                            </Grid.RowDefinitions>


                            <StackPanel Margin="0,0,0,16">

                                <TextBlock Text="Historique des paiements"
                                           Style="{StaticResource PaymentSectionTitleStyle}"/>


                                <TextBlock Text="Tous les paiements enregistrés pour ce propriétaire."
                                           FontSize="12"
                                           Foreground="#98A2B3"
                                           Margin="0,5,0,0"/>

                            </StackPanel>


                            <Border Grid.Row="1"
                                    BorderBrush="#E4E7EC"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    ClipToBounds="True"
                                    MinHeight="280">

                                <Grid>

                                    <DataGrid ItemsSource="{Binding PaymentHistory}"
                                              Style="{StaticResource PaymentDataGridStyle}"
                                              ColumnHeaderStyle="{StaticResource PaymentHeaderStyle}"
                                              CellStyle="{StaticResource PaymentCellStyle}">

                                        <DataGrid.Columns>

                                            <DataGridTextColumn Header="Reçu"
                                                                Binding="{Binding ReceiptNumber}"
                                                                Width="0.9*"
                                                                ElementStyle="{StaticResource PaymentCellTextStyle}"/>


                                            <DataGridTextColumn Header="Date"
                                                                Binding="{Binding PaymentDateDisplay}"
                                                                SortMemberPath="PaymentDate"
                                                                Width="1.15*"
                                                                ElementStyle="{StaticResource PaymentCellTextStyle}"/>


                                            <DataGridTextColumn Header="Montant"
                                                                Binding="{Binding AmountDisplay}"
                                                                SortMemberPath="Amount"
                                                                Width="1.1*"
                                                                ElementStyle="{StaticResource PaymentCellTextStyle}"/>


                                            <DataGridTextColumn Header="Municipalité"
                                                                Binding="{Binding MunicipalityPaymentDisplay}"
                                                                Width="1.1*"
                                                                ElementStyle="{StaticResource PaymentCellTextStyle}"/>


                                            <DataGridTextColumn Header="Chèque"
                                                                Binding="{Binding ChequeDisplay}"
                                                                Width="0.9*"
                                                                ElementStyle="{StaticResource PaymentCellTextStyle}"/>

                                        </DataGrid.Columns>

                                    </DataGrid>


                                    <!-- AUCUN PAIEMENT -->

                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                IsHitTestVisible="False">

                                        <StackPanel.Style>

                                            <Style TargetType="StackPanel">

                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>


                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding HasPaymentHistory}"
                                                                 Value="False">

                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </StackPanel.Style>


                                        <TextBlock Text="Aucun paiement"
                                                   HorizontalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#344054"/>


                                        <TextBlock Text="Aucun paiement n'a encore été enregistré."
                                                   Margin="0,5,0,0"
                                                   FontSize="12"
                                                   Foreground="#98A2B3"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </Grid>

                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>