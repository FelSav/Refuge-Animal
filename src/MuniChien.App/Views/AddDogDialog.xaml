<Window x:Class="MuniChien.App.Views.AddDogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajouter un chien"
        Width="650"
        Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F6F7F9">

    <Window.Resources>

        <Style x:Key="DialogLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="Margin"
                    Value="0,0,0,6"/>

        </Style>


        <Style x:Key="DialogTextBoxStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="42"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#E87524"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>


    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="34">


                <TextBlock Text="Ajouter un chien"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>

                <TextBlock Text="Le chien sera automatiquement associé au propriétaire actuel."
                           FontSize="14"
                           Foreground="#667085"
                           Margin="0,6,0,26"/>


                <!-- Propriétaire -->

                <TextBlock Text="Propriétaire"
                           Style="{StaticResource DialogLabelStyle}"/>

                <Border Background="#F2F4F7"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12"
                        Margin="0,0,0,18">

                    <TextBlock x:Name="OwnerNameText"
                               FontSize="14"
                               Foreground="#344054"/>

                </Border>


                <!-- Ligne 1 -->

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- Nom -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Nom du chien"
                                   Style="{StaticResource DialogLabelStyle}"/>

                        <TextBox x:Name="DogNameTextBox"
                                 Style="{StaticResource DialogTextBoxStyle}"/>

                    </StackPanel>


                    <!-- Race -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Race"
                                   Style="{StaticResource DialogLabelStyle}"/>

                        <ComboBox x:Name="BreedComboBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  Style="{StaticResource RoundedComboBoxStyle}"/>

                    </StackPanel>

                </Grid>


                <!-- Ligne 2 -->

                <Grid Margin="0,18,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- Âge -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Âge"
                                   Style="{StaticResource DialogLabelStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="105"/>
                            </Grid.ColumnDefinitions>


                            <TextBox x:Name="AgeValueTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource DialogTextBoxStyle}"/>


                            <ComboBox x:Name="AgeUnitComboBox"
                                      Grid.Column="2"
                                      Style="{StaticResource RoundedComboBoxStyle}"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="mois"/>
                                <ComboBoxItem Content="ans"/>

                            </ComboBox>

                        </Grid>

                    </StackPanel>


                    <!-- Poids -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Poids (kg)"
                                   Style="{StaticResource DialogLabelStyle}"/>

                        <TextBox x:Name="WeightTextBox"
                                 Style="{StaticResource DialogTextBoxStyle}"/>

                    </StackPanel>

                </Grid>


                <!-- Ligne 3 -->

                <Grid Margin="0,18,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>


                    <!-- Couleur -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Couleur"
                                   Style="{StaticResource DialogLabelStyle}"/>

                        <ComboBox x:Name="ColorComboBox"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  Style="{StaticResource RoundedComboBoxStyle}"/>

                    </StackPanel>


                    <!-- Licence -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Licence"
                                   Style="{StaticResource DialogLabelStyle}"/>

                        <TextBox x:Name="LicenseTextBox"
                                 Style="{StaticResource DialogTextBoxStyle}"/>

                    </StackPanel>

                </Grid>


                <!-- Ligne 4 -->

                <Grid Margin="0,18,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="18"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="18"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- Sexe -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Sexe"
                                   Style="{StaticResource DialogLabelStyle}"/>

                        <ComboBox x:Name="SexComboBox"
                                  Style="{StaticResource RoundedComboBoxStyle}"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="M"/>
                            <ComboBoxItem Content="F"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- Statut -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Statut"
                                   Style="{StaticResource DialogLabelStyle}"
                                   />

                        <ComboBox x:Name="StatusComboBox"
                                  Style="{StaticResource RoundedComboBoxStyle}"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="Actif"/>
                            <ComboBoxItem Content="Inactif"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- Stérilisé -->
                    <StackPanel Grid.Column="4">

                        <TextBlock Text="Stérilisé"
                                   Style="{StaticResource DialogLabelStyle}"/>

                        <ComboBox x:Name="SterilizedComboBox"
                                  Style="{StaticResource RoundedComboBoxStyle}"
                                  SelectedIndex="0">

                            <ComboBoxItem Content="Oui"/>
                            <ComboBoxItem Content="Non"/>

                        </ComboBox>

                    </StackPanel>

                </Grid>


                <!-- Boutons -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,32,0,0">

                    <Button Content="Annuler"
                            Click="Cancel_Click"
                            Style="{StaticResource SecondaryActionButtonStyle}"
                            Margin="0,0,12,0"/>

                    <Button Content="Ajouter"
                            Click="Save_Click"
                            Style="{StaticResource PrimaryActionButtonStyle}"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</Window>