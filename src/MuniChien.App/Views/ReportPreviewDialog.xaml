<Window x:Class="MuniChien.App.Views.ReportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aperçu du rapport"
        Width="980"
        Height="650"
        MinWidth="800"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F6F7F9">

    <Window.Resources>

        <!-- ==================================================
             DATAGRID
             ================================================== -->

        <Style x:Key="ReportDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserSortColumns"
                    Value="True"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="RowHeight"
                    Value="44"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FCFCFD"/>

        </Style>


        <Style x:Key="ReportHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="BorderBrush"
                    Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <Style x:Key="ReportCellStyle"
               TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <Style x:Key="ReportTextStyle"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="12,0"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>

    </Window.Resources>


    <Grid Margin="26">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="Auto"/>

            <RowDefinition Height="*"/>

            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>


        <!-- ==================================================
             ENTÊTE
             ================================================== -->

        <Grid Grid.Row="0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <StackPanel>

                <TextBlock Text="{Binding ReportTitle}"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>


                <TextBlock Text="{Binding Description}"
                           Margin="0,6,0,0"
                           FontSize="13"
                           Foreground="#667085"
                           TextWrapping="Wrap"/>

            </StackPanel>


            <Border Grid.Column="1"
                    Background="#FFF5ED"
                    BorderBrush="#F2B98F"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14,8"
                    VerticalAlignment="Top">

                <TextBlock Text="{Binding ResultCountText}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#B54708"/>

            </Border>

        </Grid>


        <!-- ==================================================
             PARAMÈTRES
             ================================================== -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E4E7EC"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,22,0,18">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0">

                    <TextBlock Text="Municipalité"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#667085"/>

                    <TextBlock Text="{Binding Municipality}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#242B38"/>

                </StackPanel>


                <StackPanel Grid.Column="1">

                    <TextBlock Text="Période"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#667085"/>

                    <TextBlock Text="{Binding Period}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#242B38"/>

                </StackPanel>


                <StackPanel Grid.Column="2">

                    <TextBlock Text="Généré le"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#667085"/>

                    <TextBlock Text="{Binding GeneratedAt}"
                               Margin="0,4,0,0"
                               FontSize="13"
                               Foreground="#242B38"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ==================================================
             TABLEAU
             ================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E4E7EC"
                BorderThickness="1"
                CornerRadius="12"
                ClipToBounds="True">

            <Grid>

                <DataGrid x:Name="ReportDataGrid"
                          ItemsSource="{Binding Rows}"
                          Style="{StaticResource ReportDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource ReportHeaderStyle}"
                          CellStyle="{StaticResource ReportCellStyle}">

                    <DataGrid.Columns>

                        <DataGridTextColumn x:Name="Column1"
                                            Binding="{Binding Value1}"
                                            Width="*"
                                            ElementStyle="{StaticResource ReportTextStyle}"/>

                        <DataGridTextColumn x:Name="Column2"
                                            Binding="{Binding Value2}"
                                            Width="*"
                                            ElementStyle="{StaticResource ReportTextStyle}"/>

                        <DataGridTextColumn x:Name="Column3"
                                            Binding="{Binding Value3}"
                                            Width="*"
                                            ElementStyle="{StaticResource ReportTextStyle}"/>

                        <DataGridTextColumn x:Name="Column4"
                                            Binding="{Binding Value4}"
                                            Width="*"
                                            ElementStyle="{StaticResource ReportTextStyle}"/>

                        <DataGridTextColumn x:Name="Column5"
                                            Binding="{Binding Value5}"
                                            Width="*"
                                            ElementStyle="{StaticResource ReportTextStyle}"/>

                        <DataGridTextColumn x:Name="Column6"
                                            Binding="{Binding Value6}"
                                            Width="*"
                                            ElementStyle="{StaticResource ReportTextStyle}"/>

                    </DataGrid.Columns>

                </DataGrid>


                <!-- AUCUN RÉSULTAT -->

                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False">

                    <StackPanel.Style>

                        <Style TargetType="StackPanel">

                            <Setter Property="Visibility"
                                    Value="Collapsed"/>


                            <Style.Triggers>

                                <DataTrigger Binding="{Binding HasResults}"
                                             Value="False">

                                    <Setter Property="Visibility"
                                            Value="Visible"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </StackPanel.Style>


                    <TextBlock Text="Aucune donnée"
                               HorizontalAlignment="Center"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#344054"/>


                    <TextBlock Text="Aucune donnée ne correspond aux paramètres sélectionnés."
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="#98A2B3"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ==================================================
             ACTIONS
             ================================================== -->

        <Grid Grid.Row="3"
              Margin="0,20,0,0">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>


            <TextBlock Text="Vous pouvez trier les résultats en cliquant sur les en-têtes du tableau."
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="#98A2B3"/>


            <StackPanel Grid.Column="1"
                        Orientation="Horizontal">

                <Button Content="Exporter CSV"
                        Click="ExportCsv_Click"
                        Style="{StaticResource SecondaryActionButtonStyle}"
                        Padding="16,8"
                        Margin="0,0,12,0"/>


                <Button Content="Fermer"
                        Click="Close_Click"
                        Style="{StaticResource PrimaryActionButtonStyle}"
                        Padding="18,8"/>

            </StackPanel>

        </Grid>

    </Grid>

</Window>