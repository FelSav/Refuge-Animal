<UserControl x:Class="MuniChien.App.Views.ApiReadOnlyPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Background="#F5F6F9">
        <ScrollViewer Padding="30" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <DockPanel LastChildFill="True">
                        <Button Content="Actualiser" Command="{Binding RefreshCommand}"
                                DockPanel.Dock="Right" Padding="16,10" Margin="16,0,0,0"
                                Background="#ED791F" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Heading}" FontSize="24" FontWeight="SemiBold" Foreground="#263248"/>
                            <TextBlock Text="{Binding Endpoint}" FontSize="13" Foreground="#6D788B" Margin="0,6,0,0"/>
                            <TextBlock Text="Lecture seule — données reçues du serveur, sans modification possible"
                                       FontSize="12" Foreground="#7C8492" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Text="Chargement des données du serveur…" FontSize="15" Foreground="#526273"
                           Visibility="{Binding LoadState.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Margin="6,14,0,14"/>
                <Border Background="#FFF4EE" BorderBrush="#E9B69D" BorderThickness="1" CornerRadius="9"
                        Padding="16" Margin="0,0,0,14"
                        Visibility="{Binding LoadState.HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding LoadState.ErrorMessage}" TextWrapping="Wrap" Foreground="#8E4433"/>
                </Border>
                <TextBlock Text="{Binding LoadState.EmptyMessage}" Foreground="#596778" Margin="6,14,0,14"
                           Visibility="{Binding LoadState.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding Summary}" Visibility="{Binding SummaryVisibility}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="9"
                                    Padding="15" Margin="0,0,12,12" MinWidth="175" MaxWidth="340">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="#667085" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Value}" Foreground="#2B3546" FontSize="18" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Visibility="{Binding TableVisibility}" Background="White" CornerRadius="10"
                        BorderBrush="#E1E5EC" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{Binding CountLabel}" FontSize="15" Foreground="#3E4857"
                                   FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <DataGrid AutoGenerateColumns="True" ItemsSource="{Binding TableView}" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                                  AlternatingRowBackground="#F7F8FA" GridLinesVisibility="Horizontal"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  RowHeight="35" MaxHeight="530" ColumnWidth="SizeToCells"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Note}" Foreground="#727C8A" FontSize="12"
                           TextWrapping="Wrap" Margin="4,0,0,20"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
