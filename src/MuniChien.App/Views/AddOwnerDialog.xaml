<Window x:Class="MuniChien.App.Views.AddOwnerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveau client — MuniChien"
        Width="760" Height="720" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F6F7F9" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="NewOwnerLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#344054"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
        <Style x:Key="NewOwnerInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#242B38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="#E87524"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NewOwnerMultiline" TargetType="TextBox">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#242B38"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style x:Key="NewOwnerCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E4E7EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC"
                BorderThickness="0,0,0,1" Padding="30,22,30,19">
            <StackPanel>
                <TextBlock Text="Nouveau client" FontSize="25" FontWeight="SemiBold" Foreground="#242B38"/>
                <TextBlock Text="Créer un dossier dans le répertoire local de démonstration."
                           Foreground="#667085" FontSize="14" Margin="0,7,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,23,30,23">
                <Border Background="#FFF5EB" BorderBrush="#FFD7B5" BorderThickness="1"
                        CornerRadius="10" Padding="14" Margin="0,0,0,17">
                    <StackPanel>
                        <TextBlock Text="Les champs marqués d'un * sont obligatoires. Un chien n'est pas nécessaire."
                                   Foreground="#9B4715" FontSize="13"/>
                        <TextBlock Text="Le numéro de dossier sera attribué automatiquement pour les tests."
                                   Foreground="#9B4715" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource NewOwnerCard}">
                    <StackPanel>
                        <TextBlock Text="Informations du client" Foreground="#242B38"
                                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Prénom *" Style="{StaticResource NewOwnerLabel}"/>
                                <TextBox x:Name="FirstNameBox" Style="{StaticResource NewOwnerInput}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nom *" Style="{StaticResource NewOwnerLabel}"/>
                                <TextBox x:Name="LastNameBox" Style="{StaticResource NewOwnerInput}" MaxLength="100"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,17,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Municipalité (facultative)" Style="{StaticResource NewOwnerLabel}"/>
                                <ComboBox x:Name="MunicipalityBox" Height="42"
                                          Style="{StaticResource RoundedComboBoxStyle}"
                                          IsEditable="False"/>
                                <TextBlock Text="À compléter seulement si une licence canine est nécessaire."
                                           Foreground="#667085" FontSize="11" Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Statut" Style="{StaticResource NewOwnerLabel}"/>
                                <ComboBox x:Name="StatusBox" Height="42"
                                          Style="{StaticResource RoundedComboBoxStyle}">
                                    <ComboBoxItem Content="Actif" IsSelected="True"/>
                                    <ComboBoxItem Content="Inactif"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource NewOwnerCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Coordonnées et commentaires" Foreground="#242B38"
                                   FontSize="17" FontWeight="SemiBold" Margin="0,0,0,18"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Téléphone (recherche en caisse)" Style="{StaticResource NewOwnerLabel}"/>
                                <TextBox x:Name="PhoneBox" Style="{StaticResource NewOwnerInput}" MaxLength="40"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Cellulaire" Style="{StaticResource NewOwnerLabel}"/>
                                <TextBox x:Name="CellPhoneBox" Style="{StaticResource NewOwnerInput}" MaxLength="40"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Courriel" Margin="0,16,0,7" Style="{StaticResource NewOwnerLabel}"/>
                        <TextBox x:Name="EmailBox" Style="{StaticResource NewOwnerInput}" MaxLength="150"/>
                        <TextBlock Text="Adresse" Margin="0,16,0,7" Style="{StaticResource NewOwnerLabel}"/>
                        <TextBox x:Name="AddressBox" Style="{StaticResource NewOwnerInput}" MaxLength="300"/>
                        <TextBlock Text="Commentaires" Margin="0,16,0,7" Style="{StaticResource NewOwnerLabel}"/>
                        <TextBox x:Name="CommentsBox" Style="{StaticResource NewOwnerMultiline}" Height="88" MaxLength="2000"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E4E7EC"
                BorderThickness="0,1,0,0" Padding="30,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Mode démo · Données non persistantes au redémarrage"
                           FontSize="12" Foreground="#667085" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Annuler" Click="Cancel_Click"
                        Margin="0,0,12,0" MinWidth="110" Height="46"
                        Padding="16,7" FontSize="14" FontWeight="SemiBold"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                        Style="{StaticResource SecondaryActionButtonStyle}"/>
                <Button Grid.Column="2" Content="Créer le client" Click="Save_Click"
                        MinWidth="190" Height="46"
                        Padding="16,7" FontSize="14" FontWeight="SemiBold"
                        VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                        Style="{StaticResource PrimaryActionButtonStyle}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
