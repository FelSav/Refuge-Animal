<UserControl x:Class="MuniChien.App.Views.DogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ==================================================
             CARTES
             ================================================== -->

        <Style x:Key="DogCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <!-- ==================================================
             TITRE
             ================================================== -->

        <Style x:Key="DogSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <!-- ==================================================
             LABEL
             ================================================== -->

        <Style x:Key="DogLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ==================================================
             VALEUR
             ================================================== -->

        <Style x:Key="DogValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <Style x:Key="DogValueBoxStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="12,8"/>

        </Style>

    </UserControl.Resources>


    <!-- ==================================================
         PAGE
         ================================================== -->

    <Grid Background="#F6F7F9">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,38,52,42">


                <!-- ==================================================
                     TITRE
                     ================================================== -->

                <TextBlock Text="{Binding DogName}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>


                <TextBlock Text="Dossier chien"
                           FontSize="14"
                           Foreground="#667085"
                           Margin="0,6,0,28"/>


                <!-- ==================================================
                     INFORMATIONS PRINCIPALES
                     ================================================== -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- CHIEN -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Informations du chien"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Nom -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="120"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Nom"
                                           Style="{StaticResource DogLabelStyle}"/>


                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding DogName}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Race -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="120"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Race"
                                           Style="{StaticResource DogLabelStyle}"/>


                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Breed}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Couleur -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="120"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Couleur"
                                           Style="{StaticResource DogLabelStyle}"/>


                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Color}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Sexe -->

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="120"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Sexe"
                                           Style="{StaticResource DogLabelStyle}"/>


                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Sex}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- DÉTAILS -->

                    <Border Grid.Column="2"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Détails"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Âge -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="120"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Âge"
                                           Style="{StaticResource DogLabelStyle}"/>


                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Age}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Poids -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="120"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Poids"
                                           Style="{StaticResource DogLabelStyle}"/>


                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Weight}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Stérilisé -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="120"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Stérilisé"
                                           Style="{StaticResource DogLabelStyle}"/>


                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Sterilized}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Statut -->

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="120"/>

                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>


                                <TextBlock Text="Statut"
                                           Style="{StaticResource DogLabelStyle}"/>


                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Status}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     PROPRIÉTAIRE
                     ================================================== -->

                <Border Style="{StaticResource DogCardStyle}"
                        Margin="0,24,0,0">

                    <StackPanel>

                        <TextBlock Text="Propriétaire"
                                   Style="{StaticResource DogSectionTitleStyle}"
                                   Margin="0,0,0,18"/>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="24"/>

                                <ColumnDefinition Width="120"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <TextBlock Grid.Column="0"
                                       Text="Nom"
                                       Style="{StaticResource DogLabelStyle}"/>


                            <Border Grid.Column="1"
                                    Style="{StaticResource DogValueBoxStyle}">

                                <TextBlock Text="{Binding OwnerName}"
                                           Style="{StaticResource DogValueStyle}"/>

                            </Border>


                            <TextBlock Grid.Column="3"
                                       Text="Licence"
                                       Style="{StaticResource DogLabelStyle}"/>


                            <Border Grid.Column="4"
                                    Style="{StaticResource DogValueBoxStyle}">

                                <TextBlock Text="{Binding LicenseNumber}"
                                           Style="{StaticResource DogValueStyle}"/>

                            </Border>

                        </Grid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>