<UserControl x:Class="MuniChien.App.Views.DogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ==================================================
             CARTES
             ================================================== -->

        <Style x:Key="DogCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <!-- ==================================================
             TITRES
             ================================================== -->

        <Style x:Key="DogSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <!-- ==================================================
             LABELS
             ================================================== -->

        <Style x:Key="DogLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ==================================================
             VALEURS
             ================================================== -->

        <Style x:Key="DogValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <Style x:Key="DogValueBoxStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="12,8"/>

        </Style>


        <!-- ==================================================
             HISTORIQUE DES LICENCES
             ================================================== -->

        <Style x:Key="LicenseHistoryDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="RowBackground"
                    Value="White"/>

            <Setter Property="AlternatingRowBackground"
                    Value="#FCFCFD"/>

            <Setter Property="RowHeight"
                    Value="44"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

        </Style>


        <Style x:Key="LicenseHistoryHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="BorderBrush"
                    Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <Style x:Key="LicenseHistoryCellStyle"
               TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <Style x:Key="LicenseHistoryTextStyle"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="12,0"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

        </Style>

    </UserControl.Resources>


    <!-- ==================================================
         PAGE
         ================================================== -->

    <Grid Background="#F6F7F9">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,38,52,42">


                <!-- ==================================================
                     ENTÊTE
                     ================================================== -->

                <TextBlock Text="{Binding DogName,
                                          StringFormat=Fiche de chien — {0}}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>


                <TextBlock Text="Consultez les informations du chien, de son propriétaire et de sa licence."
                           Margin="0,7,0,28"
                           FontSize="14"
                           Foreground="#667085"/>


                <!-- ==================================================
                     LIGNE 1
                     INFORMATIONS + PROPRIÉTAIRE
                     ================================================== -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ==================================================
                         INFORMATIONS DU CHIEN
                         ================================================== -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Informations du chien"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Nom -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Nom"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding DogName}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Race -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Race"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Breed}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Couleur -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Couleur"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Color}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Sexe -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Sexe"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Sex}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Stérilisé -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Stérilisé"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Sterilized}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Naissance -->

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Naissance"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding BirthDate}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ==================================================
                         PROPRIÉTAIRE
                         ================================================== -->

                    <Border Grid.Column="2"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Propriétaire"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Dossier -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Dossier"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding OwnerFileNumber}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Nom -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Nom"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding OwnerName}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Adresse -->

                            <TextBlock Text="Adresse"
                                       Style="{StaticResource DogLabelStyle}"
                                       Margin="0,4,0,6"/>

                            <Border Style="{StaticResource DogValueBoxStyle}">

                                <TextBlock Text="{Binding OwnerAddress}"
                                           Style="{StaticResource DogValueStyle}"
                                           TextWrapping="Wrap"/>

                            </Border>


                            <!-- Voir propriétaire -->

                            <Button Content="Voir le propriétaire"
                                    Command="{Binding OpenOwnerCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"
                                    FontSize="13"
                                    Margin="0,18,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     LIGNE 2
                     STATUT + INFOS SUPPLÉMENTAIRES
                     ================================================== -->

                <Grid Margin="0,24,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ==================================================
                         STATUT
                         ================================================== -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Statut"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Statut actuel"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Status}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Date d'inactivation"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding DeactivationDate}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Raison"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding DeactivationReason}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ==================================================
                         INFORMATIONS SUPPLÉMENTAIRES
                         ================================================== -->

                    <Border Grid.Column="2"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Informations supplémentaires"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- Âge -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Âge"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Age}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Poids -->

                            <Grid Margin="0,0,0,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Poids"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding Weight}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <!-- Commentaires -->

                            <TextBlock Text="Commentaires"
                                       Style="{StaticResource DogLabelStyle}"
                                       Margin="0,0,0,6"/>

                            <Border Style="{StaticResource DogValueBoxStyle}"
                                    MinHeight="70">

                                <TextBlock Text="{Binding Comments}"
                                           Style="{StaticResource DogValueStyle}"
                                           TextWrapping="Wrap"/>

                            </Border>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     LICENCE ACTUELLE
                     ================================================== -->

                <Border Style="{StaticResource DogCardStyle}"
                        Margin="0,24,0,0">

                    <StackPanel>

                        <TextBlock Text="Licence actuelle"
                                   Style="{StaticResource DogSectionTitleStyle}"
                                   Margin="0,0,0,18"/>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <!-- Numéro -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Licence"
                                           Style="{StaticResource DogLabelStyle}"
                                           Margin="0,0,0,6"/>

                                <Border Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding LicenseNumber}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </StackPanel>


                            <!-- Statut -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Statut"
                                           Style="{StaticResource DogLabelStyle}"
                                           Margin="0,0,0,6"/>

                                <Border Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding LicenseStatus}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </StackPanel>


                            <!-- Émission -->

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Émission"
                                           Style="{StaticResource DogLabelStyle}"
                                           Margin="0,0,0,6"/>

                                <Border Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding LicenseIssueDate}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </StackPanel>


                            <!-- Expiration -->

                            <StackPanel Grid.Column="6">

                                <TextBlock Text="Expiration"
                                           Style="{StaticResource DogLabelStyle}"
                                           Margin="0,0,0,6"/>

                                <Border Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding LicenseExpirationDate}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </StackPanel>

                        </Grid>


                        <!-- Actions -->

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,20,0,0">

                            <Button Content="Renouveler la licence"
                                    Command="{Binding RenewLicenseCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Padding="18,9"
                                    FontSize="13"/>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- ==================================================
                     HISTORIQUE
                     ================================================== -->

                <TextBlock Text="Historique des licences"
                           Style="{StaticResource DogSectionTitleStyle}"
                           Margin="0,30,0,14"/>


                <Border Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">

                    <DataGrid ItemsSource="{Binding LicenseHistory}"
                              Style="{StaticResource LicenseHistoryDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource LicenseHistoryHeaderStyle}"
                              CellStyle="{StaticResource LicenseHistoryCellStyle}"
                              MaxHeight="260">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Licence"
                                                Binding="{Binding LicenseNumber}"
                                                Width="*"
                                                ElementStyle="{StaticResource LicenseHistoryTextStyle}"/>

                            <DataGridTextColumn Header="Date d'émission"
                                                Binding="{Binding IssueDate}"
                                                Width="*"
                                                ElementStyle="{StaticResource LicenseHistoryTextStyle}"/>

                            <DataGridTextColumn Header="Date d'expiration"
                                                Binding="{Binding ExpirationDate}"
                                                Width="*"
                                                ElementStyle="{StaticResource LicenseHistoryTextStyle}"/>

                            <DataGridTextColumn Header="Statut"
                                                Binding="{Binding Status}"
                                                Width="*"
                                                ElementStyle="{StaticResource LicenseHistoryTextStyle}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>