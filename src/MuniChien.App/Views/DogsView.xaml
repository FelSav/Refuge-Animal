<UserControl x:Class="MuniChien.App.Views.DogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:feedback="clr-namespace:MuniChien.App.Views.Controls">

    <UserControl.Resources>

        <!-- ==================================================
             CARTES
             ================================================== -->

        <Style x:Key="DogCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <!-- ==================================================
             TITRES
             ================================================== -->

        <Style x:Key="DogSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="18"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <!-- ==================================================
             LABELS
             ================================================== -->

        <Style x:Key="DogLabelStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

        </Style>


        <!-- ==================================================
             VALEURS
             ================================================== -->

        <Style x:Key="DogValueStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis"/>

        </Style>


        <Style x:Key="DogValueBoxStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="8"/>

            <Setter Property="Padding"
                    Value="12,8"/>

        </Style>


        <!-- ==================================================
             TEXTBOX ÉDITION
             ================================================== -->

        <Style x:Key="DogEditTextBoxBaseStyle"
               TargetType="TextBox">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#D0D5DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Foreground"
                    Value="#242424"/>

            <Setter Property="FontSize"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="10,0"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">

                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">

                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#E87524"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>


        <!-- ==================================================
             LECTURE / ÉDITION
             ================================================== -->

        <Style x:Key="DogReadOnlyContainerStyle"
               TargetType="Border"
               BasedOn="{StaticResource DogValueBoxStyle}">

            <Setter Property="Visibility"
                    Value="Visible"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="DogEditTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource DogEditTextBoxBaseStyle}">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="DogEditComboBoxStyle"
               TargetType="ComboBox"
               BasedOn="{StaticResource RoundedComboBoxStyle}">

            <Setter Property="Height"
                    Value="38"/>

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="DogEditGridStyle"
               TargetType="Grid">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ==================================================
             BOUTONS DU MODE ÉDITION
             ================================================== -->

        <Style x:Key="DogModifyButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryActionButtonStyle}">

            <Setter Property="Visibility"
                    Value="Visible"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding HasSelectedDog}"
                             Value="False">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                </DataTrigger>


                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Collapsed"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <Style x:Key="DogEditButtonsStyle"
               TargetType="StackPanel">

            <Setter Property="Visibility"
                    Value="Collapsed"/>

            <Style.Triggers>

                <DataTrigger Binding="{Binding IsEditing}"
                             Value="True">

                    <Setter Property="Visibility"
                            Value="Visible"/>

                </DataTrigger>

            </Style.Triggers>

        </Style>


        <!-- ==================================================
             HISTORIQUE LICENCES
             ================================================== -->

        <Style x:Key="LicenseHistoryDataGridStyle"
               TargetType="DataGrid">

            <Setter Property="AutoGenerateColumns"
                    Value="False"/>

            <Setter Property="CanUserAddRows"
                    Value="False"/>

            <Setter Property="CanUserDeleteRows"
                    Value="False"/>

            <Setter Property="CanUserResizeRows"
                    Value="False"/>

            <Setter Property="CanUserReorderColumns"
                    Value="False"/>

            <Setter Property="IsReadOnly"
                    Value="True"/>

            <Setter Property="HeadersVisibility"
                    Value="Column"/>

            <Setter Property="GridLinesVisibility"
                    Value="None"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="RowHeight"
                    Value="44"/>

            <Setter Property="ColumnHeaderHeight"
                    Value="42"/>

        </Style>


        <Style x:Key="LicenseHistoryHeaderStyle"
               TargetType="DataGridColumnHeader">

            <Setter Property="Background"
                    Value="#F8FAFC"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="BorderBrush"
                    Value="#EAECF0"/>

            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>

        </Style>


        <Style x:Key="LicenseHistoryCellStyle"
               TargetType="DataGridCell">

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

        </Style>


        <Style x:Key="LicenseHistoryTextStyle"
               TargetType="TextBlock">

            <Setter Property="VerticalAlignment"
                    Value="Center"/>

            <Setter Property="Margin"
                    Value="12,0"/>

            <Setter Property="Foreground"
                    Value="#344054"/>

        </Style>

        <!-- Répertoire : colonnes lisibles et survol discret des lignes. -->
        <Style x:Key="DogDirectoryGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="47"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF0F3"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="False"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled"/>
        
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="RowBackground" Value="White"/>
</Style>
        <Style x:Key="DogListTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#263243"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    <Style x:Key="DogDirectoryRowStyle" TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF7EF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFEAD9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DogDirectoryGridStyleHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#4E5A6B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderBrush" Value="#E4E7EC"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
</UserControl.Resources>


    <!-- ==================================================
         PAGE
         ================================================== -->

    <Grid Background="#F6F7F9">
        <!-- VUE LISTE : tableau à hauteur naturelle, un seul défilement vertical pour toute la page. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- Hidden (et non Collapsed) conserve la position de la liste pendant l'ouverture d'une fiche. -->
                        <DataTrigger Binding="{Binding IsDetailView}" Value="True">
                            <Setter Property="Visibility" Value="Hidden"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <StackPanel Margin="30,26,30,42">
                <!-- Actions et titre -->
                <Grid Margin="0,0,0,17">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Chiens" FontSize="29" FontWeight="SemiBold" Foreground="#252D3B"/>
                        <TextBlock Text="Retrouvez les chiens, leurs propriétaires et leurs licences." FontSize="13" Margin="0,5,0,0" Foreground="#697587"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Actualiser" Command="{Binding ReloadCommand}" Height="43" Padding="15,5" Style="{StaticResource SecondaryActionButtonStyle}"/>
                        <Button Content="+ Nouveau chien" Command="{Binding AddNewDogCommand}"
                                Margin="10,0,0,0" Height="43" Padding="15,5"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Recherche en permanence visible; filtres avancés repliables pour dégager le tableau. -->
                <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                        CornerRadius="14" Padding="18,15" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Recherche rapide" FontWeight="SemiBold" FontSize="13"
                                   Foreground="#344054" Margin="0,0,0,7"/>
                        <TextBox Height="43" Text="{Binding DogSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Nom du chien, nom du client, race ou numéro de licence" Padding="12,7" FontSize="14"
                                 BorderBrush="#D7DDE5" Background="#FCFCFD"/>
                        <Expander Margin="0,12,0,0" IsExpanded="False">
                            <Expander.Header>
                                <TextBlock Text="Filtres avancés" FontSize="13" FontWeight="SemiBold" Foreground="#B35716"/>
                            </Expander.Header>
                            <StackPanel Margin="0,12,0,0">
                                <WrapPanel>
                                    <StackPanel Width="182" Margin="0,0,14,8">
                    <TextBlock Text="Municipalité" FontSize="12" Foreground="#697587" Margin="0,0,0,6"/>
                    <ComboBox Height="40" ItemsSource="{Binding DogMunicipalityFilters}"
                              SelectedItem="{Binding DogMunicipalityFilter, Mode=TwoWay}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                </StackPanel>
<StackPanel Width="170" Margin="0,0,14,8">
                    <TextBlock Text="Race" FontSize="12" Foreground="#697587" Margin="0,0,0,6"/>
                    <ComboBox Height="40" ItemsSource="{Binding DogBreedFilters}"
                              SelectedItem="{Binding DogBreedFilter, Mode=TwoWay}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                </StackPanel>
<StackPanel Width="150" Margin="0,0,14,8">
                    <TextBlock Text="Statut" FontSize="12" Foreground="#697587" Margin="0,0,0,6"/>
                    <ComboBox Height="40" ItemsSource="{Binding DogStatusFilters}"
                              SelectedItem="{Binding DogStatusFilter, Mode=TwoWay}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                </StackPanel>
<StackPanel Width="150" Margin="0,0,14,8">
                    <TextBlock Text="Licence" FontSize="12" Foreground="#697587" Margin="0,0,0,6"/>
                    <ComboBox Height="40" ItemsSource="{Binding DogLicenseFilters}"
                              SelectedItem="{Binding DogLicenseFilter, Mode=TwoWay}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                </StackPanel>
<StackPanel Width="145" Margin="0,0,14,8">
                    <TextBlock Text="Sexe" FontSize="12" Foreground="#697587" Margin="0,0,0,6"/>
                    <ComboBox Height="40" ItemsSource="{Binding DogSexFilters}"
                              SelectedItem="{Binding DogSexFilter, Mode=TwoWay}"
                              Style="{StaticResource RoundedComboBoxStyle}"/>
                </StackPanel>
                                </WrapPanel>
                                <Button Content="Effacer les filtres" Command="{Binding ClearDogFiltersCommand}"
                                        HorizontalAlignment="Right" Margin="0,2,0,0"
                                        Height="36" Padding="12,4" Style="{StaticResource SecondaryActionButtonStyle}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- Résultats : tableau complet, sans petite zone verticale limitée. -->
                <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                        CornerRadius="14" Padding="0,0,0,8">
                    <StackPanel>
                        <Grid Margin="20,18,20,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tous les dossiers" FontSize="17" FontWeight="SemiBold" Foreground="#263243"/>
                                <Border Margin="12,0,0,0" Padding="10,5" Background="#FFF3E8" CornerRadius="12">
                                    <TextBlock Text="{Binding DogResultLabel}" FontSize="12"
                                               Foreground="#9B531B" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Cliquez sur une ligne pour ouvrir sa fiche"
                                       FontSize="12" Foreground="#7C8898" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Le DataGrid grandit avec ses lignes; la molette est redirigée vers le ScrollViewer parent. -->
                        <DataGrid Margin="2,0,2,0" Style="{StaticResource DogDirectoryGridStyle}"
                                  ColumnHeaderStyle="{StaticResource DogDirectoryGridStyleHeaderStyle}"
                                  RowStyle="{StaticResource DogDirectoryRowStyle}"
                                  feedback:DirectoryScrollBehavior.ForwardMouseWheel="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  ScrollViewer.CanContentScroll="False"
                                  EnableRowVirtualization="False"
                                  ItemsSource="{Binding DogList}"
                                  SelectedItem="{Binding SelectedListDog, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Chien" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource DogListTextStyle}"/>
<DataGridTextColumn Header="Client" Binding="{Binding Owner}" Width="2*" ElementStyle="{StaticResource DogListTextStyle}"/>
<DataGridTextColumn Header="Race" Binding="{Binding Breed}" Width="1.3*" ElementStyle="{StaticResource DogListTextStyle}"/>
<DataGridTextColumn Header="Sexe" Binding="{Binding Sex}" Width="100" ElementStyle="{StaticResource DogListTextStyle}"/>
<DataGridTextColumn Header="Municipalité" Binding="{Binding Municipality}" Width="1.3*" ElementStyle="{StaticResource DogListTextStyle}"/>
<DataGridTextColumn Header="Statut" Binding="{Binding Status}" Width="105" ElementStyle="{StaticResource DogListTextStyle}"/>
<DataGridTextColumn Header="Licence" Binding="{Binding License}" Width="110" ElementStyle="{StaticResource DogListTextStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Aucun dossier ne correspond aux filtres."
                                   Margin="20,24,20,26" TextAlignment="Center"
                                   FontSize="14" Foreground="#667085" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DogResultLabel}" Value="0 chien(s)">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock Text="Les résultats sont issus des dossiers locaux de démonstration."
                           FontSize="12" Foreground="#8A95A5" Margin="6,14,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- VUE FICHE : intégralité de l'écran existant, sans perte de fonctionnalités. -->
        <Grid>
            <Grid.Style><Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsDetailView}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger></Style.Triggers>
            </Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1" Padding="40,14">
                <Button HorizontalAlignment="Left" Content="← Retour à la liste" Height="40" Padding="14,5"
                        Command="{Binding BackToListCommand}" IsEnabled="{Binding CanChangeSelection}"
                        Style="{StaticResource SecondaryActionButtonStyle}"/>
            </Border>


        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,38,52,42">

                <!-- États de lecture et réessai (services locaux / future API). -->
                <feedback:DataLoadStatusView Margin="0,0,0,16"/>

                <!-- Sélecteur de chien : page accessible directement depuis la barre latérale. -->
                <Border Background="White" BorderBrush="#E4E7EC" BorderThickness="1"
                        CornerRadius="14" Padding="18" Margin="0,0,0,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Choisir un chien" FontSize="15" FontWeight="SemiBold"
                                       Foreground="#242B38"/>
                            <TextBlock Text="Consulter directement sa fiche" Margin="0,4,0,0"
                                       FontSize="12" Foreground="#667085"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Height="42" Margin="12,0,0,0"
                                  ItemsSource="{Binding DogOptions}"
                                  SelectedItem="{Binding SelectedDogOption, Mode=TwoWay}"
                                  DisplayMemberPath="SelectionDisplay"
                                  TextSearch.TextPath="SelectionDisplay"
                                  IsTextSearchEnabled="True"
                                  IsEnabled="{Binding CanChangeSelection}"
                                  Style="{StaticResource RoundedComboBoxStyle}"/>
                    </Grid>
                </Border>


                <!-- ==================================================
                     ENTÊTE
                     ================================================== -->

                <Grid Margin="0,0,0,28">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="Auto"/>

                    </Grid.ColumnDefinitions>


                    <StackPanel>

                        <TextBlock Text="{Binding DogName,
                                                  StringFormat=Fiche de chien — {0}}"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Foreground="#242B38"/>

                        <TextBlock Text="Consultez et gérez les informations du chien, de son propriétaire et de sa licence."
                                   Margin="0,7,0,0"
                                   FontSize="14"
                                   Foreground="#667085"/>

                    </StackPanel>


                    <!-- MODIFIER -->

                    <Button Grid.Column="1"
                            Content="Modifier"
                            Command="{Binding ModifyCommand}"
                            IsEnabled="{Binding IsNotEditingComments}"
                            Style="{StaticResource DogModifyButtonStyle}"
                            VerticalAlignment="Top"/>


                    <!-- ANNULER / ENREGISTRER -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top"
                                Style="{StaticResource DogEditButtonsStyle}">

                        <Button Content="Annuler"
                                Command="{Binding CancelCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                Margin="0,0,12,0"/>

                        <Button Content="Enregistrer"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryActionButtonStyle}"/>

                    </StackPanel>

                </Grid>


                <!-- ==================================================
                     MESSAGE DE VALIDATION
                     ================================================== -->

                <Border Background="#FFF4ED"
                        BorderBrush="#E87524"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,20">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter Property="Visibility"
                                    Value="Visible"/>

                            <Style.Triggers>

                                <DataTrigger Binding="{Binding ValidationMessage}"
                                             Value="">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>


                    <TextBlock Text="{Binding ValidationMessage}"
                               Foreground="#8A3B00"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- ==================================================
                     LIGNE 1
                     ================================================== -->

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ==================================================
                         INFORMATIONS DU CHIEN
                         ================================================== -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Informations du chien"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- NOM -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Nom"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding DogName}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>

                                    <TextBox Text="{Binding DogName,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DogEditTextBoxStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- RACE -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Race"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Breed}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>

                                    <ComboBox ItemsSource="{Binding BreedOptions}"
                                              Text="{Binding Breed,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              StaysOpenOnEdit="True"
                                              Style="{StaticResource DogEditComboBoxStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- COULEUR -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Couleur"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Color}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>

                                    <ComboBox ItemsSource="{Binding ColorOptions}"
                                              Text="{Binding Color,
                                                             UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              StaysOpenOnEdit="True"
                                              Style="{StaticResource DogEditComboBoxStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- SEXE -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Sexe"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding SexDisplay}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>

                                    <ComboBox ItemsSource="{Binding SexOptions}"
                                              SelectedItem="{Binding Sex}"
                                              Style="{StaticResource DogEditComboBoxStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- STÉRILISÉ -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Stérilisé"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Sterilized}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>

                                    <ComboBox ItemsSource="{Binding SterilizedOptions}"
                                              SelectedItem="{Binding Sterilized}"
                                              Style="{StaticResource DogEditComboBoxStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- NAISSANCE -->

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Naissance"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding BirthDate}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ==================================================
                         PROPRIÉTAIRE
                         ================================================== -->

                    <Border Grid.Column="2"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Propriétaire"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Dossier"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding OwnerFileNumber}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <Grid Margin="0,0,0,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Nom"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Border Grid.Column="1"
                                        Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding OwnerName}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </Grid>


                            <TextBlock Text="Adresse"
                                       Style="{StaticResource DogLabelStyle}"
                                       Margin="0,0,0,6"/>

                            <Border Style="{StaticResource DogValueBoxStyle}">

                                <TextBlock Text="{Binding OwnerAddress}"
                                           Style="{StaticResource DogValueStyle}"
                                           TextWrapping="Wrap"/>

                            </Border>


                            <Button Content="Voir le client"
                                    Command="{Binding OpenOwnerCommand}"
                                    IsEnabled="{Binding HasSelectedDog}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"
                                    FontSize="13"
                                    Margin="0,18,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     LIGNE 2
                     ================================================== -->

                <Grid Margin="0,24,0,0">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="24"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- ==================================================
                         STATUT
                         ================================================== -->

                    <Border Grid.Column="0"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Statut"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- STATUT ACTUEL -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Statut actuel"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding Status}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>

                                    <ComboBox ItemsSource="{Binding StatusOptions}"
                                              SelectedItem="{Binding Status}"
                                              Style="{StaticResource DogEditComboBoxStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- DATE INACTIVATION -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Date d'inactivation"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding DeactivationDateDisplay}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>

                                    <TextBox Text="{Binding DeactivationDate,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsInactive}"
                                             ToolTip="Format : AAAA-MM-JJ"
                                             Style="{StaticResource DogEditTextBoxStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- RAISON -->

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Raison"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding DeactivationReasonDisplay}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>

                                    <TextBox Text="{Binding DeactivationReason,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsInactive}"
                                             Style="{StaticResource DogEditTextBoxStyle}"/>

                                </Grid>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ==================================================
                         INFORMATIONS SUPPLÉMENTAIRES
                         ================================================== -->

                    <Border Grid.Column="2"
                            Style="{StaticResource DogCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Informations supplémentaires"
                                       Style="{StaticResource DogSectionTitleStyle}"
                                       Margin="0,0,0,18"/>


                            <!-- ÂGE -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Âge"
                                           Style="{StaticResource DogLabelStyle}"/>


                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding AgeDisplay}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>


                                    <Grid Style="{StaticResource DogEditGridStyle}">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>


                                        <TextBox Grid.Column="0"
                                                 Text="{Binding AgeValueInput,
                                                                UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource DogEditTextBoxBaseStyle}"/>


                                        <ComboBox Grid.Column="2"
                                                  ItemsSource="{Binding AgeUnitOptions}"
                                                  SelectedItem="{Binding AgeUnit}"
                                                  Style="{StaticResource RoundedComboBoxStyle}"
                                                  Height="38"/>

                                    </Grid>

                                </Grid>

                            </Grid>


                            <!-- POIDS -->

                            <Grid Margin="0,0,0,14">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Poids"
                                           Style="{StaticResource DogLabelStyle}"/>

                                <Grid Grid.Column="1">

                                    <Border Style="{StaticResource DogReadOnlyContainerStyle}">

                                        <TextBlock Text="{Binding WeightDisplay}"
                                                   Style="{StaticResource DogValueStyle}"/>

                                    </Border>

                                    <TextBox Text="{Binding WeightInput,
                                                          UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource DogEditTextBoxStyle}"/>

                                </Grid>

                            </Grid>


                            <!-- COMMENTAIRES : ÉDITION DIRECTE + IMPRESSION -->
                            <Grid Margin="0,4,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Commentaires" Style="{StaticResource DogLabelStyle}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanUseCommentActions}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="Modifier" Command="{Binding EditCommentsCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}" Padding="10,6" Margin="0,0,6,0"/>
                                    <Button Content="Imprimer" Command="{Binding PrintCommentsCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}" Padding="10,6"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingComments}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button Content="Annuler" Command="{Binding CancelCommentsCommand}"
                                            Style="{StaticResource SecondaryActionButtonStyle}" Padding="10,6" Margin="0,0,6,0"/>
                                    <Button Content="Enregistrer" Command="{Binding SaveCommentsCommand}"
                                            Style="{StaticResource PrimaryActionButtonStyle}" Padding="10,6"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Border MinHeight="95">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource DogValueBoxStyle}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCommentsEditable}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding CommentsDisplay, Mode=OneWay}" FontSize="14"
                                               Foreground="#242424" TextWrapping="Wrap"/>
                                </Border>

                                <TextBox Text="{Binding Comments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Height="110" MinWidth="100" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10"
                                         VerticalScrollBarVisibility="Auto">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource DogEditTextBoxBaseStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCommentsEditable}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     LICENCE ACTUELLE
                     ================================================== -->

                <Border Style="{StaticResource DogCardStyle}"
                        Margin="0,24,0,0">

                    <StackPanel>

                        <TextBlock Text="Licence actuelle"
                                   Style="{StaticResource DogSectionTitleStyle}"
                                   Margin="0,0,0,18"/>


                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                                <ColumnDefinition Width="18"/>

                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>


                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Licence"
                                           Style="{StaticResource DogLabelStyle}"
                                           Margin="0,0,0,6"/>

                                <Border Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding LicenseNumber}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </StackPanel>


                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Statut"
                                           Style="{StaticResource DogLabelStyle}"
                                           Margin="0,0,0,6"/>

                                <Border Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding LicenseStatus}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </StackPanel>


                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Émission"
                                           Style="{StaticResource DogLabelStyle}"
                                           Margin="0,0,0,6"/>

                                <Border Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding LicenseIssueDate}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </StackPanel>


                            <StackPanel Grid.Column="6">

                                <TextBlock Text="Expiration"
                                           Style="{StaticResource DogLabelStyle}"
                                           Margin="0,0,0,6"/>

                                <Border Style="{StaticResource DogValueBoxStyle}">

                                    <TextBlock Text="{Binding LicenseExpirationDate}"
                                               Style="{StaticResource DogValueStyle}"/>

                                </Border>

                            </StackPanel>

                        </Grid>


                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,20,0,0">

                            <Button Content="Renouveler la licence"
                                    Command="{Binding RenewLicenseCommand}"
                                    IsEnabled="{Binding HasSelectedDog}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    Padding="18,9"
                                    FontSize="13"/>

                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- ==================================================
                     HISTORIQUE DES LICENCES
                     ================================================== -->

                <TextBlock Text="Historique des licences"
                           Style="{StaticResource DogSectionTitleStyle}"
                           Margin="0,30,0,14"/>


                <Border Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="14"
                        ClipToBounds="True">

                    <DataGrid ItemsSource="{Binding LicenseHistory}"
                              Style="{StaticResource LicenseHistoryDataGridStyle}"
                              ColumnHeaderStyle="{StaticResource LicenseHistoryHeaderStyle}"
                              CellStyle="{StaticResource LicenseHistoryCellStyle}"
                              MaxHeight="260">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Licence"
                                                Binding="{Binding LicenseNumber}"
                                                Width="*"
                                                ElementStyle="{StaticResource LicenseHistoryTextStyle}"/>

                            <DataGridTextColumn Header="Date d'émission"
                                                Binding="{Binding IssueDate}"
                                                Width="*"
                                                ElementStyle="{StaticResource LicenseHistoryTextStyle}"/>

                            <DataGridTextColumn Header="Date d'expiration"
                                                Binding="{Binding ExpirationDate}"
                                                Width="*"
                                                ElementStyle="{StaticResource LicenseHistoryTextStyle}"/>

                            <DataGridTextColumn Header="Statut"
                                                Binding="{Binding Status}"
                                                Width="*"
                                                ElementStyle="{StaticResource LicenseHistoryTextStyle}"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Border>

            </StackPanel>

        </ScrollViewer>

        </Grid>
    </Grid>

</UserControl>