<UserControl x:Class="MuniChien.App.Views.AdministrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>

        <!-- ==================================================
             CARTES
             ================================================== -->

        <Style x:Key="AdminCardStyle"
               TargetType="Border">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E4E7EC"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="22"/>

        </Style>


        <!-- ==================================================
             TITRES
             ================================================== -->

        <Style x:Key="AdminSectionTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="19"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <Style x:Key="AdminCardTitleStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="17"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Foreground"
                    Value="#242B38"/>

        </Style>


        <Style x:Key="AdminDescriptionStyle"
               TargetType="TextBlock">

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Foreground"
                    Value="#667085"/>

            <Setter Property="TextWrapping"
                    Value="Wrap"/>

        </Style>


        <!-- ==================================================
             BOUTON DANGEREUX
             ================================================== -->

        <Style x:Key="DangerActionButtonStyle"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#D92D20"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#B42318"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Padding"
                    Value="18,9"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>


                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#B42318"/>

                            </Trigger>


                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#912018"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>


    <Grid Background="#F6F7F9">

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="52,36,52,44">


                <!-- ==================================================
                     ENTÊTE
                     ================================================== -->

                <TextBlock Text="Administration"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#242B38"/>


                <TextBlock Text="Gérez les paramètres et les opérations sensibles de MuniChien."
                           FontSize="14"
                           Foreground="#667085"
                           Margin="0,7,0,24"/>


                <!-- ==================================================
                     MESSAGE
                     ================================================== -->

                <Border Background="#F0FDF4"
                        BorderBrush="#ABEFC6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,22">

                    <Border.Style>

                        <Style TargetType="Border">

                            <Setter Property="Visibility"
                                    Value="Visible"/>


                            <Style.Triggers>

                                <DataTrigger Binding="{Binding OperationMessage}"
                                             Value="">

                                    <Setter Property="Visibility"
                                            Value="Collapsed"/>

                                </DataTrigger>

                            </Style.Triggers>

                        </Style>

                    </Border.Style>


                    <TextBlock Text="{Binding OperationMessage}"
                               Foreground="#067647"
                               FontSize="13"
                               TextWrapping="Wrap"/>

                </Border>


                <!-- ==================================================
                     ÉTAT DU SYSTÈME
                     ================================================== -->

                <TextBlock Text="État du système"
                           Style="{StaticResource AdminSectionTitleStyle}"
                           Margin="0,0,0,13"/>


                <Grid Margin="0,0,0,26">

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="16"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- DERNIÈRE SAUVEGARDE -->

                    <Border Grid.Column="0"
                            Style="{StaticResource AdminCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Dernière sauvegarde"
                                       FontSize="12"
                                       Foreground="#667085"/>

                            <TextBlock Text="{Binding LastBackupDisplay}"
                                       Margin="0,8,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>

                        </StackPanel>

                    </Border>


                    <!-- CONSERVATION -->

                    <Border Grid.Column="2"
                            Style="{StaticResource AdminCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Conservation"
                                       FontSize="12"
                                       Foreground="#667085"/>

                            <TextBlock Text="{Binding BackupRetentionDisplay}"
                                       Margin="0,8,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>

                        </StackPanel>

                    </Border>


                    <!-- SESSION -->

                    <Border Grid.Column="4"
                            Style="{StaticResource AdminCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Session"
                                       FontSize="12"
                                       Foreground="#667085"/>

                            <TextBlock Text="{Binding AdminSessionStatus}"
                                       Margin="0,8,0,0"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     SAUVEGARDES ET DONNÉES
                     ================================================== -->

                <TextBlock Text="Sauvegardes et données"
                           Style="{StaticResource AdminSectionTitleStyle}"
                           Margin="0,0,0,13"/>


                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="20"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- SAUVEGARDE -->

                    <Border Grid.Column="0"
                            Style="{StaticResource AdminCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Sauvegarde"
                                       Style="{StaticResource AdminCardTitleStyle}"/>


                            <TextBlock Text="Créez une sauvegarde manuelle de l'état actuel de MuniChien."
                                       Style="{StaticResource AdminDescriptionStyle}"
                                       Margin="0,7,0,20"
                                       MinHeight="34"/>


                            <Button Content="Créer une sauvegarde"
                                    Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"/>

                        </StackPanel>

                    </Border>


                    <!-- RESTAURATION -->

                    <Border Grid.Column="2"
                            Style="{StaticResource AdminCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Restauration"
                                       Style="{StaticResource AdminCardTitleStyle}"/>


                            <TextBlock Text="Sélectionnez une sauvegarde existante avant de lancer une restauration."
                                       Style="{StaticResource AdminDescriptionStyle}"
                                       Margin="0,7,0,14"
                                       MinHeight="34"/>


                            <ComboBox ItemsSource="{Binding Backups}"
                                      SelectedItem="{Binding SelectedBackup}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource RoundedComboBoxStyle}"
                                      Height="40"
                                      Margin="0,0,0,14"/>


                            <Button Content="Restaurer la sauvegarde"
                                    Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     CONFIGURATION
                     ================================================== -->

                <TextBlock Text="Configuration"
                           Style="{StaticResource AdminSectionTitleStyle}"
                           Margin="0,28,0,13"/>


                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>

                        <ColumnDefinition Width="20"/>

                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>


                    <!-- PARAMÈTRES -->

                    <Border Grid.Column="0"
                            Style="{StaticResource AdminCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Paramètres sensibles"
                                       Style="{StaticResource AdminCardTitleStyle}"/>


                            <TextBlock Text="Gérez les tarifs, règles et paramètres administratifs qui influencent le fonctionnement de MuniChien."
                                       Style="{StaticResource AdminDescriptionStyle}"
                                       Margin="0,7,0,20"
                                       MinHeight="48"/>


                            <Button Content="Ouvrir les paramètres"
                                    Command="{Binding OpenSensitiveSettingsCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"/>

                        </StackPanel>

                    </Border>


                    <!-- ARCHIVES -->

                    <Border Grid.Column="2"
                            Style="{StaticResource AdminCardStyle}">

                        <StackPanel>

                            <TextBlock Text="Données archivées"
                                       Style="{StaticResource AdminCardTitleStyle}"/>


                            <TextBlock Text="Consultez les données archivées lors des opérations administratives précédentes."
                                       Style="{StaticResource AdminDescriptionStyle}"
                                       Margin="0,7,0,20"
                                       MinHeight="48"/>


                            <Button Content="Gérer les archives"
                                    Command="{Binding ManageArchivesCommand}"
                                    Style="{StaticResource SecondaryActionButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="16,8"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ==================================================
                     ZONE CRITIQUE
                     ================================================== -->

                <TextBlock Text="Zone critique"
                           Style="{StaticResource AdminSectionTitleStyle}"
                           Margin="0,28,0,13"/>


                <Border Background="#FFF7F6"
                        BorderBrush="#FDA29B"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="24">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="30"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock Text="Fermeture annuelle"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#B42318"/>


                            <TextBlock Margin="0,7,0,0"
                                       FontSize="13"
                                       Foreground="#475467"
                                       TextWrapping="Wrap">

                                <Run Text="Préparer la fermeture de l'année "/>

                                <Run Text="{Binding CurrentYearDisplay, Mode=OneWay}"
                                        FontWeight="SemiBold"/>

                                <Run Text=" et le passage vers l'année suivante."/>

                            </TextBlock>


                            <TextBlock Text="Une sauvegarde sera créée avant l'opération. La version actuelle simule le processus sans modifier les données métier."
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="#667085"
                                       TextWrapping="Wrap"/>

                        </StackPanel>


                        <Button Grid.Column="2"
                                Content="Démarrer la fermeture annuelle"
                                Command="{Binding StartAnnualCloseCommand}"
                                Style="{StaticResource DangerActionButtonStyle}"
                                VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ==================================================
                     SESSION
                     ================================================== -->

                <Border Background="White"
                        BorderBrush="#E4E7EC"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20"
                        Margin="0,28,0,0">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="Auto"/>

                        </Grid.ColumnDefinitions>


                        <StackPanel>

                            <TextBlock Text="Session administrateur"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#242B38"/>


                            <TextBlock Text="Fermez la session administrateur lorsque les opérations sensibles sont terminées."
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="#667085"/>

                        </StackPanel>


                        <Button Grid.Column="1"
                                Content="Déconnexion administrateur"
                                Command="{Binding LogoutCommand}"
                                Style="{StaticResource SecondaryActionButtonStyle}"
                                VerticalAlignment="Center"
                                Padding="16,8"/>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>